@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parodos-translations-100-112-japanese a owl:Ontology .
# Japanese translation variants for 100_to_112.ttl

:TV_Line_100_JA a :TranslationVariant ;
:text "太陽の光よ、最も美しいもの、"^^xsd:string ;
:relatedTo :Line_100 .

:TV_Line_101_JA a :TranslationVariant ;
:text "七つの門を持つテーバイに現れた"^^xsd:string ;
:relatedTo :Line_101 .

:TV_Line_102_JA a :TranslationVariant ;
:text "以前の光よ、"^^xsd:string ;
:relatedTo :Line_102 .

:TV_Line_103_JA a :TranslationVariant ;
:text "かつてあなたは現れた、黄金の"^^xsd:string ;
:relatedTo :Line_103 .

:TV_Line_104_JA a :TranslationVariant ;
:text "日のまぶたよ、ディルケの"^^xsd:string ;
:relatedTo :Line_104 .

:TV_Line_105_JA a :TranslationVariant ;
:text "流れの上に来て、"^^xsd:string ;
:relatedTo :Line_105 .

:TV_Line_106_JA a :TranslationVariant ;
:text "アルゴスから来た白い盾の"^^xsd:string ;
:relatedTo :Line_106 .

:TV_Line_107_JA a :TranslationVariant ;
:text "男を、全軍を率いて進んだ者を、"^^xsd:string ;
:relatedTo :Line_107 .

:TV_Line_108_JA a :TranslationVariant ;
:text "より鋭い"^^xsd:string ;
:relatedTo :Line_108 .

:TV_Line_109_JA a :TranslationVariant ;
:text "轡によって動かし、先に逃げる亡命者とした。"^^xsd:string ;
:relatedTo :Line_109 .

:TV_Line_110_JA a :TranslationVariant ;
:text "その者を、ポリュネイケスは私たちの地へ"^^xsd:string ;
:relatedTo :Line_110 .

:TV_Line_111_JA a :TranslationVariant ;
:text "両義の争いから高められて"^^xsd:string ;
:relatedTo :Line_111 .

:TV_Line_112_JA a :TranslationVariant ;
:text "敵として連れて来た。彼は鋭く叫びながら、"^^xsd:string ;
:relatedTo :Line_112 .
