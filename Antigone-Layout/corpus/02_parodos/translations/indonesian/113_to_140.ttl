@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parodos-translations-113-140-indonesian a owl:Ontology .
# Indonesian translation variants for 113_to_140.ttl

:TV_Line_113_ID a :TranslationVariant ;
:text "seperti rajawali ia terbang melampaui negeri,"^^xsd:string ;
:relatedTo :Line_113 .

:TV_Line_114_ID a :TranslationVariant ;
:text "tertutup oleh sayap salju putih,"^^xsd:string ;
:relatedTo :Line_114 .

:TV_Line_115_ID a :TranslationVariant ;
:text "dengan banyak senjata"^^xsd:string ;
:relatedTo :Line_115 .

:TV_Line_116_ID a :TranslationVariant ;
:text "dan dengan ketopong berjambul kuda."^^xsd:string ;
:relatedTo :Line_116 .

:TV_Line_117_ID a :TranslationVariant ;
:text "Berdiri di atas atap-atap, menganga mengelilingi dengan tombak haus darah"^^xsd:string ;
:relatedTo :Line_117 .

:TV_Line_118_ID a :TranslationVariant ;
:text "pada mulut berpintu tujuh,"^^xsd:string ;
:relatedTo :Line_118 .

:TV_Line_119_ID a :TranslationVariant ;
:text "ia pergi, sebelum pernah"^^xsd:string ;
:relatedTo :Line_119 .

:TV_Line_120_ID a :TranslationVariant ;
:text "rahangnya dipenuhi darah kita dan mahkota menara-menara"^^xsd:string ;
:relatedTo :Line_120 .

:TV_Line_121_ID a :TranslationVariant ;
:text "merebut Hefaistos berapi pinus. Demikianlah di sekeliling punggungnya terbentang"^^xsd:string ;
:relatedTo :Line_121 .

# Line 122, 123 and 124 do not exist in Antigone

:TV_Line_125_ID a :TranslationVariant ;
:text "dentang Ares, hal yang sukar ditaklukkan oleh naga lawannya."^^xsd:string ;
:relatedTo :Line_125 .

# Line 126 does not exist in Antigone

:TV_Line_127_ID a :TranslationVariant ;
:text "Sebab Zeus sangat membenci kesombongan lidah besar,"^^xsd:string ;
:relatedTo :Line_127 .

:TV_Line_128_ID a :TranslationVariant ;
:text "dan ketika melihat mereka"^^xsd:string ;
:relatedTo :Line_128 .

:TV_Line_129_ID a :TranslationVariant ;
:text "datang maju dalam arus yang besar,"^^xsd:string ;
:relatedTo :Line_129 .

:TV_Line_130_ID a :TranslationVariant ;
:text "congkak oleh gemerincing emas,"^^xsd:string ;
:relatedTo :Line_130 .

:TV_Line_131_ID a :TranslationVariant ;
:text "dengan api lemparannya ia melemparkan dia"^^xsd:string ;
:relatedTo :Line_131 .

:TV_Line_132_ID a :TranslationVariant ;
:text "pada puncak ambang,"^^xsd:string ;
:relatedTo :Line_132 .

:TV_Line_133_ID a :TranslationVariant ;
:text "ketika sudah bergegas meneriakkan kemenangan;"^^xsd:string ;
:relatedTo :Line_133 .

:TV_Line_134_ID a :TranslationVariant ;
:text "dan ke bumi yang memantul ia jatuh, terguncang,"^^xsd:string ;
:relatedTo :Line_134 .

:TV_Line_135_ID a :TranslationVariant ;
:text "pembawa api itu, yang saat itu dengan serbuan gila"^^xsd:string ;
:relatedTo :Line_135 .

:TV_Line_136_ID a :TranslationVariant ;
:text "dalam kerasukan Bakkhos meniup"^^xsd:string ;
:relatedTo :Line_136 .

:TV_Line_137_ID a :TranslationVariant ;
:text "hembusan angin-angin yang paling dibenci."^^xsd:string ;
:relatedTo :Line_137 .

:TV_Line_138_ID a :TranslationVariant ;
:text "Namun ia menguasai hal-hal lain di satu sisi,"^^xsd:string ;
:relatedTo :Line_138 .

:TV_Line_139_ID a :TranslationVariant ;
:text "dan hal-hal lain lagi ia ayunkan terhadap yang lain, menghantam,"^^xsd:string ;
:relatedTo :Line_139 .

:TV_Line_140_ID a :TranslationVariant ;
:text "Ares besar, penarik kanan."^^xsd:string ;
:relatedTo :Line_140 .
