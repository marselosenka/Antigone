@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parodos-translations-100-112-indonesian a owl:Ontology .
# Indonesian translation variants for 100_to_112.ttl

:TV_Line_100_ID a :TranslationVariant ;
:text "Sinar matahari, cahaya yang paling indah"^^xsd:string ;
:relatedTo :Line_100 .

:TV_Line_101_ID a :TranslationVariant ;
:text "yang tampak bagi Thebes berpintu tujuh,"^^xsd:string ;
:relatedTo :Line_101 .

:TV_Line_102_ID a :TranslationVariant ;
:text "cahaya dari semua yang terdahulu,"^^xsd:string ;
:relatedTo :Line_102 .

:TV_Line_103_ID a :TranslationVariant ;
:text "engkau akhirnya tampak, wahai mata"^^xsd:string ;
:relatedTo :Line_103 .

:TV_Line_104_ID a :TranslationVariant ;
:text "hari keemasan, bagi aliran-aliran Dirke,"^^xsd:string ;
:relatedTo :Line_104 .

:TV_Line_105_ID a :TranslationVariant ;
:text "datang di atas arus-arusnya,"^^xsd:string ;
:relatedTo :Line_105 .

:TV_Line_106_ID a :TranslationVariant ;
:text "dan manusia berperisai putih dari Argos itu,"^^xsd:string ;
:relatedTo :Line_106 .

:TV_Line_107_ID a :TranslationVariant ;
:text "yang maju dengan persenjataan lengkap,"^^xsd:string ;
:relatedTo :Line_107 .

:TV_Line_108_ID a :TranslationVariant ;
:text "kaubuat bergerak sebagai pelarian terdepan"^^xsd:string ;
:relatedTo :Line_108 .

:TV_Line_109_ID a :TranslationVariant ;
:text "dengan kendali yang lebih tajam."^^xsd:string ;
:relatedTo :Line_109 .

:TV_Line_110_ID a :TranslationVariant ;
:text "Dia yang ke tanah kita oleh Polineikes"^^xsd:string ;
:relatedTo :Line_110 .

:TV_Line_111_ID a :TranslationVariant ;
:text "diangkat dari perselisihan yang diperdebatkan,"^^xsd:string ;
:relatedTo :Line_111 .

:TV_Line_112_ID a :TranslationVariant ;
:text "dibawa sebagai musuh; dan ia, berteriak tajam,"^^xsd:string ;
:relatedTo :Line_112 .
