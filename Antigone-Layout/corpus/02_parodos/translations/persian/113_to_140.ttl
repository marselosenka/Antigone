@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parodos-translations-113-140-persian a owl:Ontology .
# Persian translation variants for 113_to_140.ttl

:TV_Line_113_FA a :TranslationVariant ;
:text "چون عقابی بر فراز زمین پر کشید،"^^xsd:string ;
:relatedTo :Line_113 .

:TV_Line_114_FA a :TranslationVariant ;
:text "پوشیده در بالی چون برف سپید،"^^xsd:string ;
:relatedTo :Line_114 .

:TV_Line_115_FA a :TranslationVariant ;
:text "با جنگ‌افزارهای بسیار"^^xsd:string ;
:relatedTo :Line_115 .

:TV_Line_116_FA a :TranslationVariant ;
:text "و با کلاهخودهای اسب‌یال."^^xsd:string ;
:relatedTo :Line_116 .

:TV_Line_117_FA a :TranslationVariant ;
:text "بر فراز بام‌ها ایستاد، با نیزه‌های خون‌خواه، دهان گشوده از هر سو،"^^xsd:string ;
:relatedTo :Line_117 .

:TV_Line_118_FA a :TranslationVariant ;
:text "بر دهانه هفت‌دروازه،"^^xsd:string ;
:relatedTo :Line_118 .

:TV_Line_119_FA a :TranslationVariant ;
:text "رفت، پیش از آن‌که هرگز از خون‌های ما"^^xsd:string ;
:relatedTo :Line_119 .

:TV_Line_120_FA a :TranslationVariant ;
:text "آرواره‌هایش پر شود و تاج برج‌ها"^^xsd:string ;
:relatedTo :Line_120 .

:TV_Line_121_FA a :TranslationVariant ;
:text "آتش هفایستوسِ کاج‌خوراک را بگیرد. چنین بر گرد پشت او کشیده شد"^^xsd:string ;
:relatedTo :Line_121 .

# Lines 122, 123 and 124 do not exist in Antigone

:TV_Line_125_FA a :TranslationVariant ;
:text "غرش آرس، کاری دشوار برای اژدهای روبه‌رو."^^xsd:string ;
:relatedTo :Line_125 .

# Line 126 does not exist in Antigone

:TV_Line_127_FA a :TranslationVariant ;
:text "زیرا زئوس به‌شدت از لاف‌های زبان بزرگ"^^xsd:string ;
:relatedTo :Line_127 .

:TV_Line_128_FA a :TranslationVariant ;
:text "بیزار است؛ و چون آنان را دید"^^xsd:string ;
:relatedTo :Line_128 .

:TV_Line_129_FA a :TranslationVariant ;
:text "که با سیلابی عظیم نزدیک می‌شوند،"^^xsd:string ;
:relatedTo :Line_129 .

:TV_Line_130_FA a :TranslationVariant ;
:text "مغرور به طنین زر،"^^xsd:string ;
:relatedTo :Line_130 .

:TV_Line_131_FA a :TranslationVariant ;
:text "با آتشی پرتاب‌شونده او را فرو افکند،"^^xsd:string ;
:relatedTo :Line_131 .

:TV_Line_132_FA a :TranslationVariant ;
:text "بر بلندترین کناره‌ها، در همان دم که"^^xsd:string ;
:relatedTo :Line_132 .

:TV_Line_133_FA a :TranslationVariant ;
:text "شتابان می‌رفت تا فریاد پیروزی برآورد؛"^^xsd:string ;
:relatedTo :Line_133 .

:TV_Line_134_FA a :TranslationVariant ;
:text "و بر زمینِ بازکوبنده افتاد، در هوا آویخته و لرزان،"^^xsd:string ;
:relatedTo :Line_134 .

:TV_Line_135_FA a :TranslationVariant ;
:text "آن آتش‌بر، که آن هنگام با یورش دیوانه‌وار"^^xsd:string ;
:relatedTo :Line_135 .

:TV_Line_136_FA a :TranslationVariant ;
:text "در مستی باکخی می‌دمید،"^^xsd:string ;
:relatedTo :Line_136 .

:TV_Line_137_FA a :TranslationVariant ;
:text "با تندبادهای نفرت‌انگیزترین بادها."^^xsd:string ;
:relatedTo :Line_137 .

:TV_Line_138_FA a :TranslationVariant ;
:text "اما سرنوشت چیزهای دیگر را نگاه داشت،"^^xsd:string ;
:relatedTo :Line_138 .

:TV_Line_139_FA a :TranslationVariant ;
:text "و چیزهای دیگر را بر دیگران می‌گرداند، در حالی که می‌کوبید،"^^xsd:string ;
:relatedTo :Line_139 .

:TV_Line_140_FA a :TranslationVariant ;
:text "آرس بزرگ، چون اسب راستِ ارابه."^^xsd:string ;
:relatedTo :Line_140 .
