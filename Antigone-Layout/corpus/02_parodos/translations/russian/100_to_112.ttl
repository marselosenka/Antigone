@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parodos-translations-100-112-russian a owl:Ontology .
# Russian translation variants for 100_to_112.ttl

:TV_Line_100_RU a :TranslationVariant ;
:text "Луч солнца, прекраснейший"^^xsd:string ;
:relatedTo :Line_100 .

:TV_Line_101_RU a :TranslationVariant ;
:text "явившийся семивратным"^^xsd:string ;
:relatedTo :Line_101 .

:TV_Line_102_RU a :TranslationVariant ;
:text "Фивам свет из прежних,"^^xsd:string ;
:relatedTo :Line_102 .

:TV_Line_103_RU a :TranslationVariant ;
:text "ты наконец явился, о золотого"^^xsd:string ;
:relatedTo :Line_103 .

:TV_Line_104_RU a :TranslationVariant ;
:text "дня око, над диркейскими"^^xsd:string ;
:relatedTo :Line_104 .

:TV_Line_105_RU a :TranslationVariant ;
:text "потоками пришедшее,"^^xsd:string ;
:relatedTo :Line_105 .

:TV_Line_106_RU a :TranslationVariant ;
:text "белощитного из Аргоса"^^xsd:string ;
:relatedTo :Line_106 .

:TV_Line_107_RU a :TranslationVariant ;
:text "мужа, пришедшего во всеоружии,"^^xsd:string ;
:relatedTo :Line_107 .

:TV_Line_108_RU a :TranslationVariant ;
:text "беглецом, бегущим вперед, более острым"^^xsd:string ;
:relatedTo :Line_108 .

:TV_Line_109_RU a :TranslationVariant ;
:text "поводом приведя в движение."^^xsd:string ;
:relatedTo :Line_109 .

:TV_Line_110_RU a :TranslationVariant ;
:text "Его на нашу землю Полиник,"^^xsd:string ;
:relatedTo :Line_110 .

:TV_Line_111_RU a :TranslationVariant ;
:text "поднятый из спорных распрей,"^^xsd:string ;
:relatedTo :Line_111 .

:TV_Line_112_RU a :TranslationVariant ;
:text "привел врагом; а тот, остро крича,"^^xsd:string ;
:relatedTo :Line_112 .
