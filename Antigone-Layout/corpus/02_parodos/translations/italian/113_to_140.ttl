@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parodos-translations-113-140-italian a owl:Ontology .
# Italian translation variants for 113_to_140.ttl

:TV_Line_113_IT a :TranslationVariant ;
:text "come aquila volò sopra la terra,"^^xsd:string ;
:relatedTo :Line_113 .

:TV_Line_114_IT a :TranslationVariant ;
:text "coperto dall'ala di bianca neve,"^^xsd:string ;
:relatedTo :Line_114 .

:TV_Line_115_IT a :TranslationVariant ;
:text "con molte armi"^^xsd:string ;
:relatedTo :Line_115 .

:TV_Line_116_IT a :TranslationVariant ;
:text "e con elmi dalla criniera equina."^^xsd:string ;
:relatedTo :Line_116 .

:TV_Line_117_IT a :TranslationVariant ;
:text "Stando sopra i tetti, spalancato tutt'intorno con lance assetate di sangue"^^xsd:string ;
:relatedTo :Line_117 .

:TV_Line_118_IT a :TranslationVariant ;
:text "alla bocca dalle sette porte,"^^xsd:string ;
:relatedTo :Line_118 .

:TV_Line_119_IT a :TranslationVariant ;
:text "se ne andò, prima che mai delle nostre"^^xsd:string ;
:relatedTo :Line_119 .

:TV_Line_120_IT a :TranslationVariant ;
:text "sangui le mascelle fossero riempite e prima che la corona delle torri"^^xsd:string ;
:relatedTo :Line_120 .

:TV_Line_121_IT a :TranslationVariant ;
:text "prendesse l'Efesto resinoso. Tale intorno al dorso si tese"^^xsd:string ;
:relatedTo :Line_121 .

# Lines 122, 123, and 124 are commented out in canonical.

:TV_Line_125_IT a :TranslationVariant ;
:text "il fragore di Ares, duro assalto del drago avversario."^^xsd:string ;
:relatedTo :Line_125 .

# Line 126 is commented out in canonical.

:TV_Line_127_IT a :TranslationVariant ;
:text "Zeus infatti odia oltre misura i vanti"^^xsd:string ;
:relatedTo :Line_127 .

:TV_Line_128_IT a :TranslationVariant ;
:text "di grande lingua, e vedendoli"^^xsd:string ;
:relatedTo :Line_128 .

:TV_Line_129_IT a :TranslationVariant ;
:text "avanzare con grande corrente,"^^xsd:string ;
:relatedTo :Line_129 .

:TV_Line_130_IT a :TranslationVariant ;
:text "superbi per il clangore dell'oro,"^^xsd:string ;
:relatedTo :Line_130 .

:TV_Line_131_IT a :TranslationVariant ;
:text "con fuoco balzante lo getta dalle soglie,"^^xsd:string ;
:relatedTo :Line_131 .

:TV_Line_132_IT a :TranslationVariant ;
:text "già sulle altezze estreme,"^^xsd:string ;
:relatedTo :Line_132 .

:TV_Line_133_IT a :TranslationVariant ;
:text "mentre si slanciavano a gridare vittoria;"^^xsd:string ;
:relatedTo :Line_133 .

:TV_Line_134_IT a :TranslationVariant ;
:text "sulla terra risonante cadde, come Tantalo sospeso,"^^xsd:string ;
:relatedTo :Line_134 .

:TV_Line_135_IT a :TranslationVariant ;
:text "il portatore di fuoco, che allora con folle impulso,"^^xsd:string ;
:relatedTo :Line_135 .

:TV_Line_136_IT a :TranslationVariant ;
:text "in furore bacchico, soffiava"^^xsd:string ;
:relatedTo :Line_136 .

:TV_Line_137_IT a :TranslationVariant ;
:text "con raffiche di venti odiosissimi."^^xsd:string ;
:relatedTo :Line_137 .

:TV_Line_138_IT a :TranslationVariant ;
:text "Altre cose teneva da una parte,"^^xsd:string ;
:relatedTo :Line_138 .

:TV_Line_139_IT a :TranslationVariant ;
:text "altre su altri muoveva, colpendo duramente,"^^xsd:string ;
:relatedTo :Line_139 .

:TV_Line_140_IT a :TranslationVariant ;
:text "il grande Ares, cavallo di destra."^^xsd:string ;
:relatedTo :Line_140 .
