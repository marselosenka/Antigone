@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parodos-translations-100-112-italian a owl:Ontology .
# Italian translation variants for 100_to_112.ttl

:TV_Line_100_IT a :TranslationVariant ;
:text "Raggio del sole, la più bella"^^xsd:string ;
:relatedTo :Line_100 .

:TV_Line_101_IT a :TranslationVariant ;
:text "luce apparsa alla Tebe"^^xsd:string ;
:relatedTo :Line_101 .

:TV_Line_102_IT a :TranslationVariant ;
:text "dalle sette porte tra quelle di prima,"^^xsd:string ;
:relatedTo :Line_102 .

:TV_Line_103_IT a :TranslationVariant ;
:text "sei apparso infine, o della dorata"^^xsd:string ;
:relatedTo :Line_103 .

:TV_Line_104_IT a :TranslationVariant ;
:text "giornata palpebra, sopra i dircei"^^xsd:string ;
:relatedTo :Line_104 .

:TV_Line_105_IT a :TranslationVariant ;
:text "flutti venendo,"^^xsd:string ;
:relatedTo :Line_105 .

:TV_Line_106_IT a :TranslationVariant ;
:text "e l'uomo dallo scudo bianco venuto da Argo,"^^xsd:string ;
:relatedTo :Line_106 .

:TV_Line_107_IT a :TranslationVariant ;
:text "avanzato con tutta l'armatura,"^^xsd:string ;
:relatedTo :Line_107 .

:TV_Line_108_IT a :TranslationVariant ;
:text "fuggiasco in corsa davanti, con più acuto"^^xsd:string ;
:relatedTo :Line_108 .

:TV_Line_109_IT a :TranslationVariant ;
:text "morso hai messo in moto."^^xsd:string ;
:relatedTo :Line_109 .

:TV_Line_110_IT a :TranslationVariant ;
:text "Lui che contro la nostra terra Polinice,"^^xsd:string ;
:relatedTo :Line_110 .

:TV_Line_111_IT a :TranslationVariant ;
:text "sollevato da contese ambigue,"^^xsd:string ;
:relatedTo :Line_111 .

:TV_Line_112_IT a :TranslationVariant ;
:text "condusse come nemico; ed egli, gridando acuto,"^^xsd:string ;
:relatedTo :Line_112 .
