@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parodos-translations-100-112-french a owl:Ontology .
# French translation variants for 100_to_112.ttl

:TV_Line_100_FR a :TranslationVariant ;
:text "Rayon du soleil, la plus belle"^^xsd:string ;
:relatedTo :Line_100 .

:TV_Line_101_FR a :TranslationVariant ;
:text "lumière apparue"^^xsd:string ;
:relatedTo :Line_101 .

:TV_Line_102_FR a :TranslationVariant ;
:text "à Thèbes aux sept portes parmi les lumières d’autrefois,"^^xsd:string ;
:relatedTo :Line_102 .

:TV_Line_103_FR a :TranslationVariant ;
:text "tu t’es enfin manifesté, ô paupière"^^xsd:string ;
:relatedTo :Line_103 .

:TV_Line_104_FR a :TranslationVariant ;
:text "du jour d’or, au-dessus des eaux"^^xsd:string ;
:relatedTo :Line_104 .

:TV_Line_105_FR a :TranslationVariant ;
:text "de Dircé, étant venu,"^^xsd:string ;
:relatedTo :Line_105 .

:TV_Line_106_FR a :TranslationVariant ;
:text "l’homme au bouclier blanc venu d’Argos,"^^xsd:string ;
:relatedTo :Line_106 .

:TV_Line_107_FR a :TranslationVariant ;
:text "venu en armure complète,"^^xsd:string ;
:relatedTo :Line_107 .

:TV_Line_108_FR a :TranslationVariant ;
:text "fugitif lancé en avant dans sa fuite, d’un frein plus aigu"^^xsd:string ;
:relatedTo :Line_108 .

:TV_Line_109_FR a :TranslationVariant ;
:text "tu l’as mis en mouvement."^^xsd:string ;
:relatedTo :Line_109 .

:TV_Line_110_FR a :TranslationVariant ;
:text "Lui que Polynice, contre notre terre,"^^xsd:string ;
:relatedTo :Line_110 .

:TV_Line_111_FR a :TranslationVariant ;
:text "soulevé par des querelles équivoques,"^^xsd:string ;
:relatedTo :Line_111 .

:TV_Line_112_FR a :TranslationVariant ;
:text "amena en ennemi; et lui, poussant des cris aigus,"^^xsd:string ;
:relatedTo :Line_112 .
