@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parodos-translations-100-112-portuguese a owl:Ontology .
# Portuguese translation variants for 100_to_112.ttl

:TV_Line_100_PT a :TranslationVariant ;
:text "Raio do sol, a mais bela"^^xsd:string ;
:relatedTo :Line_100 .

:TV_Line_101_PT a :TranslationVariant ;
:text "luz que apareceu à Tebas de sete portas"^^xsd:string ;
:relatedTo :Line_101 .

:TV_Line_102_PT a :TranslationVariant ;
:text "entre as luzes anteriores,"^^xsd:string ;
:relatedTo :Line_102 .

:TV_Line_103_PT a :TranslationVariant ;
:text "apareceste enfim, ó pálpebra"^^xsd:string ;
:relatedTo :Line_103 .

:TV_Line_104_PT a :TranslationVariant ;
:text "do dia dourado, sobre as correntes"^^xsd:string ;
:relatedTo :Line_104 .

:TV_Line_105_PT a :TranslationVariant ;
:text "de Dirce tendo vindo,"^^xsd:string ;
:relatedTo :Line_105 .

:TV_Line_106_PT a :TranslationVariant ;
:text "o homem de escudo branco vindo de Argos"^^xsd:string ;
:relatedTo :Line_106 .

:TV_Line_107_PT a :TranslationVariant ;
:text "que avançara com panóplia inteira,"^^xsd:string ;
:relatedTo :Line_107 .

:TV_Line_108_PT a :TranslationVariant ;
:text "fugitivo à frente, com mais agudo"^^xsd:string ;
:relatedTo :Line_108 .

:TV_Line_109_PT a :TranslationVariant ;
:text "freio o puseste em movimento."^^xsd:string ;
:relatedTo :Line_109 .

:TV_Line_110_PT a :TranslationVariant ;
:text "A ele, contra nossa terra, Polinices,"^^xsd:string ;
:relatedTo :Line_110 .

:TV_Line_111_PT a :TranslationVariant ;
:text "erguido por contendas ambíguas,"^^xsd:string ;
:relatedTo :Line_111 .

:TV_Line_112_PT a :TranslationVariant ;
:text "trouxe como inimigo; e ele, gritando agudamente,"^^xsd:string ;
:relatedTo :Line_112 .
