@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parodos-translations-100-112-bengali a owl:Ontology .
# Bengali translation variants for 100_to_112.ttl

:TV_Line_100_BN a :TranslationVariant ;
:text "হে সূর্যের রশ্মি, সর্বসুন্দর"^^xsd:string ;
:relatedTo :Line_100 .

:TV_Line_101_BN a :TranslationVariant ;
:text "সাত-দ্বারী থিব্সে প্রকাশিত"^^xsd:string ;
:relatedTo :Line_101 .

:TV_Line_102_BN a :TranslationVariant ;
:text "আগেকার সব আলোর মধ্যে শ্রেষ্ঠ আলো,"^^xsd:string ;
:relatedTo :Line_102 .

:TV_Line_103_BN a :TranslationVariant ;
:text "শেষে তুমি দেখা দিলে, হে সোনালি"^^xsd:string ;
:relatedTo :Line_103 .

:TV_Line_104_BN a :TranslationVariant ;
:text "দিনের চোখ, দির্কের"^^xsd:string ;
:relatedTo :Line_104 .

:TV_Line_105_BN a :TranslationVariant ;
:text "স্রোতের উপর দিয়ে এসে,"^^xsd:string ;
:relatedTo :Line_105 .

:TV_Line_106_BN a :TranslationVariant ;
:text "আর্গস থেকে আসা সাদা-ঢালধারী"^^xsd:string ;
:relatedTo :Line_106 .

:TV_Line_107_BN a :TranslationVariant ;
:text "যোদ্ধাকে, যে পূর্ণ অস্ত্রসজ্জায় এসেছিল,"^^xsd:string ;
:relatedTo :Line_107 .

:TV_Line_108_BN a :TranslationVariant ;
:text "দ্রুত অগ্রপালানো পলাতক করে,"^^xsd:string ;
:relatedTo :Line_108 .

:TV_Line_109_BN a :TranslationVariant ;
:text "আরও তীক্ষ্ণ লাগাম দিয়ে তাড়িয়ে দিলে।"^^xsd:string ;
:relatedTo :Line_109 .

:TV_Line_110_BN a :TranslationVariant ;
:text "যাকে আমাদের ভূমির বিরুদ্ধে পলিনেইকেস,"^^xsd:string ;
:relatedTo :Line_110 .

:TV_Line_111_BN a :TranslationVariant ;
:text "দ্বিমুখী বিবাদের ঝগড়ায় উত্তোলিত হয়ে,"^^xsd:string ;
:relatedTo :Line_111 .

:TV_Line_112_BN a :TranslationVariant ;
:text "শত্রু করে এনেছিল; আর সে তীক্ষ্ণস্বরে চিৎকার করে"^^xsd:string ;
:relatedTo :Line_112 .
