@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:parodos-translations-100-112-arabic a owl:Ontology .
# Arabic translation variants for 100_to_112.ttl

:TV_Line_100_AR a :TranslationVariant ;
:text "يا شعاع الشمس، أجمل"^^xsd:string ;
:relatedTo :Line_100 .

:TV_Line_101_AR a :TranslationVariant ;
:text "نور ظهر لطيبة ذات الأبواب السبعة"^^xsd:string ;
:relatedTo :Line_101 .

:TV_Line_102_AR a :TranslationVariant ;
:text "من بين الأنوار السابقة،"^^xsd:string ;
:relatedTo :Line_102 .

:TV_Line_103_AR a :TranslationVariant ;
:text "لقد ظهرت أخيرًا، يا عين"^^xsd:string ;
:relatedTo :Line_103 .

:TV_Line_104_AR a :TranslationVariant ;
:text "النهار الذهبي، فوق مجاري"^^xsd:string ;
:relatedTo :Line_104 .

:TV_Line_105_AR a :TranslationVariant ;
:text "ديركي، إذ أقبلتِ،"^^xsd:string ;
:relatedTo :Line_105 .

:TV_Line_106_AR a :TranslationVariant ;
:text "والرجل ذا الدرع الأبيض من أرغوس"^^xsd:string ;
:relatedTo :Line_106 .

:TV_Line_107_AR a :TranslationVariant ;
:text "الذي أتى مدججًا بكل السلاح،"^^xsd:string ;
:relatedTo :Line_107 .

:TV_Line_108_AR a :TranslationVariant ;
:text "حرّكته هاربًا في المقدمة"^^xsd:string ;
:relatedTo :Line_108 .

:TV_Line_109_AR a :TranslationVariant ;
:text "بلجام أشد حدة."^^xsd:string ;
:relatedTo :Line_109 .

:TV_Line_110_AR a :TranslationVariant ;
:text "ذاك الذي على أرضنا بولينيكيس،"^^xsd:string ;
:relatedTo :Line_110 .

:TV_Line_111_AR a :TranslationVariant ;
:text "إذ ارتفع من خصومات مزدوجة النزاع،"^^xsd:string ;
:relatedTo :Line_111 .

:TV_Line_112_AR a :TranslationVariant ;
:text "جاء به عدوًّا؛ وكان، صارخًا صراخًا حادًّا،"^^xsd:string ;
:relatedTo :Line_112 .
