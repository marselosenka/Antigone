################################################################
# CHARACTERS (if not already declared elsewhere)
################################################################

# Need semantics ( Some are mentioned, thats why they are present. )
:Antigone_Character_Antigone a :Character .
:Antigone_Character_Ismene a :Character .

:Antigone_Character_Chorus
a owl:NamedIndividual, :Character ;
:role "Chorus"^^xsd:string ;
:hasMotivation :Motivation_CelebrateVictoryWithChorusDances ;
:experiencesEmotion :Emotion_ReliefAndExultation .

:Antigone_Character_Eteocles
a owl:NamedIndividual, :Character ;
:description "Brother of Antigone; one of the two brothers who share a common death."^^xsd:string .

:Antigone_Character_Polyneices
a owl:NamedIndividual, :Character ;
:description "Brother of Antigone; one of the two brothers who share a common death."^^xsd:string .

:Antigone_Character_Creon
a owl:NamedIndividual, :Character ;
:hasMotivation :Motivation_CreonConveneEldersCouncil ;
:makesMoralDecision :MoralDecision_SummonEldersByCommonProclamation .

####################################################################
# THEMES
#####################################################################

:Theme_ImpossibleAction
a :Theme ;
:description "Acting on what is impossible or beyond one’s power, and the prudence of not pursuing it."^^xsd:string .

:Theme_NobleDeath
a :Theme ;
:description "The insistence that a death undertaken for a chosen act can be noble and fitting."^^xsd:string .

:Theme_HonorDead
a :Theme ;
:description "Duty toward the dead and the moral demand to honor them properly."^^xsd:string .

:Theme_SisterlyConflict
a :Theme ;
:description "Tension between the sisters’ opposing judgments and loyalties."^^xsd:string .

:Theme_LoyalFriendship
a :Theme ;
:description "Despite disagreement, affection and loyalty toward loved ones remain steadfast."^^xsd:string .

:Theme_DawnHope
a :Theme ;
:description "The appearance of sunlight as a sign of renewal and relief for the city."^^xsd:string .

:Theme_WarAftermath
a :Theme ;
:description "The city’s land and people after invasion, with the enemy driven off."^^xsd:string .

:Theme_InvasionThreat
a :Theme ;
:description "The enemy invasion is presented as a predator circling the houses and threatening the gates of Thebes."^^xsd:string .

:Theme_ThebesDefense
a :Theme ;
:description "Seven-gated Thebes resists before the enemy can be satisfied with blood and crown her towers with fire."^^xsd:string .

:Theme_WarViolence
a :Theme ;
:description "War is represented as noise and force, with spears, weapons, and a destructive whirl of powers."^^xsd:string .

:Theme_DivineIntervention
a :Theme ;
:description "Divine intervention stops the invader at the moment when he is about to shout in victory."^^xsd:string .

:Theme_ZeusSupremacy
a :Theme ;
:description "Zeus rejects arrogance and crushes the proud with fire."^^xsd:string .

:Theme_ThebanVictoryThanksgiving
a :Theme ;
:description "Thebes celebrates victory, offers thanks to Zeus, and proposes night-long choral dances at the temples."^^xsd:string .

:Theme_FraternalCivilWar
a :Theme ;
:description "The war ends with the exceptional tragedy of the two brothers sharing a common death by mutual spears."^^xsd:string .

:Theme_PoliticalTransitionToCreon
a :Theme ;
:description "After the war, Creon appears as the new ruler and convenes the elders’ council by public proclamation."^^xsd:string .


####################################################################
# MOTIVATIONS
#####################################################################

:Motivation_CelebrateVictoryWithChorusDances
a :Motivation ;
:description "To set forgetfulness of the present war and visit the gods’ temples with all-night choral dances, led by Bacchus of Thebes."^^xsd:string .

:Motivation_CreonConveneEldersCouncil
a :Motivation ;
:description "To convene the elders’ council and declare his plan publicly after new divine circumstances for the city."^^xsd:string .

:Motivation_IsmeneDiscourageImpossible
a :Motivation ;
:description "To discourage pursuing an impossible course and warn against futile action."^^xsd:string .

:Motivation_AntigonePersistUntilNoStrength
a :Motivation ;
:description "To continue the intended act until she no longer has strength to do it."^^xsd:string .

:Motivation_AntigoneAcceptConsequences
a :Motivation ;
:description "To accept suffering as the price of her own resolve, aiming at a noble death."^^xsd:string .

:Motivation_IsmeneReluctantConsent
a :Motivation ;
:description "To allow Antigone to proceed while still judging the action unwise, remaining loyal in affection."^^xsd:string .

####################################################################
# EMOTIONS
#####################################################################

:Emotion_IsmeneConcern
a :Emotion ;
:description "Concern and caution toward Antigone’s plan, emphasizing limits and danger."^^xsd:string .

:Emotion_AntigoneResolve
a :Emotion ;
:description "Steadfast resolve to act, with readiness to stop only when strength fails."^^xsd:string .

:Emotion_AntigoneDefiance
a :Emotion ;
:description "Defiance toward discouragement and unwavering commitment to honor the dead."^^xsd:string .

:Emotion_ReliefAndExultation
a :Emotion ;
:description "Relief and celebratory exultation after the war, invoking Victory and proposing communal thanksgiving."^^xsd:string .


####################################################################
# ETHICAL PRINCIPLES
#####################################################################
:EthicalPrinciple_HonorDead
a :EthicalPrinciple ;
:description "The dead must not be treated as enemies by the living; honoring them is morally required."^^xsd:string .

####################################################################
# MORAL DECISIONS
#####################################################################

:MoralDecision_DieNoblyForHonor
a :MoralDecision ;
:description "Decision to proceed even at cost of suffering, ensuring that death will be noble rather than shameful."^^xsd:string ;
:relatedTo :EthicalPrinciple_HonorDead ;
:relatedTo :Motivation_AntigoneAcceptConsequences .

:MoralDecision_SummonEldersByCommonProclamation
a :MoralDecision ;
:description "Creon summons the elders’ assembly by sending a common proclamation."^^xsd:string .


####################################################################
# CONFLICTS
#####################################################################

:Conflict_PrudenceVsHonor
a :Conflict ;
:description "Prudential restraint (impossibility, obedience, caution) clashes with the demand to honor the dead."^^xsd:string ;
:conflictBetween :Motivation_IsmeneDiscourageImpossible, :EthicalPrinciple_HonorDead .

:Conflict_LoyaltyToDeadVsFear
a :Conflict ;
:description "Fearful caution about consequences conflicts with loyalty to the dead and the chosen act."^^xsd:string ;
:conflictBetween :Emotion_IsmeneConcern, :Motivation_AntigoneAcceptConsequences .

:Conflict_HubrisVsDivineOrder
a :Conflict ;
:description "The arrogance of the boastful tongue and the showy force of victory come into conflict with the divine order imposed by Zeus."^^xsd:string ;
:conflictBetween :Theme_ZeusSupremacy, :Theme_InvasionThreat .

:Conflict_BrothersMutualDeath
a :Conflict ;
:description "The two brothers, born of one father and one mother, set double spears against each other and both receive a share of a common death."^^xsd:string ;
:conflictBetween :Antigone_Character_Eteocles, :Antigone_Character_Polyneices .


####################################################################
# SYMBOLS
#####################################################################

:Symbol_SunRay
a :Symbol ;
:description "The sunbeam/light appearing over Thebes as an emblem of renewal and victory."^^xsd:string .

:Symbol_EagleInvader
a :Symbol ;
:description "The eagle as a symbol of an aggressive invader and predatory violence."^^xsd:string .

:Symbol_SevenSpears
a :Symbol ;
:description "The spears around the seven-gated mouth as a symbol of siege and collective threat."^^xsd:string .

:Symbol_FireBrand
a :Symbol ;
:description "Fire, Hephaestian or thunderbolt-like, as a symbol of destruction but also of divine punishment."^^xsd:string .

####################################################################
# MYTHS
#####################################################################
:Myth_Sunlight
a :MythologicalBackground ;
:description "Invocation of the sun’s ray and golden day as a divine/poetic force of light."^^xsd:string .

:Myth_ThebesSevenGates
a :MythologicalBackground ;
:description "Reference to seven-gated Thebes (ἑπταπύλῳ Θήβᾳ)."^^xsd:string .

:Myth_DirceStreams
a :MythologicalBackground ;
:description "Reference to the streams of Dirce (Διρκαίων ῥεέθρων)."^^xsd:string .

:Myth_ArgiveArmy
a :MythologicalBackground ;
:description "Reference to the Argive force/warrior driven in flight after the assault."^^xsd:string .

:Myth_PolyneicesAttack
a :MythologicalBackground ;
:description "Reference to Polyneices bringing an enemy to Theban land through disputed quarrels."^^xsd:string .

:Myth_ArgiveEagleAssault
a :MythologicalBackground ;
:description "The enemy is compared to an eagle flying above with white wings and many weapons, ready to seize Thebes."^^xsd:string .

:Myth_SevenGates
a :MythologicalBackground ;
:description "Reference to the 'seven-gated mouth' of Thebes and to the spears surrounding it."^^xsd:string .

:Myth_HephaestusFire
a :MythologicalBackground ;
:description "Hephaestian fire as a threat of burning and crowning the towers with flame."^^xsd:string .

:Myth_AresWarClash
a :MythologicalBackground ;
:description "The clash of Ares stretches around the ridges, with Ares whirling the conflict."^^xsd:string .

:Myth_DragonDefender
a :MythologicalBackground ;
:description "The 'dragon' as an opposing defensive force, a Theban or chthonic symbol, within the struggle of war."^^xsd:string .

:Myth_ZeusLightningStrike
a :MythologicalBackground ;
:description "Zeus, hating the boasts of a proud tongue, throws fire upon the arrogant man at the moment of approaching victory."^^xsd:string .

:Myth_ZeusTropaios
a :MythologicalBackground ;
:description "Invocation of Zeus as 'Tropaios' receiving bronze offerings for victory."^^xsd:string .

:Myth_NikeVictory
a :MythologicalBackground ;
:description "Personified Victory ('Nike') arrives, rejoicing with heavily-armed Thebes."^^xsd:string .

:Myth_Bacchus
a :MythologicalBackground ;
:description "Bacchus (Dionysus) as leader of Theban celebration and dance."^^xsd:string .

####################################################################
# EVENTS 
#####################################################################

:Event_VictoryArrivesAtThebes
a owl:NamedIndividual, owl:Thing ;
:description "The arrival of renowned Victory to Thebes following the war."^^xsd:string ;
:relatedTo :Myth_NikeVictory ;
:relatedTo :Motivation_CelebrateVictoryWithChorusDances .

:Event_CreonApproachesAsNewRuler
a owl:NamedIndividual, owl:Thing ;
:description "Creon, son of Menoeceus, approaches as new ruler, advancing a plan and convening the elders."^^xsd:string ;
:relatedTo :Motivation_CreonConveneEldersCouncil ;
:relatedTo :MoralDecision_SummonEldersByCommonProclamation .
