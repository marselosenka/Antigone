# =============================================================================
# EMOTIONS
# =============================================================================

:AntigoneEmotion_HopeForFamilyAcceptanceInDeath a :Emotion,
        owl:NamedIndividual ;
    :description "She nourishes hope that she will come dear to her father, mother, and brother in Hades because she performed burial rites for them."^^xsd:string .

:AntigoneEmotion_HopeForFamilyAcceptanceInDeath a :Emotion,
        owl:NamedIndividual ;
    :description "She nourishes hope that she will come dear to her father, mother, and brother in Hades because she performed burial rites for them."^^xsd:string .

:AntigoneEmotion_HumiliationAtMockery a :Emotion,
        owl:NamedIndividual ;
    :description "Antigone feels mocked and dishonoured ('γελῶμαι', 'ὑβρίζεις') while still visible and not yet gone."^^xsd:string .

:AntigoneEmotion_IndignationAtInjustice a :Emotion,
        owl:NamedIndividual ;
    :description "She questions what divine justice she has transgressed and protests that she has gained 'δυσσέβειαν' by acting piously."^^xsd:string .

:AntigoneEmotion_LamentAndDespair a :Emotion,
        owl:NamedIndividual ;
    :description "Lament and despair: she is seen walking the final road, leaving behind the light of the sun, without wedding songs."^^xsd:string .

:AntigoneEmotion_LamentAndDread a :Emotion,
        owl:NamedIndividual ;
    :description "Antigone laments (οἴμοι) and recognizes the nearness of death as she is led away."^^xsd:string .

:AntigoneEmotion_LamentAndIsolation a :Emotion,
        owl:NamedIndividual ;
    :description "Antigone laments being led away 'ἄκλαυτος, ἄφιλος, ἀνυμέναιος' and deprived of the light; she notes no friend mourns her fate."^^xsd:string .

:AntigoneEmotion_LamentationAndDespair a :Emotion,
        owl:NamedIndividual ;
    :description "Lament for her fate as neither among the living nor the dead; grief over family curse and isolation."^^xsd:string .

:ChorusEmotion_AustereAdmonition a :Emotion,
        owl:NamedIndividual ;
    :description "Sober, admonitory stance: stresses mortal limits and frames Antigone's suffering as consequence of daring against Justice."^^xsd:string .

:ChorusEmotion_AweAndPity a :Emotion,
        owl:NamedIndividual ;
    :description "Θαῦμα καὶ οἶκτος: κλεινὴ καὶ ἔπαινον ἔχουσα, αὐτόνομος ζῶσα μόνη καταβαίνει πρὸς Ἅιδην."^^xsd:string .

:ChorusEmotion_ConcernAtPersistentGrief a :Emotion,
        owl:NamedIndividual ;
    :description "The Chorus notes the same gusts of the soul still persist, implying ongoing agitation and grief."^^xsd:string .

:ChorusEmotion_ReproachAtSelfWilledAnger a :Emotion,
        owl:NamedIndividual ;
    :description "The Chorus attributes Antigone's ruin to 'αὐτόγνωτος ... ὀργά' while acknowledging piety."^^xsd:string .

:CreonEmotion_UnyieldingResolve a :Emotion,
        owl:NamedIndividual ;
    :description "Creon shows firmness and lack of consolation; he will not be persuaded otherwise."^^xsd:string .

# ===========================================================================
# MOTIVATIONS
# ===========================================================================

:AntigoneMotivation_AddressCitizensAsWitnesses a :Motivation,
        owl:NamedIndividual ;
    :description "She wants to make the citizens witnesses of her final journey and of the injustice or fate that leads her."^^xsd:string .

:AntigoneMotivation_AffirmPietyBeforeDeath a :Motivation,
        owl:NamedIndividual ;
    :description "Antigone seeks to bear witness to her suffering and to frame it as the result of honoring piety (εὐσέβεια) as she is led away."^^xsd:string .

:AntigoneMotivation_AppealToCityAsWitness a :Motivation,
        owl:NamedIndividual ;
    :description "She calls on Thebes (Dirce's springs, the grove) and its citizens as witnesses to her unwept, friendless march to the tomb."^^xsd:string .

:AntigoneMotivation_HonorPolyneicesWithBurialRites a :Motivation,
        owl:NamedIndividual ;
    :description "To honor Polyneices by washing, adorning, and giving tomb-offerings; she claims this is why she now suffers."^^xsd:string .

:AntigoneMotivation_InterpretFateAsDivineLullingToRest a :Motivation,
        owl:NamedIndividual ;
    :description "She interprets her situation through the paradigm of Niobe and says a daimon 'lulls' her into a similar rest—seeking meaning in divine causation."^^xsd:string .

:CreonMotivation_EnforcePunishmentByEntombment a :Motivation,
        owl:NamedIndividual ;
    :description "To carry out the ordered punishment: shut Antigone in a roofed tomb, leave her alone, and remove the city's direct responsibility for her death."^^xsd:string .

:CreonMotivation_PunishDelayAndProceed a :Motivation,
        owl:NamedIndividual ;
    :description "Creon intends that those leading Antigone away will have lamentation as a consequence of their slowness; he presses the process forward."^^xsd:string .


# ===========================================================================
# THEMES
# ===========================================================================

:Theme_ApproachOfDeath a :Theme,
        owl:NamedIndividual ;
    :description "Death is imminent; speech recognizes the closeness of the fatal outcome."^^xsd:string .

:Theme_DeathAsMarriage a :Theme,
        owl:NamedIndividual ;
    :description "Ὁ θάνατος παρασταίνεται ὡς νυμφεία/γάμος: Ἅιδης 'παγκοίτας', Ἀχέρων νυμφίος."^^xsd:string .

:Theme_DivinePowerOverHumanWill a :Theme,
        owl:NamedIndividual ;
    :description "Divine forces (e.g., Dionysus) overpower human resistance; impiety toward a god leads to binding and ruin."^^xsd:string .

:Theme_DivineVsMortalCondition a :Theme,
        owl:NamedIndividual ;
    :description "Contrast between gods (and god-born) and mortals; warning against claiming godlike status in suffering or honour."^^xsd:string .

:Theme_FamilyCurseOfLabdacids a :Theme,
        owl:NamedIndividual ;
    :description "The inherited ruin of Oedipus' house: maternal bed-curses, incest, and the ancestral doom of the Labdacids."^^xsd:string .

:Theme_FamilyLoyalty a :Theme,
        owl:NamedIndividual ;
    :description "Kinship loyalty motivates action; Antigone prioritizes brother over replaceable marital/parental ties."^^xsd:string .

:Theme_InevitabilityOfFate a :Theme,
        owl:NamedIndividual ;
    :description "Fate (μοῖρα) is a fearful power from which prosperity, war, fortifications, and ships cannot escape."^^xsd:string .

:Theme_IsolationAndDeath a :Theme,
        owl:NamedIndividual ;
    :description "Isolation, loss of marriage/children, and living entombment as a passage to death."^^xsd:string .

:Theme_IsolationAndFameInDeath a :Theme,
        owl:NamedIndividual ;
    :description "Glory and praise in death, together with an unusual fate: autonomous, alive, alone, without illness or sword, she descends."^^xsd:string .

:Theme_LamentForLostMarriage a :Theme,
        owl:NamedIndividual ;
    :description "Deprivation of wedding songs and hymns; instead of a human marriage, there is descent into death."^^xsd:string .

:Theme_LivingDeathAndExile a :Theme,
        owl:NamedIndividual ;
    :description "Antigone is led to a tomb while alive, describing herself as a metic among neither living nor dead."^^xsd:string .

:Theme_PersistenceOfGrief a :Theme,
        owl:NamedIndividual ;
    :description "The persistence of inner turmoil and grief, described as recurring winds/gusts of the soul."^^xsd:string .

:Theme_PietyAndPunishment a :Theme,
        owl:NamedIndividual ;
    :description "Piety (εὐσέβεια) is affirmed yet entangled with punishment and accusations of impiety."^^xsd:string .

:Theme_PietyAndSuffering a :Theme,
        owl:NamedIndividual ;
    :description "Suffering is presented as the cost of honoring piety; the pious person endures punishment."^^xsd:string .

:Theme_PublicWitnessAndShame a :Theme,
        owl:NamedIndividual ;
    :description "Antigone calls on Thebes and its leaders to witness her being led away and her suffering."^^xsd:string .

:Theme_PunishmentForDelay a :Theme,
        owl:NamedIndividual ;
    :description "Delay in carrying out harsh action brings consequences and lamentation."^^xsd:string .

:Theme_ResolveToEnforceDecision a :Theme,
        owl:NamedIndividual ;
    :description "The ruler's determination that the decided course will be ratified and carried through."^^xsd:string .

:Theme_StatePowerAndControl a :Theme,
        owl:NamedIndividual ;
    :description "Civic authority asserts control through punishment and procedural distancing ('we are pure' yet she will be deprived of upper-world dwelling)."^^xsd:string .



# ===========================================================================
# MORAL DECISIONS
# ===========================================================================


:AntigoneDecision_AcceptBeingLed a :MoralDecision,
        owl:NamedIndividual ;
    :description "Antigone acknowledges she is being led away and will no longer delay, accepting the immediate course toward death."^^xsd:string ;
    :relatedTo :AntigoneMotivation_AffirmPietyBeforeDeath .

:AntigoneDecision_AcceptDeathAsAcheronBride a :MoralDecision,
        owl:NamedIndividual ;
    :description "Instead of marriage in a bridal chamber, she will be wedded to Acheron: she accepts her descent as a 'marriage' to the underworld."^^xsd:string ;
    :relatedTo :Theme_DeathAsMarriage .

:AntigoneDecision_PrioritizeBrotherOverPotentialHusbandOrChildren a :MoralDecision,
        owl:NamedIndividual ;
    :description "She declares she would not have taken such toil for a dead husband or for children, since those could be replaced, but not a brother once parents are in Hades."^^xsd:string ;
    :relatedTo :AntigoneMotivation_HonorPolyneicesWithBurialRites .

:ChorusFateEvent_MoiridiaPower a owl:NamedIndividual,
        owl:Thing ;
    :description "The Chorus asserts that a certain allotted power (μοιριδία δύνασις) is terrible and inescapable."^^xsd:string ;
    :relatedTo :Theme_InevitabilityOfFate .

:CreonDecision_ConfirmSentence a :MoralDecision,
        owl:NamedIndividual ;
    :description "Creon refuses to offer reassurance and insists the outcome will be confirmed as decided."^^xsd:string .

:CreonDecision_EntombAntigoneAlive a :MoralDecision,
        owl:NamedIndividual ;
    :description "He orders Antigone to be taken quickly and enclosed in a covered tomb, left solitary to die or live entombed."^^xsd:string ;
    :relatedTo :AntigoneEmotion_LamentAndIsolation .

:Event_AntigoneLedToLivingTomb a :MoralDecision,
        owl:NamedIndividual ;
    :description "Antigone is taken toward the 'τυμβόχωστον ἕργμα'—a tomb-like enclosure while alive."^^xsd:string ;
    :relatedTo :Theme_LivingDeathAndExile .


# ===========================================================================
# CONFLICTS
# ===========================================================================

:Conflict_AntigonePietyVsCreonAuthority a :Conflict,
        owl:NamedIndividual ;
    :conflictBetween :Antigone_Character_Antigone,
        :Antigone_Character_Creon,
        :EthicalPrinciple_CivicAuthority,
        :EthicalPrinciple_Piety ;
    :description "Opposition between Antigone's claim to piety (εὐσέβεια) and Creon's insistence on civic authority and the confirmed sentence."^^xsd:string .

:Conflict_AntigonePietyVsCreonDecree a :Conflict,
        owl:NamedIndividual ;
    :conflictBetween :Antigone_Character_Antigone,
        :Antigone_Character_Creon,
        :EthicalPrinciple_PietyTowardDeadAndFamily,
        :Law_CreonDecreeAgainstPolyneicesBurial ;
    :description "Opposition between Antigone's pious familial duty and Creon's civic decree/punishment."^^xsd:string .

:Conflict_AntigoneVsChorusOnDivineComparison a :Conflict,
        owl:NamedIndividual ;
    :conflictBetween :Antigone_Character_Antigone,
        :Antigone_Character_Chorus,
        :EthicalPrinciple_MortalHumilityBeforeGods ;
    :description "Antigone's self-comparison to Niobe and appeal to divine framing clashes with the Chorus' insistence on mortal humility and separation from the divine."^^xsd:string .

:Conflict_LifeVsDeathTransition a :Conflict,
        owl:NamedIndividual ;
    :conflictBetween :EthicalPrinciple_Life,
        :FateConcept_DeathInevitability ;
    :description "Ἀντίθεσις μεταξὺ τοῦ φέγγους ἡλίου (βίος) καὶ τοῦ παγκοίτου Ἅιδου/Ἀχέροντος (θάνατος), ὡς ἀναγκαστικὴ μετάβασις."^^xsd:string .

# ===========================================================================
# ETHICAL PRINCIPLES 
# ===========================================================================

:EthicalPrinciple_CivicAuthority a :EthicalPrinciple,
        owl:NamedIndividual ;
    :description "The ruler's authority and enforcement of civic order as a moral priority."^^xsd:string .

:EthicalPrinciple_Life a :EthicalPrinciple,
        owl:NamedIndividual ;
    :description "Ἀξία τοῦ ζῆν καὶ τοῦ ὁρᾶν τὸ φέγγος ἡλίου."^^xsd:string .

:EthicalPrinciple_MortalHumilityBeforeGods a :EthicalPrinciple,
        owl:NamedIndividual ;
    :description "Humans are mortal and must not claim equality with gods; divine status is separate from human fate."^^xsd:string .

:EthicalPrinciple_Piety a :EthicalPrinciple,
        owl:NamedIndividual ;
    :description "Reverence toward gods and ancestral/divine obligations (εὐσέβεια) as a guiding moral claim."^^xsd:string .

:EthicalPrinciple_PietyTowardDeadAndFamily a :EthicalPrinciple,
        owl:NamedIndividual ;
    :description "Eusebeia expressed as duty to the dead and to kin: burial, offerings, and honoring family even against civic judgment."^^xsd:string .

:EthicalPrinciple_RespectForAncestralGodsAndCity a :EthicalPrinciple,
        owl:NamedIndividual ;
    :description "Appeal to ancestral gods and the civic community as moral witnesses; insistence on being judged within sacred/civic frameworks."^^xsd:string .

:EthicalPrinciple_SubmissionToFate a :EthicalPrinciple,
        owl:NamedIndividual ;
    :description "Recognition that allotted destiny (μοῖρα) is inescapable and must be endured."^^xsd:string .

# ===========================================================================
# FATE
# ===========================================================================
:FateConcept_DeathInevitability a :FateConcept,
        owl:NamedIndividual ;
    :description "Inescapable descent toward Hades; death as necessity."^^xsd:string ;
    :determinesOutcomeOf :Conflict_LifeVsDeathTransition .

# ===========================================================================
# LAW
# ===========================================================================
:Law_CreonDecreeAgainstPolyneicesBurial a :Law,
        owl:NamedIndividual ;
    :description "Creon's civic prohibition/punitive stance regarding Polyneices' burial, implied by Antigone's claim that Creon judged her acts as wrongdoing."^^xsd:string .
