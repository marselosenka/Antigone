@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_04-translations-823-871-english a owl:Ontology .
# English translation variants extracted from 823_to_871.ttl

:TV_Line_823_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "I have heard how our Phrygian guest died a miserable death."^^xsd:string ;
    :relatedTo :Line_823 .

:TV_Line_825_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "the daughter of Tantalus, near lofty Mount Sipylus, whom a growth like clinging ivy"^^xsd:string ;
    :relatedTo :Line_825 .

:TV_Line_826_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "a growth of rock subdued; and, as she melts away, the rains"^^xsd:string ;
    :relatedTo :Line_826 .

:TV_Line_827_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "as the story goes,"^^xsd:string ;
    :relatedTo :Line_827 .

# Line 828 and 829 do not exist in Antigone.
:TV_Line_830_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "and snow never leave her; beneath her tearful brows she dampens"^^xsd:string ;
    :relatedTo :Line_830 .

:TV_Line_831_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "I am most like her, as the god leads me to my sleep."^^xsd:string ;
    :relatedTo :Line_831 .

# Line 832 and 833 do not exist in Antigone.

:TV_Line_834_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "Yet she was a goddess herself, and god-born,"^^xsd:string ;
    :relatedTo :Line_834 .

:TV_Line_835_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "while we are but mortals, born from mortals."^^xsd:string ;
    :relatedTo :Line_835 .

:TV_Line_836_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "Still, it is great for one in the throes of death to hear"^^xsd:string ;
    :relatedTo :Line_836 .

:TV_Line_837_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "that she has obtained the fortune of the gods,"^^xsd:string ;
    :relatedTo :Line_837 .

:TV_Line_838_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "both in life and in death."^^xsd:string ;
    :relatedTo :Line_838 .

:TV_Line_839_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "Oh, now you are mocking me! Why, by my father’s gods,"^^xsd:string ;
    :relatedTo :Line_839 .

:TV_Line_840_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "do you insult me to my face, before I have gone?"^^xsd:string ;
    :relatedTo :Line_840 .

:TV_Line_841_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "My city, and you, her wealthiest citizens, "^^xsd:string ;
    :relatedTo :Line_841 .

:TV_Line_842_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "ah, springs of Dirce,"^^xsd:string ;
    :relatedTo :Line_842 .

# Line 843 and 844 do not exist in Antigone
:TV_Line_845_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "and grove of Thebes of many chariots, you at least I can count on as witnesses,"^^xsd:string ;
    :relatedTo :Line_845 .

:TV_Line_846_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "how I go, unwept by my loved ones, and by what laws"^^xsd:string ;
    :relatedTo :Line_846 .

:TV_Line_847_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "to my rock-heaped prison, to my strange tomb."^^xsd:string ;
    :relatedTo :Line_847 .

# Line 848 and 849 do not exist in Antigone.

:TV_Line_850_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "I neither live among mortals nor shades, neither with the living nor the dead."^^xsd:string ;
    :relatedTo :Line_850 .

:TV_Line_851_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "I neither live among mortals nor shades, neither with the living nor the dead."^^xsd:string ;
    :relatedTo :Line_851 .

# Line 852 do not exist in Antigone.


:TV_Line_853_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "You rushed through the depths of recklessness"^^xsd:string ;
    :relatedTo :Line_853 .

:TV_Line_854_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "toward the high throne of Dike,"^^xsd:string ;
    :relatedTo :Line_854 .

:TV_Line_855_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "but you have fallen, oh child, fallen very far."^^xsd:string ;
    :relatedTo :Line_855 .

:TV_Line_856_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "Now you pay for your father’s crimes."^^xsd:string ;
    :relatedTo :Line_856 .

# Line 857 does not exist in Antigone.

:TV_Line_858_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "You have touched upon my most painful memory,"^^xsd:string ;
    :relatedTo :Line_858 .

:TV_Line_859_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "the thrice-told doom of my father and of all"^^xsd:string ;
    :relatedTo :Line_859 .

:TV_Line_860_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "our destiny, that of the famed Labdacids."^^xsd:string ;
    :relatedTo :Line_860 .

:TV_Line_861_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "Oh, our mother’s disaster of a marriage!"^^xsd:string ;
    :relatedTo :Line_861 .

# Lines 862,863 and 864 do not exist in Antigone.
:TV_Line_865_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "and my father’s incestuous intercourse with his ill-fated mother!"^^xsd:string ;
    :relatedTo :Line_865 .

:TV_Line_866_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "From such people I, the miserable one, was born!"^^xsd:string ;
    :relatedTo :Line_866 .

:TV_Line_867_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "I go to them to live, accursed, unmarried."^^xsd:string ;
    :relatedTo :Line_867 .

# Line 868 and 869 do not exist in Antigone.
:TV_Line_870_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "Ah, my brother, who secured an ill-fated marriage,"^^xsd:string ;
    :relatedTo :Line_870 .

:TV_Line_871_EN a owl:NamedIndividual, :TranslationVariant ;
    :text "in your death you have slain me while I am still alive."^^xsd:string ;
    :relatedTo :Line_871 .
