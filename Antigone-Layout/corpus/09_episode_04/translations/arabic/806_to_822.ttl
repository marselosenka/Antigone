@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_04-translations-806-822-arabic a owl:Ontology .
# Arabic translation variants for 806_to_822.ttl

:TV_Line_806_AR a :TranslationVariant ;
:text "انظروا إليّ، يا مواطني أرض الآباء، وأنا أسلك الطريق الأخيرة،"^^xsd:string ;
:relatedTo :Line_806 .

:TV_Line_807_AR a :TranslationVariant ;
:text "وأرى آخر ضوء للشمس،"^^xsd:string ;
:relatedTo :Line_807 .

# Line 808 and 809 do not exist in Antigone

:TV_Line_810_AR a :TranslationVariant ;
:text "ولن أراه بعدُ أبدًا؛ بل إن هاديس، الذي يضجع الجميع، يقودني حيةً"^^xsd:string ;
:relatedTo :Line_810 .

:TV_Line_811_AR a :TranslationVariant ;
:text "إلى شاطئ أخيرون،"^^xsd:string ;
:relatedTo :Line_811 .

:TV_Line_812_AR a :TranslationVariant ;
:text "ولستُ ذات نصيب في أناشيد الزواج، ولا عند مراسيم العرس،"^^xsd:string ;
:relatedTo :Line_812 .

# Line 813 and 814 do not exist in Antigone

:TV_Line_815_AR a :TranslationVariant ;
:text "لم ينشد لي أحد نشيدًا بعدُ؛ بل سأُزفّ عروسًا إلى أخيرون."^^xsd:string ;
:relatedTo :Line_815 .

# Line 816 does not exist in Antigone

:TV_Line_817_AR a :TranslationVariant ;
:text "أفلا ترحلين مشهورةً وحائزةً على المديح"^^xsd:string ;
:relatedTo :Line_817 .

:TV_Line_818_AR a :TranslationVariant ;
:text "إلى هذا الخفاء، مخبأ الموتى،"^^xsd:string ;
:relatedTo :Line_818 .

:TV_Line_819_AR a :TranslationVariant ;
:text "لا مضروبةً بأمراض مهلكة،"^^xsd:string ;
:relatedTo :Line_819 .

:TV_Line_820_AR a :TranslationVariant ;
:text "ولا نلتِ جزاء السيوف،"^^xsd:string ;
:relatedTo :Line_820 .

:TV_Line_821_AR a :TranslationVariant ;
:text "بل حيةً، مستقلةً بقانون نفسك، وحدك حقًا،"^^xsd:string ;
:relatedTo :Line_821 .

:TV_Line_822_AR a :TranslationVariant ;
:text "ستنزلين إلى هاديس، وحدك بين البشر."^^xsd:string ;
:relatedTo :Line_822 .
