# =========================================================================
# THEMES & CONFLICTS
# =========================================================================
:Theme_DivineLaw a :Theme ;
  :description "Antigone privileges unwritten divine law over royal decree."^^xsd:string .

:Theme_HumanLaw a :Theme ;
  :description "The laws and decrees established by human rulers and the state."^^xsd:string .

:Theme_FamilyDuty a :Theme ;
  :description "The obligation to honor and bury family members, especially siblings."^^xsd:string .

:Theme_Authority a :Theme ;
  :description "The exercise of power and control, and resistance to it."^^xsd:string .

:Theme_BurialRites a :Theme ;
  :description "The religious and cultural practices surrounding the burial of the dead."^^xsd:string .

:Conflict_DivineVsHumanLaw a :Conflict ;
  :description "Moral collision between divine ordinance and state decree."^^xsd:string .

:Conflict_AntigoneVsCreon a :Conflict ;
  :description "The central conflict between Antigone's duty to divine law and Creon's assertion of human authority."^^xsd:string ;
  :relatedTo :Conflict_DivineVsHumanLaw .

:Conflict_AntigoneVsIsmene a :Conflict ;
  :description "The tension between Antigone's active defiance and Ismene's initial passivity, later resolved by Ismene's desire to share the fate."^^xsd:string .


###############################################################################################
# THEMES  
###############################################################################################

:Theme_Justice
  a owl:NamedIndividual, :Theme ;
  :description "The concept of fairness, equality, and divine justice."^^xsd:string .

:Theme_Tyranny
  a owl:NamedIndividual, :Theme ;
  :description "The abuse of power and authority by a ruler."^^xsd:string .

:Theme_GenderRoles
  a owl:NamedIndividual, :Theme ;
  :description "Expectations and limitations placed on individuals based on gender."^^xsd:string .

:Theme_Sisterhood
  a owl:NamedIndividual, :Theme ;
  :description "The bond between sisters and the conflict between different approaches to the same situation."^^xsd:string .

:Theme_MoralCourage
  a owl:NamedIndividual, :Theme ;
  :description "The strength to act according to one's principles despite consequences."^^xsd:string .

:Theme_FamilyHeritage
  a owl:NamedIndividual, :Theme ;
  :description "The inheritance of character traits and fate from one's ancestors."^^xsd:string .

:Theme_CharacterTrait
  a owl:NamedIndividual, :Theme ;
  :description "Inherent qualities of character, including tragic flaws."^^xsd:string .

:Theme_Glory
  a owl:NamedIndividual, :Theme ;
  :description "The pursuit of honor and renown through noble actions."^^xsd:string .

:Theme_PublicOpinion
  a owl:NamedIndividual, :Theme ;
  :description "The views and judgments of the community, often suppressed by fear."^^xsd:string .

:Theme_Acceptance
  a owl:NamedIndividual, :Theme ;
  :description "The resignation to one's fate and acceptance of death."^^xsd:string .

:Theme_Death
  a owl:NamedIndividual, :Theme ;
  :description "Mortality, the afterlife, and the acceptance of death as preferable to dishonor."^^xsd:string .

:Theme_MortalLimitation
  a owl:NamedIndividual, :Theme ;
  :description "The boundaries of human power in relation to divine will."^^xsd:string .

:Theme_FamilyBond
  a owl:NamedIndividual, :Theme ;
  :description "The sacred connection between family members, protected by Zeus."^^xsd:string .

:Theme_Love
  a owl:NamedIndividual, :Theme ;
  :description "The bond of love between siblings and family members."^^xsd:string .

:Theme_Marriage
  a owl:NamedIndividual, :Theme ;
  :description "The institution of marriage and its disruption by death."^^xsd:string .

:Theme_TragicFlaw
  a owl:NamedIndividual, :Theme ;
  :description "The character defect that leads to a hero's downfall."^^xsd:string .

:Theme_Foreshadowing
  a owl:NamedIndividual, :Theme ;
  :description "The anticipation of future events, particularly death."^^xsd:string .

:Theme_Defiance
  a owl:NamedIndividual, :Theme ;
  :description "Bold resistance to authority and unjust laws."^^xsd:string .

:Theme_Choice
  a owl:NamedIndividual, :Theme ;
  :description "The fundamental choice between life and death, honor and dishonor."^^xsd:string .

:Theme_ProverbialWisdom
  a owl:NamedIndividual, :Theme ;
  :description "A gnomic statement or proverb expressing general truth."^^xsd:string .

:Theme_Surprise
  a owl:NamedIndividual, :Theme ;
  :description "The emotion of astonishment or shock at unexpected events."^^xsd:string .

:Theme_Disbelief
  a owl:NamedIndividual, :Theme ;
