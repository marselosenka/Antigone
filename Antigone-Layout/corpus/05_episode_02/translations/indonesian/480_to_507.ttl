@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_02-translations-480-507-indonesian a owl:Ontology .
# Indonesian translation variants for 480_to_507.ttl

:TV_Line_480_ID a :TranslationVariant ;
:text "Dia ini tahu benar bagaimana berlaku kurang ajar saat itu,"^^xsd:string ;
:relatedTo :Line_480 .

:TV_Line_481_ID a :TranslationVariant ;
:text "ketika melanggar hukum-hukum yang telah ditetapkan;"^^xsd:string ;
:relatedTo :Line_481 .

:TV_Line_482_ID a :TranslationVariant ;
:text "dan sesudah ia melakukannya, inilah keangkuhan kedua:"^^xsd:string ;
:relatedTo :Line_482 .

:TV_Line_483_ID a :TranslationVariant ;
:text "bermegah atas hal-hal itu dan tertawa setelah melakukannya."^^xsd:string ;
:relatedTo :Line_483 .

:TV_Line_484_ID a :TranslationVariant ;
:text "Sungguh sekarang aku bukan lelaki, dan dia inilah lelaki,"^^xsd:string ;
:relatedTo :Line_484 .

:TV_Line_485_ID a :TranslationVariant ;
:text "jika kuasa ini akan terbaring padanya tanpa hukuman."^^xsd:string ;
:relatedTo :Line_485 .

:TV_Line_486_ID a :TranslationVariant ;
:text "Tetapi entah ia anak saudari, entah lebih sedarah"^^xsd:string ;
:relatedTo :Line_486 .

:TV_Line_487_ID a :TranslationVariant ;
:text "daripada semua yang menyembah Zeus pelindung rumah kami,"^^xsd:string ;
:relatedTo :Line_487 .

:TV_Line_488_ID a :TranslationVariant ;
:text "dia sendiri dan saudari sedarahnya tidak akan lolos"^^xsd:string ;
:relatedTo :Line_488 .

:TV_Line_489_ID a :TranslationVariant ;
:text "dari nasib mati yang paling buruk; sebab yang satu itu juga sama"^^xsd:string ;
:relatedTo :Line_489 .

:TV_Line_490_ID a :TranslationVariant ;
:text "kutuduh ikut merencanakan penguburan ini."^^xsd:string ;
:relatedTo :Line_490 .

:TV_Line_491_ID a :TranslationVariant ;
:text "Panggillah dia; sebab baru saja aku melihatnya di dalam"^^xsd:string ;
:relatedTo :Line_491 .

:TV_Line_492_ID a :TranslationVariant ;
:text "mengamuk dan tidak menguasai pikirannya."^^xsd:string ;
:relatedTo :Line_492 .

:TV_Line_493_ID a :TranslationVariant ;
:text "Hati pencuri biasanya tertangkap terlebih dahulu"^^xsd:string ;
:relatedTo :Line_493 .

:TV_Line_494_ID a :TranslationVariant ;
:text "dari mereka yang merancang sesuatu secara tidak benar dalam gelap;"^^xsd:string ;
:relatedTo :Line_494 .

:TV_Line_495_ID a :TranslationVariant ;
:text "namun aku sungguh membenci ketika seseorang tertangkap dalam bencana,"^^xsd:string ;
:relatedTo :Line_495 .

:TV_Line_496_ID a :TranslationVariant ;
:text "lalu ingin memperindah perbuatan itu."^^xsd:string ;
:relatedTo :Line_496 .

:TV_Line_497_ID a :TranslationVariant ;
:text "Apakah kau menginginkan sesuatu yang lebih besar daripada menangkap dan membunuhku?"^^xsd:string ;
:relatedTo :Line_497 .

:TV_Line_498_ID a :TranslationVariant ;
:text "Aku tidak menginginkan apa pun; dengan memiliki ini, aku memiliki semuanya."^^xsd:string ;
:relatedTo :Line_498 .

:TV_Line_499_ID a :TranslationVariant ;
:text "Lalu mengapa menunda? Sebab bagiku dari perkataanmu"^^xsd:string ;
:relatedTo :Line_499 .

:TV_Line_500_ID a :TranslationVariant ;
:text "tidak ada yang menyenangkan, dan semoga tidak pernah menyenangkan;"^^xsd:string ;
:relatedTo :Line_500 .

:TV_Line_501_ID a :TranslationVariant ;
:text "demikian pula kata-kataku lahir tidak menyenangkan bagimu."^^xsd:string ;
:relatedTo :Line_501 .

:TV_Line_502_ID a :TranslationVariant ;
:text "Namun dari mana aku dapat memperoleh kemuliaan yang lebih mulia"^^xsd:string ;
:relatedTo :Line_502 .

:TV_Line_503_ID a :TranslationVariant ;
:text "daripada dengan menaruh saudara sekandungku dalam makam?"^^xsd:string ;
:relatedTo :Line_503 .

:TV_Line_504_ID a :TranslationVariant ;
:text "Semua orang ini akan mengatakan bahwa hal ini menyenangkan mereka,"^^xsd:string ;
:relatedTo :Line_504 .

:TV_Line_505_ID a :TranslationVariant ;
:text "jika rasa takut tidak mengunci lidah mereka."^^xsd:string ;
:relatedTo :Line_505 .

:TV_Line_506_ID a :TranslationVariant ;
:text "Tetapi tirani berbahagia dalam banyak hal lain,"^^xsd:string ;
:relatedTo :Line_506 .

:TV_Line_507_ID a :TranslationVariant ;
:text "dan baginya boleh melakukan dan mengatakan apa yang dikehendaki."^^xsd:string ;
:relatedTo :Line_507 .
