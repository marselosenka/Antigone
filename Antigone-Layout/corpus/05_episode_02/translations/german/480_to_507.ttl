@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_02-translations-480-507-german a owl:Ontology .
# German translation variants for 480_to_507.ttl

:TV_Line_480_DE a :TranslationVariant ;
:text "Diese verstand schon damals, frevelhaft zu handeln,"^^xsd:string ;
:relatedTo :Line_480 .

:TV_Line_481_DE a :TranslationVariant ;
:text "als sie die vorgelegten Gesetze überschritt;"^^xsd:string ;
:relatedTo :Line_481 .

:TV_Line_482_DE a :TranslationVariant ;
:text "Frevel aber, nachdem sie gehandelt hat, ist dies als zweiter:"^^xsd:string ;
:relatedTo :Line_482 .

:TV_Line_483_DE a :TranslationVariant ;
:text "sich dessen zu rühmen und lachend dazustehen, nachdem sie es getan hat."^^xsd:string ;
:relatedTo :Line_483 .

:TV_Line_484_DE a :TranslationVariant ;
:text "Wahrlich, nun bin ich kein Mann, sie aber ist der Mann,"^^xsd:string ;
:relatedTo :Line_484 .

:TV_Line_485_DE a :TranslationVariant ;
:text "wenn diese Macht ihr straflos liegen bleibt."^^xsd:string ;
:relatedTo :Line_485 .

:TV_Line_486_DE a :TranslationVariant ;
:text "Doch sei sie nun meiner Schwester Kind oder blutsnäher"^^xsd:string ;
:relatedTo :Line_486 .

:TV_Line_487_DE a :TranslationVariant ;
:text "als der ganze Zeus des Herdes für uns umfasst,"^^xsd:string ;
:relatedTo :Line_487 .

:TV_Line_488_DE a :TranslationVariant ;
:text "sie selbst und die blutsverwandte werden nicht entkommen"^^xsd:string ;
:relatedTo :Line_488 .

:TV_Line_489_DE a :TranslationVariant ;
:text "dem schlimmsten Tod; denn auch jene gleichermaßen"^^xsd:string ;
:relatedTo :Line_489 .

:TV_Line_490_DE a :TranslationVariant ;
:text "beschuldige ich, dieses Begräbnis geplant zu haben."^^xsd:string ;
:relatedTo :Line_490 .

:TV_Line_491_DE a :TranslationVariant ;
:text "Und ruft sie; denn drinnen sah ich sie eben"^^xsd:string ;
:relatedTo :Line_491 .

:TV_Line_492_DE a :TranslationVariant ;
:text "rasend und nicht im Besitz ihres Verstandes."^^xsd:string ;
:relatedTo :Line_492 .

:TV_Line_493_DE a :TranslationVariant ;
:text "Der Sinn pflegt vorher als Dieb ertappt zu sein"^^xsd:string ;
:relatedTo :Line_493 .

:TV_Line_494_DE a :TranslationVariant ;
:text "bei denen, die nichts Rechtes im Dunkel aushecken;"^^xsd:string ;
:relatedTo :Line_494 .

:TV_Line_495_DE a :TranslationVariant ;
:text "doch ich hasse gewiss auch, wenn in Übeln jemand,"^^xsd:string ;
:relatedTo :Line_495 .

:TV_Line_496_DE a :TranslationVariant ;
:text "ertappt, danach dieses schönmachen will."^^xsd:string ;
:relatedTo :Line_496 .

:TV_Line_497_DE a :TranslationVariant ;
:text "Willst du etwas Größeres, als mich zu greifen und zu töten?"^^xsd:string ;
:relatedTo :Line_497 .

:TV_Line_498_DE a :TranslationVariant ;
:text "Ich nichts; wenn ich dies habe, habe ich alles."^^xsd:string ;
:relatedTo :Line_498 .

:TV_Line_499_DE a :TranslationVariant ;
:text "Was zögerst du denn? Denn mir ist von deinen Worten"^^xsd:string ;
:relatedTo :Line_499 .

:TV_Line_500_DE a :TranslationVariant ;
:text "nichts angenehm, und möge es niemals angenehm sein;"^^xsd:string ;
:relatedTo :Line_500 .

:TV_Line_501_DE a :TranslationVariant ;
:text "so sind auch dir die meinen von Natur missfallend."^^xsd:string ;
:relatedTo :Line_501 .

:TV_Line_502_DE a :TranslationVariant ;
:text "Und doch, woher hätte ich ruhmvolleren Ruhm"^^xsd:string ;
:relatedTo :Line_502 .

:TV_Line_503_DE a :TranslationVariant ;
:text "erlangt, als indem ich den leiblichen Bruder im Grab"^^xsd:string ;
:relatedTo :Line_503 .

:TV_Line_504_DE a :TranslationVariant ;
:text "niederlegte? Allen diesen würde dies gefallen,"^^xsd:string ;
:relatedTo :Line_504 .

:TV_Line_505_DE a :TranslationVariant ;
:text "würden sie sagen, wenn Furcht die Zunge nicht verschlösse."^^xsd:string ;
:relatedTo :Line_505 .

:TV_Line_506_DE a :TranslationVariant ;
:text "Doch die Tyrannis ist in vielem anderen glücklich,"^^xsd:string ;
:relatedTo :Line_506 .

:TV_Line_507_DE a :TranslationVariant ;
:text "und es ist ihr erlaubt, zu tun und zu sagen, was sie will."^^xsd:string ;
:relatedTo :Line_507 .
