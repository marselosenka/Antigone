@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_02-translations-480-507-japanese a owl:Ontology .
# Japanese translation variants for 480_to_507.ttl

:TV_Line_480_JA a :TranslationVariant ;
:text "この女はその時、傲慢であることをよく知っていた、"^^xsd:string ;
:relatedTo :Line_480 .

:TV_Line_481_JA a :TranslationVariant ;
:text "定められた法を踏み越えた時に。"^^xsd:string ;
:relatedTo :Line_481 .

:TV_Line_482_JA a :TranslationVariant ;
:text "そして行った後の傲慢、これが第二の傲慢だ、"^^xsd:string ;
:relatedTo :Line_482 .

:TV_Line_483_JA a :TranslationVariant ;
:text "それらを誇り、行った者として笑うことが。"^^xsd:string ;
:relatedTo :Line_483 .

:TV_Line_484_JA a :TranslationVariant ;
:text "今や私が男ではなく、この女が男なのだろう、"^^xsd:string ;
:relatedTo :Line_484 .

:TV_Line_485_JA a :TranslationVariant ;
:text "もしこの権力が罰なしに彼女のものとして置かれるなら。"^^xsd:string ;
:relatedTo :Line_485 .

:TV_Line_486_JA a :TranslationVariant ;
:text "だが、彼女が姉妹の娘であろうと、あるいは私たちの"^^xsd:string ;
:relatedTo :Line_486 .

:TV_Line_487_JA a :TranslationVariant ;
:text "家のゼウス全体に、さらに血の近い者であろうと、"^^xsd:string ;
:relatedTo :Line_487 .

:TV_Line_488_JA a :TranslationVariant ;
:text "彼女自身も、同じ血を持つ女も、逃れはしない、"^^xsd:string ;
:relatedTo :Line_488 .

:TV_Line_489_JA a :TranslationVariant ;
:text "最悪の死の運命から。というのも、あの女にも同じく"^^xsd:string ;
:relatedTo :Line_489 .

:TV_Line_490_JA a :TranslationVariant ;
:text "この埋葬を計画した責めを負わせるからだ。"^^xsd:string ;
:relatedTo :Line_490 .

:TV_Line_491_JA a :TranslationVariant ;
:text "彼女を呼べ。中で私はたった今見た、"^^xsd:string ;
:relatedTo :Line_491 .

:TV_Line_492_JA a :TranslationVariant ;
:text "彼女が狂い、自分の思考を支配できていないのを。"^^xsd:string ;
:relatedTo :Line_492 .

:TV_Line_493_JA a :TranslationVariant ;
:text "心は以前から好むものだ、闇の中で"^^xsd:string ;
:relatedTo :Line_493 .

:TV_Line_494_JA a :TranslationVariant ;
:text "正しくない技をめぐらす者たちの盗人として捕らえられることを。"^^xsd:string ;
:relatedTo :Line_494 .

:TV_Line_495_JA a :TranslationVariant ;
:text "しかし私は憎む、災いの中で誰かが"^^xsd:string ;
:relatedTo :Line_495 .

:TV_Line_496_JA a :TranslationVariant ;
:text "捕らえられた後、そのことを美しく飾ろうとする時も。"^^xsd:string ;
:relatedTo :Line_496 .

:TV_Line_497_JA a :TranslationVariant ;
:text "私を捕らえて殺すことより大きな何かを望むのですか。"^^xsd:string ;
:relatedTo :Line_497 .

:TV_Line_498_JA a :TranslationVariant ;
:text "私は何も望まぬ。これを得れば、すべてを得ている。"^^xsd:string ;
:relatedTo :Line_498 .

:TV_Line_499_JA a :TranslationVariant ;
:text "ではなぜ遅らせるのですか。私にはあなたの言葉のうち"^^xsd:string ;
:relatedTo :Line_499 .

:TV_Line_500_JA a :TranslationVariant ;
:text "喜ばしいものは何もなく、これからも決して喜ばしくありません。"^^xsd:string ;
:relatedTo :Line_500 .

:TV_Line_501_JA a :TranslationVariant ;
:text "同じように、私の言葉もあなたに不快なものとして生まれついています。"^^xsd:string ;
:relatedTo :Line_501 .

:TV_Line_502_JA a :TranslationVariant ;
:text "それでも、どこから私がより名高い名声を"^^xsd:string ;
:relatedTo :Line_502 .

:TV_Line_503_JA a :TranslationVariant ;
:text "得られたでしょうか、実の兄弟を墓に"^^xsd:string ;
:relatedTo :Line_503 .

:TV_Line_504_JA a :TranslationVariant ;
:text "置くことよりも。恐れが舌を閉じ込めていなければ、"^^xsd:string ;
:relatedTo :Line_504 .

:TV_Line_505_JA a :TranslationVariant ;
:text "これらの者すべてがこれを喜ぶと言われるでしょう。"^^xsd:string ;
:relatedTo :Line_505 .

:TV_Line_506_JA a :TranslationVariant ;
:text "しかし僭主の支配は、他の多くの点でも幸福であり、"^^xsd:string ;
:relatedTo :Line_506 .

:TV_Line_507_JA a :TranslationVariant ;
:text "自分の望むことを行い、語ることが許されているのです。"^^xsd:string ;
:relatedTo :Line_507 .
