@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_02-translations-480-507-persian a owl:Ontology .
# Persian translation variants for 480_to_507.ttl

:TV_Line_480_FA a :TranslationVariant ;
:text "این زن آن زمان خوب می‌دانست چگونه گستاخی کند،"^^xsd:string ;
:relatedTo :Line_480 .

:TV_Line_481_FA a :TranslationVariant ;
:text "وقتی از قانون‌های نهاده‌شده فراتر می‌رفت؛"^^xsd:string ;
:relatedTo :Line_481 .

:TV_Line_482_FA a :TranslationVariant ;
:text "و پس از آن‌که انجام داده است، این گستاخیِ دوم است،"^^xsd:string ;
:relatedTo :Line_482 .

:TV_Line_483_FA a :TranslationVariant ;
:text "که به این کارها فخر کند و پس از انجام دادن بخندد."^^xsd:string ;
:relatedTo :Line_483 .

:TV_Line_484_FA a :TranslationVariant ;
:text "به‌راستی اکنون من مرد نیستم و این زن مرد است،"^^xsd:string ;
:relatedTo :Line_484 .

:TV_Line_485_FA a :TranslationVariant ;
:text "اگر این قدرت‌ها بی‌کیفر نزد او بماند."^^xsd:string ;
:relatedTo :Line_485 .

:TV_Line_486_FA a :TranslationVariant ;
:text "اما خواه دختر خواهرم باشد، خواه از همه خون خویشان"^^xsd:string ;
:relatedTo :Line_486 .

:TV_Line_487_FA a :TranslationVariant ;
:text "در خانه زئوسِ نگهبان خانگی به ما نزدیک‌تر باشد،"^^xsd:string ;
:relatedTo :Line_487 .

:TV_Line_488_FA a :TranslationVariant ;
:text "خود او و هم‌خونش از بدترین"^^xsd:string ;
:relatedTo :Line_488 .

:TV_Line_489_FA a :TranslationVariant ;
:text "سرنوشت نخواهند گریخت؛ زیرا آن یکی را نیز به همان اندازه"^^xsd:string ;
:relatedTo :Line_489 .

:TV_Line_490_FA a :TranslationVariant ;
:text "متهم می‌کنم که در این دفن هم‌رأی بوده است."^^xsd:string ;
:relatedTo :Line_490 .

:TV_Line_491_FA a :TranslationVariant ;
:text "او را نیز فراخوانید؛ زیرا همین دم درون خانه"^^xsd:string ;
:relatedTo :Line_491 .

:TV_Line_492_FA a :TranslationVariant ;
:text "دیدمش که دیوانه‌وار می‌تاخت و بر عقل خود دسترس نداشت."^^xsd:string ;
:relatedTo :Line_492 .

:TV_Line_493_FA a :TranslationVariant ;
:text "دل پیش از آن دوست دارد که دزدِ"^^xsd:string ;
:relatedTo :Line_493 .

:TV_Line_494_FA a :TranslationVariant ;
:text "کارهایی که در تاریکی درست ساخته نشده‌اند، گرفتار شود؛"^^xsd:string ;
:relatedTo :Line_494 .

:TV_Line_495_FA a :TranslationVariant ;
:text "اما به‌راستی نفرت دارم وقتی کسی در بدی‌ها"^^xsd:string ;
:relatedTo :Line_495 .

:TV_Line_496_FA a :TranslationVariant ;
:text "گرفتار شود و سپس بخواهد همان را زیبا جلوه دهد."^^xsd:string ;
:relatedTo :Line_496 .

:TV_Line_497_FA a :TranslationVariant ;
:text "آیا چیزی بزرگ‌تر از این می‌خواهی که مرا گرفته و بکشی؟"^^xsd:string ;
:relatedTo :Line_497 .

:TV_Line_498_FA a :TranslationVariant ;
:text "من هیچ چیز؛ با داشتن این، همه چیز را دارم."^^xsd:string ;
:relatedTo :Line_498 .

:TV_Line_499_FA a :TranslationVariant ;
:text "پس چرا درنگ می‌کنی؟ زیرا از سخنان تو برای من"^^xsd:string ;
:relatedTo :Line_499 .

:TV_Line_500_FA a :TranslationVariant ;
:text "هیچ چیز خوشایند نیست و هرگز خوشایند مباد؛"^^xsd:string ;
:relatedTo :Line_500 .

:TV_Line_501_FA a :TranslationVariant ;
:text "همین‌گونه نیز سخنان من طبعاً برای تو ناخوشایندند."^^xsd:string ;
:relatedTo :Line_501 .

:TV_Line_502_FA a :TranslationVariant ;
:text "با این همه، از کجا می‌توانستم آوازه‌ای باشکوه‌تر"^^xsd:string ;
:relatedTo :Line_502 .

:TV_Line_503_FA a :TranslationVariant ;
:text "به دست آورم، جز از آن‌که برادر هم‌خون خود را در گور"^^xsd:string ;
:relatedTo :Line_503 .

:TV_Line_504_FA a :TranslationVariant ;
:text "بگذارم؟ گفته می‌شد که این کار برای همه اینان خوشایند است،"^^xsd:string ;
:relatedTo :Line_504 .

:TV_Line_505_FA a :TranslationVariant ;
:text "اگر ترس زبانشان را قفل نمی‌کرد."^^xsd:string ;
:relatedTo :Line_505 .

:TV_Line_506_FA a :TranslationVariant ;
:text "اما فرمانروایی خودکامه در بسیاری چیزهای دیگر نیز خوشبخت است،"^^xsd:string ;
:relatedTo :Line_506 .

:TV_Line_507_FA a :TranslationVariant ;
:text "و برایش رواست هر چه می‌خواهد انجام دهد و بگوید."^^xsd:string ;
:relatedTo :Line_507 .
