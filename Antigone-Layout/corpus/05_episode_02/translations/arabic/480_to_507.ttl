@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_02-translations-480-507-arabic a owl:Ontology .
# Arabic translation variants for 480_to_507.ttl

:TV_Line_480_AR a :TranslationVariant ;
:text "أما هذه فكانت تعرف جيدًا أن تتكبر حينئذٍ،"^^xsd:string ;
:relatedTo :Line_480 .

:TV_Line_481_AR a :TranslationVariant ;
:text "متجاوزة القوانين الموضوعة أمامها؛"^^xsd:string ;
:relatedTo :Line_481 .

:TV_Line_482_AR a :TranslationVariant ;
:text "وهذا تكبر ثانٍ، بعدما فعلت،"^^xsd:string ;
:relatedTo :Line_482 .

:TV_Line_483_AR a :TranslationVariant ;
:text "أن تتفاخر بهذه الأمور وتضحك لأنها فعلت."^^xsd:string ;
:relatedTo :Line_483 .

:TV_Line_484_AR a :TranslationVariant ;
:text "إذن الآن لست أنا رجلًا، بل هي الرجل،"^^xsd:string ;
:relatedTo :Line_484 .

:TV_Line_485_AR a :TranslationVariant ;
:text "إن استقرت هذه السلطة لها بلا عقاب."^^xsd:string ;
:relatedTo :Line_485 .

:TV_Line_486_AR a :TranslationVariant ;
:text "لكن سواء كانت ابنة أختي، أم أقرب بالدم"^^xsd:string ;
:relatedTo :Line_486 .

:TV_Line_487_AR a :TranslationVariant ;
:text "من كل زيوس حارس بيتنا،"^^xsd:string ;
:relatedTo :Line_487 .

:TV_Line_488_AR a :TranslationVariant ;
:text "فلن تنجو هي وقريبتها بالدم"^^xsd:string ;
:relatedTo :Line_488 .

:TV_Line_489_AR a :TranslationVariant ;
:text "من شر مصير؛ فإني أتهم تلك أيضًا"^^xsd:string ;
:relatedTo :Line_489 .

:TV_Line_490_AR a :TranslationVariant ;
:text "بالقدر نفسه أنها دبرت هذا الدفن."^^xsd:string ;
:relatedTo :Line_490 .

:TV_Line_491_AR a :TranslationVariant ;
:text "فنادوها؛ فقد رأيتها الآن في الداخل"^^xsd:string ;
:relatedTo :Line_491 .

:TV_Line_492_AR a :TranslationVariant ;
:text "مجنونة، غير مالكة لعقلها."^^xsd:string ;
:relatedTo :Line_492 .

:TV_Line_493_AR a :TranslationVariant ;
:text "والنفس تحب قبل ذلك أن تُمسك كاللص"^^xsd:string ;
:relatedTo :Line_493 .

:TV_Line_494_AR a :TranslationVariant ;
:text "لمن يحيكون في الظلام ما ليس مستقيمًا؛"^^xsd:string ;
:relatedTo :Line_494 .

:TV_Line_495_AR a :TranslationVariant ;
:text "وأكره أيضًا حين يقع أحد في الشرور"^^xsd:string ;
:relatedTo :Line_495 .

:TV_Line_496_AR a :TranslationVariant ;
:text "ثم يريد أن يجمّل هذا الفعل."^^xsd:string ;
:relatedTo :Line_496 .

:TV_Line_497_AR a :TranslationVariant ;
:text "أتريد شيئًا أعظم من أن تقتلني وقد أخذتني؟"^^xsd:string ;
:relatedTo :Line_497 .

:TV_Line_498_AR a :TranslationVariant ;
:text "أنا لا أريد شيئًا؛ وإذ عندي هذا، فعندي كل شيء."^^xsd:string ;
:relatedTo :Line_498 .

:TV_Line_499_AR a :TranslationVariant ;
:text "فلمَ تتأخر إذن؟ إذ ليس من أقوالك عندي"^^xsd:string ;
:relatedTo :Line_499 .

:TV_Line_500_AR a :TranslationVariant ;
:text "شيء مرضي، ولا ليكن مرضيًا أبدًا؛"^^xsd:string ;
:relatedTo :Line_500 .

:TV_Line_501_AR a :TranslationVariant ;
:text "وكذلك وُلدت أقوالي غير محببة لك."^^xsd:string ;
:relatedTo :Line_501 .

:TV_Line_502_AR a :TranslationVariant ;
:text "ومع ذلك، من أين كنت أنال مجدًا أمجد"^^xsd:string ;
:relatedTo :Line_502 .

:TV_Line_503_AR a :TranslationVariant ;
:text "من أن أضع أخي الشقيق في قبر؟"^^xsd:string ;
:relatedTo :Line_503 .

:TV_Line_504_AR a :TranslationVariant ;
:text "إن هذا يرضي هؤلاء جميعًا،"^^xsd:string ;
:relatedTo :Line_504 .

:TV_Line_505_AR a :TranslationVariant ;
:text "لقيل ذلك، لو لم يغلق الخوف ألسنتهم."^^xsd:string ;
:relatedTo :Line_505 .

:TV_Line_506_AR a :TranslationVariant ;
:text "لكن الطغيان سعيد في أمور كثيرة أخرى،"^^xsd:string ;
:relatedTo :Line_506 .

:TV_Line_507_AR a :TranslationVariant ;
:text "ويجوز له أن يفعل ويقول ما يريد."^^xsd:string ;
:relatedTo :Line_507 .
