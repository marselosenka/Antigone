:episode_01-translations-324-330-german a owl:Ontology .
# German translation variants for 324_to_330.ttl

:TV_Line_324_DE a :TranslationVariant ;
:text "Verfeinere nun deine Meinung; wenn ihr mir aber diese"^^xsd:string ;
:relatedTo :Line_324 .

:TV_Line_325_DE a :TranslationVariant ;
:text "Täter nicht sichtbar macht, werdet ihr sagen,"^^xsd:string ;
:relatedTo :Line_325 .

:TV_Line_326_DE a :TranslationVariant ;
:text "dass feige Gewinne Unheil bewirken."^^xsd:string ;
:relatedTo :Line_326 .

:TV_Line_327_DE a :TranslationVariant ;
:text "Möge er vor allem gefunden werden; wenn er aber"^^xsd:string ;
:relatedTo :Line_327 .

:TV_Line_328_DE a :TranslationVariant ;
:text "gefasst wird oder nicht, denn dies wird das Geschick entscheiden,"^^xsd:string ;
:relatedTo :Line_328 .

:TV_Line_329_DE a :TranslationVariant ;
:text "gibt es keine Weise, dass du mich wieder hierher kommen siehst."^^xsd:string ;
:relatedTo :Line_329 .

:TV_Line_330_DE a :TranslationVariant ;
:text "Denn auch jetzt, außer meiner Hoffnung und meiner Meinung,"^^xsd:string ;
:relatedTo :Line_330 .
