:episode_01-translations-324-330-russian a owl:Ontology .
# Russian translation variants for 324_to_330.ttl

:TV_Line_324_RU a :TranslationVariant ;
:text "Итак, украшай мнение; но если вы мне этих"^^xsd:string ;
:relatedTo :Line_324 .

:TV_Line_325_RU a :TranslationVariant ;
:text "совершителей не покажете, вы скажете,"^^xsd:string ;
:relatedTo :Line_325 .

:TV_Line_326_RU a :TranslationVariant ;
:text "что трусливые прибыли производят бедствия."^^xsd:string ;
:relatedTo :Line_326 .

:TV_Line_327_RU a :TranslationVariant ;
:text "Но пусть он будет найден, лучше всего; а если"^^xsd:string ;
:relatedTo :Line_327 .

:TV_Line_328_RU a :TranslationVariant ;
:text "будет пойман или нет, это ведь решит судьба,"^^xsd:string ;
:relatedTo :Line_328 .

:TV_Line_329_RU a :TranslationVariant ;
:text "никак ты не увидишь меня снова пришедшим сюда."^^xsd:string ;
:relatedTo :Line_329 .

:TV_Line_330_RU a :TranslationVariant ;
:text "Ибо и теперь сверх надежды и моего мнения"^^xsd:string ;
:relatedTo :Line_330 .
