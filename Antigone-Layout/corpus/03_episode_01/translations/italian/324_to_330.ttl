# Italian translation variants for 324_to_330.ttl

:TV_Line_324_IT a :TranslationVariant ;
:text "Raffina dunque la tua opinione; ma se queste cose non"^^xsd:string ;
:relatedTo :Line_324 .

:TV_Line_325_IT a :TranslationVariant ;
:text "mi mostrerete, coloro che agiscono, direte che"^^xsd:string ;
:relatedTo :Line_325 .

:TV_Line_326_IT a :TranslationVariant ;
:text "i guadagni vili producono sciagure."^^xsd:string ;
:relatedTo :Line_326 .

:TV_Line_327_IT a :TranslationVariant ;
:text "Ma sia trovato soprattutto; se però"^^xsd:string ;
:relatedTo :Line_327 .

:TV_Line_328_IT a :TranslationVariant ;
:text "sarà preso o no, questo infatti lo giudicherà la sorte,"^^xsd:string ;
:relatedTo :Line_328 .

:TV_Line_329_IT a :TranslationVariant ;
:text "non c'è modo che tu mi veda venire qui."^^xsd:string ;
:relatedTo :Line_329 .

:TV_Line_330_IT a :TranslationVariant ;
:text "E infatti ora, fuori dalla mia speranza e dal mio giudizio,"^^xsd:string ;
