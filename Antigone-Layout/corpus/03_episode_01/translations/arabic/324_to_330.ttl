:episode_01-translations-324-330-arabic a owl:Ontology .
# Arabic translation variants for 324_to_330.ttl

:TV_Line_324_AR a :TranslationVariant ;
:text "زخرف الآن رأيك؛ أما إن لم"^^xsd:string ;
:relatedTo :Line_324 .

:TV_Line_325_AR a :TranslationVariant ;
:text "تظهروا لي فاعلي هذه الأمور، فستقولون إن"^^xsd:string ;
:relatedTo :Line_325 .

:TV_Line_326_AR a :TranslationVariant ;
:text "الأرباح الجبانة تصنع المصائب."^^xsd:string ;
:relatedTo :Line_326 .

:TV_Line_327_AR a :TranslationVariant ;
:text "ليت الفاعل يُوجد خاصة؛ أما إن"^^xsd:string ;
:relatedTo :Line_327 .

:TV_Line_328_AR a :TranslationVariant ;
:text "أُخذ أم لا، فهذا ستحكمه الصدفة،"^^xsd:string ;
:relatedTo :Line_328 .

:TV_Line_329_AR a :TranslationVariant ;
:text "فلن يكون هناك وجه لأن تراني آتي إلى هنا."^^xsd:string ;
:relatedTo :Line_329 .

:TV_Line_330_AR a :TranslationVariant ;
:text "فحتى الآن، خارج أملي ورأيي،"^^xsd:string ;
:relatedTo :Line_330 .
