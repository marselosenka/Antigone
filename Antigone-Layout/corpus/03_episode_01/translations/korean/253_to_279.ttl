@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_01-translations-253-279-korean a owl:Ontology .
# Korean translation variants for 253_to_279.ttl

:TV_Line_253_KO a :TranslationVariant ;
:text "첫 낮 감시자가 우리에게 그것을 보여 주었을 때,"^^xsd:string ;
:relatedTo :Line_253 .

:TV_Line_254_KO a :TranslationVariant ;
:text "모두에게 견디기 어려운 놀라움이 있었습니다."^^xsd:string ;
:relatedTo :Line_254 .

:TV_Line_255_KO a :TranslationVariant ;
:text "그는 사라져 있었습니다. 무덤에 묻힌 것은 아니었고,"^^xsd:string ;
:relatedTo :Line_255 .

:TV_Line_256_KO a :TranslationVariant ;
:text "다만 얇은 먼지가, 부정을 피하려는 사람처럼, 그 위에 있었습니다."^^xsd:string ;
:relatedTo :Line_256 .

:TV_Line_257_KO a :TranslationVariant ;
:text "짐승도, 어떤 개도 온"^^xsd:string ;
:relatedTo :Line_257 .

:TV_Line_258_KO a :TranslationVariant ;
:text "흔적이나 찢은 흔적은 드러나지 않았습니다."^^xsd:string ;
:relatedTo :Line_258 .

:TV_Line_259_KO a :TranslationVariant ;
:text "서로 사이에 나쁜 말들이 웅성거렸고,"^^xsd:string ;
:relatedTo :Line_259 .

:TV_Line_260_KO a :TranslationVariant ;
:text "파수꾼이 파수꾼을 추궁했으며, 마침내는"^^xsd:string ;
:relatedTo :Line_260 .

:TV_Line_261_KO a :TranslationVariant ;
:text "구타가 일어날 지경이었고, 막을 자도 없었습니다."^^xsd:string ;
:relatedTo :Line_261 .

:TV_Line_262_KO a :TranslationVariant ;
:text "각자가 그 일을 해낸 어떤 한 사람처럼 보였기 때문입니다,"^^xsd:string ;
:relatedTo :Line_262 .

:TV_Line_263_KO a :TranslationVariant ;
:text "그러나 명백한 자는 없었고, 모두가 모른다고 피했습니다."^^xsd:string ;
:relatedTo :Line_263 .

:TV_Line_264_KO a :TranslationVariant ;
:text "우리는 두 손으로 뜨거운 쇳덩이를 들 준비도 되어 있었고,"^^xsd:string ;
:relatedTo :Line_264 .

:TV_Line_265_KO a :TranslationVariant ;
:text "불 속을 지나갈 준비도, 신들에게 맹세할 준비도 되어 있었습니다,"^^xsd:string ;
:relatedTo :Line_265 .

:TV_Line_266_KO a :TranslationVariant ;
:text "그 일을 하지도 않았고, 누구와 함께 알지도 않았다고,"^^xsd:string ;
:relatedTo :Line_266 .

:TV_Line_267_KO a :TranslationVariant ;
:text "그 일을 꾀한 자와도, 실행한 자와도 관련이 없다고."^^xsd:string ;
:relatedTo :Line_267 .

:TV_Line_268_KO a :TranslationVariant ;
:text "마침내 조사하는 자들에게 아무 소득도 없었을 때,"^^xsd:string ;
:relatedTo :Line_268 .

:TV_Line_269_KO a :TranslationVariant ;
:text "누군가 하나가 말했습니다. 그는 모두의 머리를 땅으로"^^xsd:string ;
:relatedTo :Line_269 .

:TV_Line_270_KO a :TranslationVariant ;
:text "두려움 속에 숙이게 했습니다. 우리는"^^xsd:string ;
:relatedTo :Line_270 .

:TV_Line_271_KO a :TranslationVariant ;
:text "반박할 수도, 어떻게 행해야 잘될지도 알 수 없었기 때문입니다."^^xsd:string ;
:relatedTo :Line_271 .

:TV_Line_272_KO a :TranslationVariant ;
:text "그 말은 이 일이"^^xsd:string ;
:relatedTo :Line_272 .

:TV_Line_273_KO a :TranslationVariant ;
:text "당신께 보고되어야 하며 숨겨서는 안 된다는 것이었습니다."^^xsd:string ;
:relatedTo :Line_273 .

:TV_Line_274_KO a :TranslationVariant ;
:text "그리고 이것이 이겼고, 불운한 저를"^^xsd:string ;
:relatedTo :Line_274 .

:TV_Line_275_KO a :TranslationVariant ;
:text "제비가 뽑아 이 좋은 몫을 받게 했습니다."^^xsd:string ;
:relatedTo :Line_275 .

:TV_Line_276_KO a :TranslationVariant ;
:text "저는 원치 않으며 왔고, 그들도 원하지 않는다는 것을 압니다."^^xsd:string ;
:relatedTo :Line_276 .

:TV_Line_277_KO a :TranslationVariant ;
:text "나쁜 말들의 전령을 좋아하는 사람은 아무도 없기 때문입니다."^^xsd:string ;
:relatedTo :Line_277 .

:TV_Line_278_KO a :TranslationVariant ;
:text "왕이여, 내 생각은 오래전부터 이 일이"^^xsd:string ;
:relatedTo :Line_278 .

:TV_Line_279_KO a :TranslationVariant ;
:text "혹시 신이 보낸 것이 아닐까 헤아리고 있습니다."^^xsd:string ;
:relatedTo :Line_279 .
