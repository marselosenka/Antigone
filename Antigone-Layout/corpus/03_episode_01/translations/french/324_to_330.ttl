:episode_01-translations-324-330-french a owl:Ontology .
# French translation variants for 324_to_330.ttl

:TV_Line_324_FR a :TranslationVariant ;
:text "Raffine donc ton opinion ; mais si vous ne me faites pas"^^xsd:string ;
:relatedTo :Line_324 .

:TV_Line_325_FR a :TranslationVariant ;
:text "apparaître ceux qui ont fait cela, vous direz"^^xsd:string ;
:relatedTo :Line_325 .

:TV_Line_326_FR a :TranslationVariant ;
:text "que les gains lâches produisent des malheurs."^^xsd:string ;
:relatedTo :Line_326 .

:TV_Line_327_FR a :TranslationVariant ;
:text "Mais puisse-t-il surtout être trouvé ; cependant, qu’il"^^xsd:string ;
:relatedTo :Line_327 .

:TV_Line_328_FR a :TranslationVariant ;
:text "soit pris ou non, car le hasard en jugera,"^^xsd:string ;
:relatedTo :Line_328 .

:TV_Line_329_FR a :TranslationVariant ;
:text "il n’est pas possible que tu me voies revenir ici."^^xsd:string ;
:relatedTo :Line_329 .

:TV_Line_330_FR a :TranslationVariant ;
:text "Car maintenant, au-delà de mon espérance et de mon jugement,"^^xsd:string ;
:relatedTo :Line_330 .
