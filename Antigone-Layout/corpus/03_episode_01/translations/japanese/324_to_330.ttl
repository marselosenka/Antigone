@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_01-translations-324-330-japanese a owl:Ontology .
# Japanese translation variants for 324_to_330.ttl

:TV_Line_324_JA a :TranslationVariant ;
:text "では、その考えを飾り立てていろ。だが、もしこれらを"^^xsd:string ;
:relatedTo :Line_324 .

:TV_Line_325_JA a :TranslationVariant ;
:text "行った者たちを私に明らかにしないなら、あなた方は言うだろう、"^^xsd:string ;
:relatedTo :Line_325 .

:TV_Line_326_JA a :TranslationVariant ;
:text "卑しい利益は災いを作り出すのだと。"^^xsd:string ;
:relatedTo :Line_326 .

:TV_Line_327_JA a :TranslationVariant ;
:text "だが、できれば何よりも見つかってほしい。けれども、"^^xsd:string ;
:relatedTo :Line_327 .

:TV_Line_328_JA a :TranslationVariant ;
:text "捕らえられても捕らえられなくても、それは運命が判定するだろうから、"^^xsd:string ;
:relatedTo :Line_328 .

:TV_Line_329_JA a :TranslationVariant ;
:text "あなたが私がここへ来るのを見ることは決してないでしょう。"^^xsd:string ;
:relatedTo :Line_329 .

:TV_Line_330_JA a :TranslationVariant ;
:text "というのも今でさえ、私の希望と判断の外で、"^^xsd:string ;
:relatedTo :Line_330 .
