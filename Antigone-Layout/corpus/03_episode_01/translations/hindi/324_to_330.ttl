@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_01-translations-324-330-hindi a owl:Ontology .
# Hindi translation variants for 324_to_330.ttl

:TV_Line_324_HI a :TranslationVariant ;
:text "अब अपनी राय को चतुराई से सजाओ; पर यदि तुम मुझे"^^xsd:string ;
:relatedTo :Line_324 .

:TV_Line_325_HI a :TranslationVariant ;
:text "इन काम करने वालों को प्रकट न करोगे, तो कहोगे कि"^^xsd:string ;
:relatedTo :Line_325 .

:TV_Line_326_HI a :TranslationVariant ;
:text "कायर लाभ विपत्तियाँ उत्पन्न करते हैं।"^^xsd:string ;
:relatedTo :Line_326 .

:TV_Line_327_HI a :TranslationVariant ;
:text "काश वह अवश्य मिल जाए; पर यदि वह"^^xsd:string ;
:relatedTo :Line_327 .

:TV_Line_328_HI a :TranslationVariant ;
:text "पकड़ा जाए या नहीं—क्योंकि यह भाग्य तय करेगा—"^^xsd:string ;
:relatedTo :Line_328 .

:TV_Line_329_HI a :TranslationVariant ;
:text "ऐसा कोई उपाय नहीं कि तू मुझे यहाँ लौटते देखे।"^^xsd:string ;
:relatedTo :Line_329 .

:TV_Line_330_HI a :TranslationVariant ;
:text "क्योंकि अभी तो अपनी आशा और समझ से बाहर"^^xsd:string ;
:relatedTo :Line_330 .
