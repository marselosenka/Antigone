@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_01-translations-324-330-bengali a owl:Ontology .
# Bengali translation variants for 324_to_330.ttl

:TV_Line_324_BN a :TranslationVariant ;
:text "এখন মত নিয়ে কৌশল করো; কিন্তু যদি তোমরা"^^xsd:string ;
:relatedTo :Line_324 .

:TV_Line_325_BN a :TranslationVariant ;
:text "কর্মকারীদের আমার সামনে প্রকাশ না করো, তবে বলবে যে"^^xsd:string ;
:relatedTo :Line_325 .

:TV_Line_326_BN a :TranslationVariant ;
:text "ভীরু লাভ শুধু বিপদ সৃষ্টি করে।"^^xsd:string ;
:relatedTo :Line_326 .

:TV_Line_327_BN a :TranslationVariant ;
:text "তবে তাকে বিশেষ করে পাওয়া যাক; কিন্তু সে"^^xsd:string ;
:relatedTo :Line_327 .

:TV_Line_328_BN a :TranslationVariant ;
:text "ধরা পড়ুক বা না পড়ুক—এ কথা ভাগ্য বিচার করবে—"^^xsd:string ;
:relatedTo :Line_328 .

:TV_Line_329_BN a :TranslationVariant ;
:text "তুমি আমাকে আর কখনও এখানে আসতে দেখবে না।"^^xsd:string ;
:relatedTo :Line_329 .

:TV_Line_330_BN a :TranslationVariant ;
:text "কারণ এখন, আমার আশা ও মতের বাইরে,"^^xsd:string ;
:relatedTo :Line_330 .
