             :Event_MenDrivenFromHomes,
             :Event_MindsSeducedToSavagery,
             :Event_WickednessTaught,
             :Event_ActsUngodly .

:Event_CitiesCorrupted
  a owl:NamedIndividual, owl:Thing ;
  :description "Cities are corrupted and damaged by money."^^xsd:string .

:Event_MenDrivenFromHomes
  a owl:NamedIndividual, owl:Thing ;
  :description "Men are driven from their homes by money."^^xsd:string .

:Event_MindsSeducedToSavagery
  a owl:NamedIndividual, owl:Thing ;
  :description "Minds are seduced and trained toward savage conduct."^^xsd:string .

:Event_WickednessTaught
  a owl:NamedIndividual, owl:Thing ;
  :description "Wickedness is taught and normalized among people."^^xsd:string .

:Event_ActsUngodly
  a owl:NamedIndividual, owl:Thing ;
  :description "Human actions are rendered ungodly."^^xsd:string .

:Event_ThreatOfHanging
  a owl:NamedIndividual, owl:Thing ;
  :description "Threat to hang the guards alive until the outrage is disclosed."^^xsd:string .

:Event_DisclosureOfPerpetrator
  a owl:NamedIndividual, owl:Thing ;
  :description "Demand that the doer of the burial be found and brought into Creonâ€™s sight."^^xsd:string .

:Event_ShamefulProfitSeeking
  a owl:NamedIndividual, owl:Thing ;
  :description "Pursuit of profit from shameful sources."^^xsd:string ;
  :relatedTo :Event_LoseMoreThanGain .

:Event_LoseMoreThanGain
  a owl:NamedIndividual, owl:Thing ;
  :description "One loses more than one gains in shameful pursuits."^^xsd:string .

:Event_ThreatOfHanging :relatedTo :Event_DisclosureOfPerpetrator .

:Event_ChanceDecides
  a owl:NamedIndividual, owl:Thing ;
