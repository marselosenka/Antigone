################################################################
# CHARACTERS
################################################################

:Antigone_Character_Antigone 
    a :Character,
    owl:NamedIndividual ;
    :relatedTo :CreonDecision_EntombAntigoneAlive .

:Antigone_Character_Chorus a :Character,
        owl:NamedIndividual ;
    :advocatesFor 
        :EthicalPrinciple_MutualLearning ;
    :experiencesEmotion :ChorusEmotion_AweAtErosPower,
        :ChorusEmotion_TearsAndPityForAntigone .

:Antigone_Character_Haemon a :Character,
    owl:NamedIndividual ;
    :hasMotivation :Motivation_MournBride,
        :Motivation_PersuadeToYield,
        :Motivation_HelpFather,
        :Motivation_AbandonFatHer,
        :Motivation_FollowFathersGuidance,
        :Motivation_InformAndProtectFather ;
    :makesMoralDecision :MoralDecision_LeaveCreon ;
    :advocatesFor :EthicalPrinciple_FilialPiety,
        :EthicalPrinciple_SupremacyOfReason,
        :EthicalPrinciple_JudgeByActions,
        :EthicalPrinciple_CollectiveRule,
        :EthicalPrinciple_TyrannicalOwnership,
        :EthicalPrinciple_DivineReverence,
        :EthicalPrinciple_ValueOfFlexibility ;
    :experiencesEmotion :Emotion_Frustration,
        :Emotion_Anger,
        :Emotion_Resentment,
        :Emotion_Pain .

:Antigone_Character_Creon a :Character,
        owl:NamedIndividual ;
    :advocatesFor :EthicalPrinciple_AvoidMiasma,
        :EthicalPrinciple_CivicPurity,
        :EthicalPrinciple_FilialPiety,
        :EthicalPrinciple_AbsoluteCivicObedience,
        :EthicalPrinciple_HouseholdGovernance,
        :EthicalPrinciple_SpareTheInnocent ;
    :hasMotivation :CreonMotivation_AvoidMiasmaForCity,
        :Motivation_AssessSonLoyalty,
        :Motivation_DemandObedience,
        :Motivation_DefendAuthority,
        :Motivation_MaintainPatriarchalDominance,
        :Motivation_EnsureExecution ;
    :makesMoralDecision 
        :CreonDecision_EntombAntigoneAlive ,
        :MoralDecision_ExecuteAntigoneBeforeHaemon,
        :MoralDecision_ExecuteAntigone,
        :MoralDecision_SpareIsmene ;
    :experiencesEmotion
        :Emotion_FearOfMockery,
        :Emotion_Wrath,
        :Emotion_Outrage,
        :Emotion_InsultedPride,
        :Emotion_Contempt,
        :Emotion_Ranting .
    

:Antigone_Character_City a :Character ;
    :experiencesEmotion :Emotion_PublicMourning .


