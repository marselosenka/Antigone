################################################################
# CAUSES 
################################################################

:Cause_AbsoluteTyranny :relatedTo :Effect_Wasteland .

:Cause_ListeningToWomen a owl:Thing ;
    :description "Taking sides with or being influenced by a woman, which Creon perceives as a weakness."^^xsd:string .

:Cause_CivicObedience :relatedTo :Effect_PreservationOfLife .

:Cause_Disobedience :relatedTo :Effect_SocialCollapse .

:Cause_CivicObedience a owl:Thing ;
    :description "Obedience to authority when society is in good order."^^xsd:string .

:Cause_DisobedientChildren a owl:Thing ;
    :description "Raising hopeless and disobedient children."^^xsd:string .
:Cause_DisobedientChildren :relatedTo :Effect_EnemyMockery .


:Cause_DivineDeception a owl:Thing ;
    :description "The gods leading a mortal's mind to ruin."^^xsd:string .

:Cause_FalseHope a owl:Thing ;
    :description "Hope acting as a trick of thoughtless lust."^^xsd:string .

:Cause_FrightfulEye a owl:Thing ;
    :description "Creon's intimidating presence and frightful eye."^^xsd:string .

:Cause_KeptHandsClean :relatedTo :Effect_SparedFromDeath .

:Cause_LustForWoman a owl:Thing ;
    :description "Losing one's head for the pleasure of a woman."^^xsd:string .

:Effect_ColdMarriage a owl:Thing ;
    :description "Finding a wretched, cold woman in one's bed and home."^^xsd:string .
:Cause_LustForWoman :relatedTo :Effect_ColdMarriage .

:Cause_TolerateFamilyDisobedience a owl:Thing ;
    :description "Allowing one's own relatives to walk all over authority."^^xsd:string .

:Cause_PiousBurial a owl:Thing ;
    :description "Antigone protecting her brother from flesh-eating dogs and birds."^^xsd:string .
:Cause_PiousBurial :relatedTo :Effect_DeservingHonor .

:Cause_RigidStubbornness a owl:Thing ;
    :description "A tree refusing to yield to a swollen stream, or a captain tying his sail too tight."^^xsd:string .

:Cause_RigidStubbornness :relatedTo :Effect_Destruction .

:Cause_YieldingToForce a owl:Thing ;
    :description "A tree yielding its smaller branches to the fresh snowmelt."^^xsd:string .

:Cause_TolerateFamilyDisobedience :relatedTo :Effect_GeneralAnarchy .

:Cause_Disobedience a owl:Thing ;
    :description "The crime of breaking or cheapening the law."^^xsd:string .

:Cause_YieldingToForce :relatedTo :Effect_Survival .

:Cause_ListeningToWomen :relatedTo :Effect_CloudedJudgement .

:Cause_KeptHandsClean a owl:Thing ;
    :description "Ismene keeping her hands clean of the burial act."^^xsd:string .


################################################################
# THEMES
################################################################

:Theme_AbsoluteAuthority a :Theme ;
    :description "The strict demand for unquestioning loyalty and obedience to the ruler's commands."^^xsd:string .


:Theme_YouthfulRashness a :Theme ;
    :description "The passionate, resentful, and impulsive nature of youth when confronted with trauma and pain."^^xsd:string .

:Theme_Tyranny a :Theme ;
    :description "The destructive nature of absolute dictatorial rule and the dangerous belief that a city is the ruler's property."^^xsd:string .

:Theme_DivineGiftOfReason a :Theme ;
    :description "The concept that the gods endow mankind with reason as their supreme trait."^^xsd:string .

:Theme_AgeVsYouth a :Theme ;
    :description "The generational tension between the traditional, rigid authority of elders and the adaptive wisdom of youth."^^xsd:string .

:Theme_CivicOrderVsAnarchy a :Theme ;
    :description "The contrast between the protective nature of societal order and the destructive chaos of disobedience."^^xsd:string .

:Theme_CivicPurityAndMiasma a :Theme,
        owl:NamedIndividual ;
    :description "Civic anxiety about ritual pollution and the attempt to protect the polis from miasma."^^xsd:string .

:Theme_DeathAndHadesReverence a :Theme,
        owl:NamedIndividual ;
    :description "The logic of death: appeal to Hades and the futility or cost of revering the underworld."^^xsd:string .

:Theme_DivineLaw a :Theme ;
    :description "The absolute supremacy of the gods' laws over human arrogance and self-worship."^^xsd:string .

:Theme_DivineMadness a :Theme ;
    :description "The gods distorting human perception to make evil seem good before bringing swift ruin."^^xsd:string .

:Theme_ErosOverpowersReasonAndLaw a :Theme,
        owl:NamedIndividual ;
    :description "Eros as an irresistible force that subverts reason, justice, and social order."^^xsd:string .

:Theme_FalseHope a :Theme ;
    :description "Hope as a wandering illusion that acts as a trick of lust and leads unknowingly to pain."^^xsd:string .

:Theme_FilialDuty a :Theme ;
    :description "The expectation of unconditional allegiance from a son to his father."^^xsd:string .

:Theme_FilialPiety a :Theme ;
    :description "The structural expectation of a son's total allegiance to his father's will and enmities."^^xsd:string .

:Theme_Flexibility a :Theme ;
    :description "The wisdom of adaptability, yielding, and continuous learning, contrasted with destructive rigidity."^^xsd:string .

:Theme_GuiltAndInnocence a :Theme ;
    :description "The demarcation between guilt and innocence, represented by the physical metaphor of keeping one's hands clean."^^xsd:string .

:Theme_Misogyny a :Theme ;
    :description "The deep-seated prejudice against women, used by Creon to invalidate Haemon's logical arguments."^^xsd:string .

:Theme_Patriarchy a :Theme ;
    :description "The rigid adherence to male dominance and the societal fear of female empowerment."^^xsd:string .

:Theme_PublicOpinionVsTyranny a :Theme ;
    :description "The hidden murmurings of the citizens who recognize justice but are silenced by a ruler's intimidation."^^xsd:string .

:Theme_Stubbornness a :Theme ;
    :description "The arrogance of single-mindedness and believing one has no equal, which leads to ruin."^^xsd:string .

:Theme_TearsAndPityAtBridalChamberOfDeath a :Theme,
        owl:NamedIndividual ;
    :description "Pathos: tears at Antigone's approach to the 'bridal chamber' of death."^^xsd:string .

:Theme_TyrantIsolation a :Theme ;
    :description "The isolation of the tyrant, left to rant and rave only to compliant friends after driving away his own son."^^xsd:string .

################################################################
# EMOTIONS
################################################################

:ChorusEmotion_AweAtErosPower a :Emotion,
        owl:NamedIndividual ;
    :description "Awe at Eros as an invincible power that drives all to madness."^^xsd:string .

:ChorusEmotion_TearsAndPityForAntigone a :Emotion,
        owl:NamedIndividual ;
    :description "Tears and pity at the sight of Antigone going to the all-shared bridal chamber (death)."^^xsd:string .

:Emotion_FearOfTyrant a :Emotion ;
    :description "The fear experienced by the common man due to Creon's frightful eye, preventing open disagreement."^^xsd:string .
:CommonMan :experiencesEmotion :Emotion_FearOfTyrant .

:Emotion_PublicMourning a :Emotion ;
    :description "The sorrow and mourning of the city for Antigone's unjust condemnation."^^xsd:string .

:Emotion_Wrath a :Emotion ;
    :description "Creon's intense anger and wrath, which Haemon begs him to relinquish."^^xsd:string .

:Emotion_FearOfMockery a :Emotion ;
    :description "Creon's fear of being mocked by enemies for raising hopeless, disobedient children."^^xsd:string .

:Emotion_Contempt a :Emotion ;
    :description "Creon's scorn for Antigone, viewing her as a false friend and an enemy."^^xsd:string .

:Emotion_InsultedPride a :Emotion ;
    :description "Creon's indignation and wounded pride at the prospect of being taught by a younger man or having his authority questioned."^^xsd:string .

:Emotion_Outrage a :Emotion ;
    :description "Creon's explosive anger at Haemon's perceived insults, culminating in his command for an immediate execution."^^xsd:string .

:Emotion_Frustration a :Emotion ;
    :description "Haemon's exasperation at his father's refusal to listen and his foolish plans."^^xsd:string .

:Emotion_Anger a :Emotion ;
    :description "Haemon's intense anger that drives him to storm out of the presence of his father."^^xsd:string .

:Emotion_Resentment a :Emotion ;
    :description "The resentment that grows in a youthful mind when it is confronted with deep emotional pain."^^xsd:string .

:Emotion_Pain a :Emotion ;
    :description "The profound emotional agony felt by Haemon over the impending death of his bride and the rupture with his father."^^xsd:string .

:Emotion_Ranting a :Emotion ;
    :description "Creon's irrational ranting and raving, as perceived and condemned by Haemon."^^xsd:string .

################################################################
# CONFLICTS
################################################################

:Conflict_AutocracyVsCollectiveCity a :Conflict ;
    :description "The clash between Creon's dictatorial view that the ruler owns the city and Haemon's view that a city belongs to all."^^xsd:string ;
    :conflictBetween :Antigone_Character_Creon, :Antigone_Character_Haemon .

:Conflict_TyrantVsPublicOpinion a :Conflict ;
    :description "The contradiction between Creon's harsh decree and the city's secret belief that Antigone acted honorably."^^xsd:string ;
    :conflictBetween :Antigone_Character_Creon, :Antigone_Character_City .
    
:Conflict_ErosVsJustice a :Conflict,
        owl:NamedIndividual ;
    :conflictBetween :EthicalPrinciple_ErosDesire,
        :EthicalPrinciple_Justice ;
    :description "Eros overthrows just minds, turning the just toward injustice and stirring kin-strife."^^xsd:string .

:Conflict_HumanAuthorityVsDivineLaw a :Conflict ;
    :description "The conflict between Creon worshiping his own human authority and respecting the fundamental laws of the gods."^^xsd:string ;
    :conflictBetween :Antigone_Character_Creon, :Theme_DivineLaw .

:Conflict_LoyaltyVsLove a :Conflict ;
    :description "The tension between Haemon's romantic bond with Antigone and his filial duty to Creon."^^xsd:string ;
    :conflictBetween :Antigone_Character_Antigone, :Antigone_Character_Creon .

:Conflict_MaleAuthorityVsFemaleDefiance a :Conflict ;
    :description "The tension surrounding gender roles, as Creon refuses to be seen as weaker than a woman."^^xsd:string ;
    :conflictBetween :Antigone_Character_Creon, :Antigone_Character_Antigone .

:Conflict_RigidityVsFlexibility a :Conflict ;
    :description "The clash between holding a single uncompromising view and the willingness to learn and adapt."^^xsd:string ;
    :conflictBetween :Theme_Stubbornness, :Theme_Flexibility .

:Conflict_StateAuthorityVsIndividualDefiance a :Conflict ;
    :description "The clash between Creon's absolute civic authority and Antigone dictating her own laws."^^xsd:string ;
    :conflictBetween :Antigone_Character_Creon, :Antigone_Character_Antigone .


:Conflict_FatherVsSon a :Conflict ;
    :description "The final rupture and contradiction between Haemon's loyalty to his bride and Creon's tyrannical demands."^^xsd:string ;
    :conflictBetween :Antigone_Character_Haemon, :Antigone_Character_Creon .

################################################################
# ETHICAL PRINCIPLES
################################################################

:EthicalPrinciple_FilialLoyalty a :EthicalPrinciple ;
    :description "The principle that a son should act as an unconditional ally to his father through all circumstances."^^xsd:string .

:EthicalPrinciple_SupremacyOfReason a :EthicalPrinciple ;
    :description "The principle that reason is the supreme trait endowed to mankind by the gods."^^xsd:string .

:EthicalPrinciple_ValueOfFlexibility a :EthicalPrinciple ;
    :description "The moral stance that a wise man must be willing to learn, yield to good advice, and avoid absolute rigidity."^^xsd:string .

:EthicalPrinciple_HonorForPiousDeeds a :EthicalPrinciple ;
    :description "The belief that burying a fallen brother to prevent desecration is a good deed deserving of honor, not death."^^xsd:string .

:EthicalPrinciple_FilialPiety a :EthicalPrinciple ;
    :description "The principle that a son must follow his father's path and honor his loved ones."^^xsd:string .

:EthicalPrinciple_JudgeByActions a :EthicalPrinciple ;
    :description "The principle that a person's wisdom and value should be judged by their actions, not merely by their age."^^xsd:string .

:EthicalPrinciple_AbsoluteCivicObedience a :EthicalPrinciple ;
    :description "The belief that citizens must obey the city's chosen leader in all matters, large and small, just and unjust."^^xsd:string .

:EthicalPrinciple_AvoidMiasma a :EthicalPrinciple,
        owl:NamedIndividual ;
    :description "Avoidance of ritual pollution (μίασμα) as a public danger."^^xsd:string .

:EthicalPrinciple_CivicPurity a :EthicalPrinciple,
        owl:NamedIndividual ;
    :description "Protection of the polis from pollution; prioritizing civic well-being."^^xsd:string .

:EthicalPrinciple_ErosDesire a :EthicalPrinciple,
        owl:NamedIndividual ;
    :description "Eros/desire as a compelling force that bends minds and actions."^^xsd:string .

:EthicalPrinciple_Justice a :EthicalPrinciple,
        owl:NamedIndividual ;
    :description "Commitment to what is just (δίκαια) in judgment and action."^^xsd:string .

:EthicalPrinciple_HouseholdGovernance a :EthicalPrinciple ;
    :description "The principle that a man must be able to govern his own house in order to govern a city."^^xsd:string .

:EthicalPrinciple_MutualLearning a :EthicalPrinciple ;
    :description "The principle that individuals should learn from one another if they speak suitably, regardless of age."^^xsd:string .

:EthicalPrinciple_CollectiveRule a :EthicalPrinciple ;
    :description "The political principle that a city does not belong to only one man, but to its people."^^xsd:string .

:EthicalPrinciple_DivineReverence a :EthicalPrinciple ;
    :description "The moral imperative that human authority must not walk all over the domains and laws of the gods."^^xsd:string .

:EthicalPrinciple_TyrannicalOwnership a :EthicalPrinciple ;
    :description "The belief that the city is ruled, dictated, and effectively owned by the man in charge."^^xsd:string .

:EthicalPrinciple_SpareTheInnocent a :EthicalPrinciple ;
    :description "The principle that one who kept her hands clean of a crime should not be punished alongside the guilty."^^xsd:string .
################################################################
# MORAL DECISIONS
################################################################

:CreonDecision_EntombAntigoneAlive a :MoralDecision,
        owl:NamedIndividual ;
    :description "Creon decides to hide Antigone alive in a rocky underground chamber with minimal food."^^xsd:string ;
    :relatedTo :CreonMotivation_AvoidMiasmaForCity .

:MoralDecision_ExecuteAntigone a :MoralDecision ;
    :description "Creon's decision to kill Antigone and dismiss her to Hades for openly disobeying his commands."^^xsd:string .

:MoralDecision_ExecuteAntigoneBeforeHaemon a :MoralDecision ;
    :description "Creon's vindictive decision to bring Antigone out to die immediately in front of her bridegroom as punishment for Haemon's insults."^^xsd:string .

:MoralDecision_LeaveCreon a :MoralDecision ;
    :description "Haemon's decisive action to storm out and refuse to witness Antigone's death beside him."^^xsd:string .

:MoralDecision_SpareIsmene a :MoralDecision ;
    :description "Creon's decision to spare the sister who kept her hands clean from the crime."^^xsd:string .

################################################################
# MOTIVATIONS
################################################################

:CreonMotivation_AvoidMiasmaForCity a :Motivation,
        owl:NamedIndividual ;
    :description "To ensure the city escapes pollution by shifting responsibility to Hades and isolating the condemned."^^xsd:string .

:Motivation_AssessSonLoyalty a :Motivation ;
    :description "Creon's intention to determine if his son remains a faithful ally after hearing of his bride's condemnation."^^xsd:string .

:Motivation_DefendAuthority a :Motivation ;
    :description "Creon's intention to fiercely protect his absolute authority and refuse any teaching or correction from a younger man."^^xsd:string .

:Motivation_AbandonFather a :Motivation ;
    :description "Haemon's intention to permanently sever ties with his father so Creon will never look upon his face again."^^xsd:string .

:Motivation_FollowFathersGuidance a :Motivation ;
    :description "Haemon's intention to prioritize his father's wise guidance over any marriage."^^xsd:string .

:Motivation_HelpFather a :Motivation ;
    :description "Haemon's intention to help his father avoid making a mistake and angering the gods."^^xsd:string .

:Motivation_InformAndProtectFather a :Motivation ;
    :description "Haemon's intention to look out for his father by secretly listening to and reporting the city's true opinions."^^xsd:string .

:Motivation_MournBride a :Motivation ;
    :description "Haemon's supposed intention to mourn the fate of his bride Antigone and grieve his lost marriage."^^xsd:string .

:Motivation_DemandObedience a :Motivation ;
    :description "Creon's intention to ensure his son always supports his father's judgment and opposes his enemies."^^xsd:string .

:Motivation_MaintainPatriarchalDominance a :Motivation ;
    :description "Creon's determination to never be seduced or deposed by a woman, preferring defeat by a man."^^xsd:string .

:Motivation_PersuadeToYield a :Motivation ;
    :description "Haemon's objective to convince Creon to let his wrath subside and be open to the opinions of others."^^xsd:string .

:Motivation_EnsureExecution a :Motivation ;
    :description "Creon's unwavering intention to ensure Antigone cannot be freed from her fate despite Haemon's threats."^^xsd:string .

################################################################
# EFFECTS
################################################################

:Effect_CloudedJudgement a owl:Thing ;
    :description "The assumption that one's judgement has been clouded by emotions or slavery to a woman."^^xsd:string .

:Effect_ColdMarriage a owl:Thing ;
    :description "Finding a wretched, cold woman in one's bed and home."^^xsd:string .

:Effect_DeservingHonor a owl:Thing ;
    :description "The city's conclusion that Antigone deserves a share of gilded honor."^^xsd:string .

:Effect_Destruction a owl:Thing ;
    :description "Being washed away roots and all, or snapping the mast in half."^^xsd:string .

:Effect_EnemyMockery a owl:Thing ;
    :description "Creating trouble for oneself and giving enemies an excuse to mock."^^xsd:string .

:Effect_GeneralAnarchy a owl:Thing ;
    :description "Everyone else following suit and breaking the law."^^xsd:string .

:Effect_InevitableRuin a owl:Thing ;
    :description "The mortal falling into ruin shortly after losing moral clarity."^^xsd:string .

:Effect_MoralBlindness a owl:Thing ;
    :description "Evil appearing as good to the deceived mortal."^^xsd:string .

:Effect_PreservationOfLife a owl:Thing ;
    :description "Saving many lives and defending the order of things."^^xsd:string .

:Effect_SocialCollapse a owl:Thing ;
    :description "Toppling cities, making fugitives of families, and putting armies to flight."^^xsd:string .

:Effect_SparedFromDeath a owl:Thing ;
    :description "Ismene being spared from the execution originally meant for both sisters."^^xsd:string .

:Effect_SuppressedSpeech a owl:Thing ;
    :description "The common man withholding displeasing truths and speaking only in dim whispers."^^xsd:string .
:Cause_FrightfulEye :relatedTo :Effect_SuppressedSpeech .

:Effect_Survival a owl:Thing ;
    :description "The tree saving itself from destruction."^^xsd:string .

:Effect_UnexpectedPain a owl:Thing ;
    :description "A victim unknowingly crying out from a foot blazing with fire."^^xsd:string .

:Effect_Wasteland a owl:Thing ;
    :description "The city effectively becoming an empty wasteland without its people's voice."^^xsd:string .


################################################################
# EVENTS
################################################################

:Event_AnotherDeath a owl:Thing ;
    :description "The consequent death of another person, representing Haemon's veiled suicide threat."^^xsd:string .

:Event_AntigonesDeath a owl:Thing ;
    :description "The impending death of Antigone."^^xsd:string .
:Event_AntigonesDeath :relatedTo :Event_AnotherDeath .

:Event_FinalVote :relatedTo :Emotion_Grief .

:Event_FinalVote :relatedTo :Emotion_Raving .

:Event_StormingOut a owl:Thing ;
    :description "Haemon storming out in anger."^^xsd:string .
:Emotion_Anger :relatedTo :Event_StormingOut .

:Event_Resentment a owl:Thing ;
    :description "The mind growing resentful and turning to anger."^^xsd:string .

:Event_YouthfulPain a owl:Thing ;
    :description "A young mind experiencing severe emotional pain."^^xsd:string .

:Event_YouthfulPain :relatedTo :Event_Resentment .

