@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_03-translations-681-723-greek a owl:Ontology .


:TV_Line_681_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_681 ;
    :text "τουλάχιστον κατά τη δική μας κρίση, αν ο χρόνος δεν μας έχει στερήσει τη σύνεση,"^^xsd:string .

:TV_Line_682_GR a :TranslationVariant ;
    :text "φαίνεσαι, γι' αυτά που λες, να μιλάς με φρόνηση."^^xsd:string ;
    :relatedTo :Line_682 .

:TV_Line_683_GR a :TranslationVariant ;
    :text "από όλα όσα υπάρχουν, αυτό είναι το υπέρτατο κτήμα."^^xsd:string ;
    :relatedTo :Line_683 .

:TV_Line_684_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_684 ;
    :text "το ανώτερο από όλα τα αγαθά που υπάρχουν."^^xsd:string .

:TV_Line_685_GR a :TranslationVariant ;
    :text "κι εγώ, ότι εσύ δεν τα λες σωστά αυτά,"^^xsd:string ;
    :relatedTo :Line_685 .

:TV_Line_686_GR a :TranslationVariant ;
    :text "ούτε θα μπορούσα ούτε θα ήξερα να το πω."^^xsd:string ;
    :relatedTo :Line_686 .

:TV_Line_687_GR a :TranslationVariant ;
    :text "θα μπορούσε όμως και στον άλλον να ταιριάζει το σωστό."^^xsd:string ;
    :relatedTo :Line_687 .

:TV_Line_688_GR a :TranslationVariant ;
    :text "όταν κάποιος μιλά ή πράττει ή έχει κάτι να σε ψέξει."^^xsd:string ;
    :relatedTo :Line_688 .

:TV_Line_689_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_689 ;
    :text "τι λέει ή τι κάνει κάποιος ή τι έχει να επικρίνει."^^xsd:string .

:TV_Line_690_GR a :TranslationVariant ;
    :text "εμένα όμως κρυφά φτάνουν στ’ αυτιά μου αυτά,"^^xsd:string ;
    :relatedTo :Line_690 .

:TV_Line_691_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_691 ;
    :text "με τέτοια λόγια, που εσύ δεν θα χαιρόσουν να ακούσεις·"^^xsd:string .

:TV_Line_692_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_692 ;
    :text "εγώ όμως μπορώ να τα ακούω αυτά κρυφά,"^^xsd:string .

:TV_Line_693_GR a :TranslationVariant ;
    :text "πως αυτή είναι η πιο ανάξια από όλες τις γυναίκες"^^xsd:string ;
    :relatedTo :Line_693 .

:TV_Line_694_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_694 ;
    :text "πως από όλες τις γυναίκες ήταν η λιγότερο άξια"^^xsd:string .

:TV_Line_695_GR a :TranslationVariant ;
    :text "να χάνεται τόσο άσχημα για έργα τόσο ένδοξα."^^xsd:string ;
    :relatedTo :Line_695 .

:TV_Line_696_GR a :TranslationVariant ;
    :text "που δεν άφησε τον πεσμένο αδελφό της άταφο,"^^xsd:string ;
    :relatedTo :Line_696 .

:TV_Line_697_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_697 ;
    :text "να κείτεται άταφος, ούτε από σαρκοβόρα σκυλιά"^^xsd:string .

:TV_Line_698_GR a :TranslationVariant ;
    :text "ούτε να χαθεί από κάποιο αρπακτικό όρνιο."^^xsd:string ;
    :relatedTo :Line_698 .

:TV_Line_699_GR a :TranslationVariant ;
    :text "κι εγώ, αν εσύ, πατέρα, πράττεις σωστά και ευτυχώς,"^^xsd:string ;
    :relatedTo :Line_699 .

:TV_Line_700_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_700 ;
    :text "τέτοια σκοτεινή φήμη απλώνεται σιωπηλά."^^xsd:string .

:TV_Line_701_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_701 ;
    :text "Για μένα, πατέρα, όταν εσύ ευημερείς,"^^xsd:string .

:TV_Line_702_GR a :TranslationVariant ;
    :text "δεν υπάρχει τίποτα πιο πολύτιμο για μένα,"^^xsd:string ;
    :relatedTo :Line_702 .

:TV_Line_703_GR a :TranslationVariant ;
    :text "γιατί ποιο μεγαλύτερο στολίδι στα παιδιά από πατέρα που ακμάζει σε δόξα,"^^xsd:string ;
    :relatedTo :Line_703 .

:TV_Line_704_GR a :TranslationVariant ;
    :text "ή ποιο στον πατέρα από τη δόξα των παιδιών;"^^xsd:string ;
    :relatedTo :Line_704 .

:TV_Line_705_GR a :TranslationVariant ;
    :text "μην έχεις τη γνώμη πως μόνο εσύ τα λες σωστά."^^xsd:string ;
    :relatedTo :Line_705 .

:TV_Line_706_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_706 ;
    :text "πως μόνο αυτό που λες εσύ, και τίποτε άλλο, είναι σωστό."^^xsd:string .

:TV_Line_707_GR a :TranslationVariant ;
    :text "όποιος νομίζει πως μόνο αυτός φρονεί,"^^xsd:string ;
    :relatedTo :Line_707 .

:TV_Line_708_GR a :TranslationVariant ;
    :text "ή πως μόνο αυτός έχει γλώσσα ή ψυχή,"^^xsd:string ;
    :relatedTo :Line_708 .

:TV_Line_709_GR a :TranslationVariant ;
    :text "τέτοιοι, όταν ανοιχτούν, φαίνονται κούφιοι."^^xsd:string ;
    :relatedTo :Line_709 .

:TV_Line_710_GR a :TranslationVariant ;
    :text "και για τον σοφό δεν είναι ντροπή να μη μένει άκαμπτος."^^xsd:string ;
    :relatedTo :Line_710 .

:TV_Line_711_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_711 ;
    :text "πολλά· και δεν είναι καθόλου ντροπή να μην επιμένει κανείς υπερβολικά."^^xsd:string .

:TV_Line_712_GR a :TranslationVariant ;
    :text "έτσι και το καράβι που κρατά σφιχτά το πανί"^^xsd:string ;
    :relatedTo :Line_712 .

:TV_Line_713_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_713 ;
    :text "όσα δέντρα υποχωρούν, πώς σώζουν τα κλαδιά τους,"^^xsd:string .

:TV_Line_714_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_714 ;
    :text "ενώ όσα αντιστέκονται χάνονται σύρριζα."^^xsd:string .

:TV_Line_715_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_715 ;
    :text "Το ίδιο κι όποιος κρατά σφιχτό το σχοινί του πανιού ενός πλοίου"^^xsd:string .

:TV_Line_716_GR a :TranslationVariant ;
    :text "αν μένει τεντωμένο και δεν υποχωρεί καθόλου, γυρίζει ανάποδα."^^xsd:string ;
    :relatedTo :Line_716 .

:TV_Line_717_GR a :TranslationVariant ;
    :text "γιατί, αν υπάρχει κάποια σωστή γνώμη ακόμη κι από νεότερο από μένα,"^^xsd:string ;
    :relatedTo :Line_717 .

:TV_Line_718_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_718 ;
    :text "Μα υποχώρησε και άφησε τον θυμό σου να αλλάξει."^^xsd:string .

:TV_Line_719_GR a owl:NamedIndividual, :TranslationVariant ;
    :relatedTo :Line_719 ;
    :text "Γιατί, αν υπάρχει κάποια σωστή γνώμη κι από μένα τον νεότερο,"^^xsd:string .

:TV_Line_720_GR a :TranslationVariant ;
    :text "λέω πως είναι πολύ καλύτερο"^^xsd:string ;
    :relatedTo :Line_720 .

:TV_Line_721_GR a :TranslationVariant ;
    :text "να είναι ο άνθρωπος γεμάτος γνώση σε όλα·"^^xsd:string ;
    :relatedTo :Line_721 .

:TV_Line_722_GR a :TranslationVariant ;
    :text "κι αν όχι—γιατί συχνά η τύχη δεν γέρνει εκεί—"^^xsd:string ;
    :relatedTo :Line_722 .

:TV_Line_723_GR a :TranslationVariant ;
    :text "να μαθαίνει· κι αυτό που ειπώθηκε καλά, καλό είναι να το ακούς."^^xsd:string ;
    :relatedTo :Line_723 .
