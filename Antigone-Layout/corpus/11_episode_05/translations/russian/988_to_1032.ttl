@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_05-translations-988-1032-russian a owl:Ontology .
# Russian translation variants for 988_to_1032.ttl

:TV_Line_988_RU a :TranslationVariant ;
:text "Владыки Фив, мы пришли общей дорогой,"^^xsd:string ;
:relatedTo :Line_988 .

:TV_Line_989_RU a :TranslationVariant ;
:text "двое, смотрящие глазами одного; ведь для слепых"^^xsd:string ;
:relatedTo :Line_989 .

:TV_Line_990_RU a :TranslationVariant ;
:text "этот путь совершается с проводником."^^xsd:string ;
:relatedTo :Line_990 .

:TV_Line_991_RU a :TranslationVariant ;
:text "Что же нового, старый Тиресий?"^^xsd:string ;
:relatedTo :Line_991 .

:TV_Line_992_RU a :TranslationVariant ;
:text "Я научу тебя, а ты повинуйся прорицателю."^^xsd:string ;
:relatedTo :Line_992 .

:TV_Line_993_RU a :TranslationVariant ;
:text "Ведь и прежде я не отступал от твоего разума."^^xsd:string ;
:relatedTo :Line_993 .

:TV_Line_994_RU a :TranslationVariant ;
:text "Поэтому ты правым путем ведешь этот город, как кормчий."^^xsd:string ;
:relatedTo :Line_994 .

:TV_Line_995_RU a :TranslationVariant ;
:text "Я могу засвидетельствовать, испытав полезное."^^xsd:string ;
:relatedTo :Line_995 .

:TV_Line_996_RU a :TranslationVariant ;
:text "Размысли: ты снова стоишь теперь на бритве судьбы."^^xsd:string ;
:relatedTo :Line_996 .

:TV_Line_997_RU a :TranslationVariant ;
:text "Что же такое? Я трепещу перед твоими устами."^^xsd:string ;
:relatedTo :Line_997 .

:TV_Line_998_RU a :TranslationVariant ;
:text "Узнаешь, услышав знаки моего искусства."^^xsd:string ;
:relatedTo :Line_998 .

:TV_Line_999_RU a :TranslationVariant ;
:text "Ибо, сев на древнее седалище птицегадания,"^^xsd:string ;
:relatedTo :Line_999 .

:TV_Line_1000_RU a :TranslationVariant ;
:text "где была у меня пристань для всякой птицы,"^^xsd:string ;
:relatedTo :Line_1000 .

:TV_Line_1001_RU a :TranslationVariant ;
:text "я услышал неведомый крик птиц,"^^xsd:string ;
:relatedTo :Line_1001 .

:TV_Line_1002_RU a :TranslationVariant ;
:text "кричащих злым и варварским исступлением;"^^xsd:string ;
:relatedTo :Line_1002 .

:TV_Line_1003_RU a :TranslationVariant ;
:text "и я понял, что они рвали друг друга смертоносными когтями;"^^xsd:string ;
:relatedTo :Line_1003 .

:TV_Line_1004_RU a :TranslationVariant ;
:text "ведь свист крыльев был не неясен."^^xsd:string ;
:relatedTo :Line_1004 .

:TV_Line_1005_RU a :TranslationVariant ;
:text "Сразу, испугавшись, я стал испытывать всесожженные жертвы"^^xsd:string ;
:relatedTo :Line_1005 .

:TV_Line_1006_RU a :TranslationVariant ;
:text "на всепылающих алтарях; но из жертв"^^xsd:string ;
:relatedTo :Line_1006 .

:TV_Line_1007_RU a :TranslationVariant ;
:text "Гефест не сиял, но на золе"^^xsd:string ;
:relatedTo :Line_1007 .

:TV_Line_1008_RU a :TranslationVariant ;
:text "сочащаяся влага бедер плавилась и истлевала,"^^xsd:string ;
:relatedTo :Line_1008 .

:TV_Line_1009_RU a :TranslationVariant ;
:text "и дымилась, и плевалась, а высоко"^^xsd:string ;
:relatedTo :Line_1009 .

:TV_Line_1010_RU a :TranslationVariant ;
:text "желчь разбрасывалась, и обрушившиеся"^^xsd:string ;
:relatedTo :Line_1010 .

:TV_Line_1011_RU a :TranslationVariant ;
:text "бедренные кости лежали обнаженными от покрывающего жира."^^xsd:string ;
:relatedTo :Line_1011 .

:TV_Line_1012_RU a :TranslationVariant ;
:text "Такое я узнал от этого мальчика здесь:"^^xsd:string ;
:relatedTo :Line_1012 .

:TV_Line_1013_RU a :TranslationVariant ;
:text "прорицания обрядов угасали, не давая знаков;"^^xsd:string ;
:relatedTo :Line_1013 .

:TV_Line_1014_RU a :TranslationVariant ;
:text "ведь он для меня проводник, как я для других."^^xsd:string ;
:relatedTo :Line_1014 .

:TV_Line_1015_RU a :TranslationVariant ;
:text "И этим от твоего разума болеет город;"^^xsd:string ;
:relatedTo :Line_1015 .

:TV_Line_1016_RU a :TranslationVariant ;
:text "ведь наши алтари и очаги всецело"^^xsd:string ;
:relatedTo :Line_1016 .

:TV_Line_1017_RU a :TranslationVariant ;
:text "полны пищи от птиц и собак,"^^xsd:string ;
:relatedTo :Line_1017 .

:TV_Line_1018_RU a :TranslationVariant ;
:text "от злосчастно павшего сына Эдипа."^^xsd:string ;
:relatedTo :Line_1018 .

:TV_Line_1019_RU a :TranslationVariant ;
:text "И затем боги уже не принимают от нас"^^xsd:string ;
:relatedTo :Line_1019 .

:TV_Line_1020_RU a :TranslationVariant ;
:text "ни жертвенных молитв, ни пламени бедренных жертв,"^^xsd:string ;
:relatedTo :Line_1020 .

:TV_Line_1021_RU a :TranslationVariant ;
:text "и птица не издает яснознаменующих криков,"^^xsd:string ;
:relatedTo :Line_1021 .

:TV_Line_1022_RU a :TranslationVariant ;
:text "наевшись жира человекоубийственной крови."^^xsd:string ;
:relatedTo :Line_1022 .

:TV_Line_1023_RU a :TranslationVariant ;
:text "Итак, дитя, обдумай это. Ведь людям"^^xsd:string ;
:relatedTo :Line_1023 .

:TV_Line_1024_RU a :TranslationVariant ;
:text "всем общее — ошибаться;"^^xsd:string ;
:relatedTo :Line_1024 .

:TV_Line_1025_RU a :TranslationVariant ;
:text "но когда он ошибется, тот уже не человек"^^xsd:string ;
:relatedTo :Line_1025 .

:TV_Line_1026_RU a :TranslationVariant ;
:text "безрассудный и не несчастный, кто, впав в зло,"^^xsd:string ;
:relatedTo :Line_1026 .

:TV_Line_1027_RU a :TranslationVariant ;
:text "исцеляет его и не остается неподвижным;"^^xsd:string ;
:relatedTo :Line_1027 .

:TV_Line_1028_RU a :TranslationVariant ;
:text "упрямство, знай, навлекает обвинение в глупости."^^xsd:string ;
:relatedTo :Line_1028 .

:TV_Line_1029_RU a :TranslationVariant ;
:text "Но уступи мертвому и не коли погибшего;"^^xsd:string ;
:relatedTo :Line_1029 .

:TV_Line_1030_RU a :TranslationVariant ;
:text "какая сила — снова убивать умершего?"^^xsd:string ;
:relatedTo :Line_1030 .

:TV_Line_1031_RU a :TranslationVariant ;
:text "Хорошо думая о тебе, я хорошо говорю; а учиться"^^xsd:string ;
:relatedTo :Line_1031 .

:TV_Line_1032_RU a :TranslationVariant ;
:text "у хорошо говорящего сладостнее всего, если это приносит пользу."^^xsd:string ;
:relatedTo :Line_1032 .
