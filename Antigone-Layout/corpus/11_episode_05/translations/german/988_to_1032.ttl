@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_05-translations-988-1032-german a owl:Ontology .
# German translation variants for 988_to_1032.ttl

:TV_Line_988_DE a :TranslationVariant ;
:text "Herrscher von Theben, wir sind einen gemeinsamen Weg gekommen,"^^xsd:string ;
:relatedTo :Line_988 .

:TV_Line_989_DE a :TranslationVariant ;
:text "zwei aus einem blickend; denn für die Blinden"^^xsd:string ;
:relatedTo :Line_989 .

:TV_Line_990_DE a :TranslationVariant ;
:text "ist dies der Weg durch einen Führer."^^xsd:string ;
:relatedTo :Line_990 .

:TV_Line_991_DE a :TranslationVariant ;
:text "Was aber gibt es Neues, alter Teiresias?"^^xsd:string ;
:relatedTo :Line_991 .

:TV_Line_992_DE a :TranslationVariant ;
:text "Ich werde es lehren, und du gehorche dem Seher."^^xsd:string ;
:relatedTo :Line_992 .

:TV_Line_993_DE a :TranslationVariant ;
:text "Nun, früher stand ich gewiss nicht von deinem Sinn ab."^^xsd:string ;
:relatedTo :Line_993 .

:TV_Line_994_DE a :TranslationVariant ;
:text "Deshalb steuerst du diese Stadt auf geradem Kurs."^^xsd:string ;
:relatedTo :Line_994 .

:TV_Line_995_DE a :TranslationVariant ;
:text "Ich kann, da ich es erfahren habe, Nützliches bezeugen."^^xsd:string ;
:relatedTo :Line_995 .

:TV_Line_996_DE a :TranslationVariant ;
:text "Sei bedacht, da du nun wieder auf der Schneide des Geschicks stehst."^^xsd:string ;
:relatedTo :Line_996 .

:TV_Line_997_DE a :TranslationVariant ;
:text "Was ist es? Wie sehr erschauere ich vor deinem Mund."^^xsd:string ;
:relatedTo :Line_997 .

:TV_Line_998_DE a :TranslationVariant ;
:text "Du wirst es erkennen, wenn du die Zeichen meiner Kunst hörst."^^xsd:string ;
:relatedTo :Line_998 .

:TV_Line_999_DE a :TranslationVariant ;
:text "Denn als ich auf dem alten Sitz der Vogelschau"^^xsd:string ;
:relatedTo :Line_999 .

:TV_Line_1000_DE a :TranslationVariant ;
:text "saß, wo mir der Hafen jedes Vogels war,"^^xsd:string ;
:relatedTo :Line_1000 .

:TV_Line_1001_DE a :TranslationVariant ;
:text "hörte ich einen unbekannten Laut von Vögeln, in bösem"^^xsd:string ;
:relatedTo :Line_1001 .

:TV_Line_1002_DE a :TranslationVariant ;
:text "Stachel und verwildert schreiend;"^^xsd:string ;
:relatedTo :Line_1002 .

:TV_Line_1003_DE a :TranslationVariant ;
:text "und dass sie einander mit mordenden Klauen zerfleischten,"^^xsd:string ;
:relatedTo :Line_1003 .

:TV_Line_1004_DE a :TranslationVariant ;
:text "erkannte ich; denn das Rauschen der Flügel war nicht undeutlich."^^xsd:string ;
:relatedTo :Line_1004 .

:TV_Line_1005_DE a :TranslationVariant ;
:text "Sogleich aber, voll Furcht, prüfte ich die Brandopfer"^^xsd:string ;
:relatedTo :Line_1005 .

:TV_Line_1006_DE a :TranslationVariant ;
:text "auf den ringsum flammenden Altären; aus den Opfern aber"^^xsd:string ;
:relatedTo :Line_1006 .

:TV_Line_1007_DE a :TranslationVariant ;
:text "leuchtete Hephaistos nicht, sondern auf der Asche"^^xsd:string ;
:relatedTo :Line_1007 .

:TV_Line_1008_DE a :TranslationVariant ;
:text "zerschmolz faulend die Feuchtigkeit der Schenkelstücke"^^xsd:string ;
:relatedTo :Line_1008 .

:TV_Line_1009_DE a :TranslationVariant ;
:text "und rauchte und spie aus, und in die Höhe"^^xsd:string ;
:relatedTo :Line_1009 .

:TV_Line_1010_DE a :TranslationVariant ;
:text "wurden Gallen verstreut, und herabgeflossen"^^xsd:string ;
:relatedTo :Line_1010 .

:TV_Line_1011_DE a :TranslationVariant ;
:text "lagen die Schenkelstücke bloß von der bedeckenden Fettschicht."^^xsd:string ;
:relatedTo :Line_1011 .

:TV_Line_1012_DE a :TranslationVariant ;
:text "Solches lernte ich von diesem Knaben hier,"^^xsd:string ;
:relatedTo :Line_1012 .

:TV_Line_1013_DE a :TranslationVariant ;
:text "dass die Weissagungen zeichenloser Riten dahinschwanden;"^^xsd:string ;
:relatedTo :Line_1013 .

:TV_Line_1014_DE a :TranslationVariant ;
:text "denn mir ist dieser Führer, anderen aber ich."^^xsd:string ;
:relatedTo :Line_1014 .

:TV_Line_1015_DE a :TranslationVariant ;
:text "Und daran krankt die Stadt aus deinem Sinn heraus;"^^xsd:string ;
:relatedTo :Line_1015 .

:TV_Line_1016_DE a :TranslationVariant ;
:text "denn unsere Altäre und Herdstellen alle"^^xsd:string ;
:relatedTo :Line_1016 .

:TV_Line_1017_DE a :TranslationVariant ;
:text "sind voll von Fraß durch Vögel und Hunde,"^^xsd:string ;
:relatedTo :Line_1017 .

:TV_Line_1018_DE a :TranslationVariant ;
:text "vom unglücklichen gefallenen Spross des Ödipus."^^xsd:string ;
:relatedTo :Line_1018 .

:TV_Line_1019_DE a :TranslationVariant ;
:text "Und darum nehmen die Götter nicht mehr Opfergebete"^^xsd:string ;
:relatedTo :Line_1019 .

:TV_Line_1020_DE a :TranslationVariant ;
:text "von uns an, noch die Flamme der Schenkelstücke,"^^xsd:string ;
:relatedTo :Line_1020 .

:TV_Line_1021_DE a :TranslationVariant ;
:text "noch lässt ein Vogel gut deutbare Rufe ertönen,"^^xsd:string ;
:relatedTo :Line_1021 .

:TV_Line_1022_DE a :TranslationVariant ;
:text "nachdem sie Fett von männervernichtendem Blut gefressen haben."^^xsd:string ;
:relatedTo :Line_1022 .

:TV_Line_1023_DE a :TranslationVariant ;
:text "Dies nun, Kind, bedenke. Denn für die Menschen"^^xsd:string ;
:relatedTo :Line_1023 .

:TV_Line_1024_DE a :TranslationVariant ;
:text "alle ist das Fehlgehen gemeinsam;"^^xsd:string ;
:relatedTo :Line_1024 .

:TV_Line_1025_DE a :TranslationVariant ;
:text "wenn er aber gefehlt hat, ist jener nicht mehr ein Mann"^^xsd:string ;
:relatedTo :Line_1025 .

:TV_Line_1026_DE a :TranslationVariant ;
:text "ohne Rat noch unglücklich, der, ins Übel"^^xsd:string ;
:relatedTo :Line_1026 .

:TV_Line_1027_DE a :TranslationVariant ;
:text "gefallen, es heilt und nicht unbeweglich bleibt;"^^xsd:string ;
:relatedTo :Line_1027 .

:TV_Line_1028_DE a :TranslationVariant ;
:text "Eigenwille zieht den Vorwurf der Verkehrtheit auf sich."^^xsd:string ;
:relatedTo :Line_1028 .

:TV_Line_1029_DE a :TranslationVariant ;
:text "Sondern weiche dem Gestorbenen und stich nicht den Zugrundegegangenen;"^^xsd:string ;
:relatedTo :Line_1029 .

:TV_Line_1030_DE a :TranslationVariant ;
:text "welche Stärke liegt darin, den Gestorbenen nochmals zu töten?"^^xsd:string ;
:relatedTo :Line_1030 .

:TV_Line_1031_DE a :TranslationVariant ;
:text "Gut gesinnt spreche ich dir gut; das Lernen aber"^^xsd:string ;
:relatedTo :Line_1031 .

:TV_Line_1032_DE a :TranslationVariant ;
:text "von einem gut Sprechenden ist am süßesten, wenn es Gewinn bringt."^^xsd:string ;
:relatedTo :Line_1032 .
