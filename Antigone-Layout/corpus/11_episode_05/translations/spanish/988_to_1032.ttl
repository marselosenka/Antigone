@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_05-translations-988-1032-spanish a owl:Ontology .
# Spanish translation variants for 988_to_1032.ttl

:TV_Line_988_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_988 ; :text "Señores de Tebas, hemos llegado por un camino común,"^^xsd:string .
:TV_Line_989_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_989 ; :text "dos que ven con los ojos de uno solo; pues para los ciegos"^^xsd:string .
:TV_Line_990_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_990 ; :text "este camino procede de un guía."^^xsd:string .
:TV_Line_991_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_991 ; :text "¿Qué hay, anciano Tiresias? ¿Qué novedad?"^^xsd:string .
:TV_Line_992_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_992 ; :text "Yo te enseñaré; y tú obedece al adivino."^^xsd:string .
:TV_Line_993_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_993 ; :text "Nunca antes me aparté de tu juicio."^^xsd:string .
:TV_Line_994_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_994 ; :text "Por eso gobiernas esta ciudad por rumbo recto."^^xsd:string .
:TV_Line_995_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_995 ; :text "Puedo atestiguar, por experiencia, que me fue provechoso."^^xsd:string .
:TV_Line_996_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_996 ; :text "Piensa bien: ahora estás de nuevo sobre el filo de la fortuna."^^xsd:string .
:TV_Line_997_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_997 ; :text "¿Qué ocurre? Tiemblo ante tu boca."^^xsd:string .
:TV_Line_998_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_998 ; :text "Lo sabrás al oír las señales de mi arte."^^xsd:string .
:TV_Line_999_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_999 ; :text "Pues sentado en mi antiguo asiento de observación de aves,"^^xsd:string .
:TV_Line_1000_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1000 ; :text "donde tenía un puerto para toda ave,"^^xsd:string .
:TV_Line_1001_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1001 ; :text "oigo un grito desconocido de pájaros,"^^xsd:string .
:TV_Line_1002_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1002 ; :text "clamando con mal aguijón y voz barbarizada;"^^xsd:string .
:TV_Line_1003_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1003 ; :text "y comprendí que se desgarraban unos a otros con garras asesinas;"^^xsd:string .
:TV_Line_1004_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1004 ; :text "pues el estruendo de las alas no era oscuro."^^xsd:string .
:TV_Line_1005_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1005 ; :text "Enseguida, temeroso, probé los sacrificios quemados"^^xsd:string .
:TV_Line_1006_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1006 ; :text "en altares encendidos por todas partes; pero desde las víctimas"^^xsd:string .
:TV_Line_1007_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1007 ; :text "Hefesto no brillaba, sino que sobre la ceniza"^^xsd:string .
:TV_Line_1008_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1008 ; :text "la grasa húmeda de los muslos se derretía,"^^xsd:string .
:TV_Line_1009_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1009 ; :text "humeaba y escupía; y por el aire"^^xsd:string .
:TV_Line_1010_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1010 ; :text "las hieles se dispersaban, y los muslos caídos"^^xsd:string .
:TV_Line_1011_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1011 ; :text "yacían desnudos de la grasa que los cubría."^^xsd:string .
:TV_Line_1012_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1012 ; :text "Tales cosas aprendí de este muchacho,"^^xsd:string .
:TV_Line_1013_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1013 ; :text "presagios que se consumían en ritos sin señales;"^^xsd:string .
:TV_Line_1014_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1014 ; :text "pues él es mi guía, y yo lo soy para otros."^^xsd:string .
:TV_Line_1015_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1015 ; :text "Y por estas cosas, nacidas de tu mente, enferma la ciudad;"^^xsd:string .
:TV_Line_1016_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1016 ; :text "pues nuestros altares y hogares están todos"^^xsd:string .
:TV_Line_1017_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1017 ; :text "llenos de alimento traído por aves y perros"^^xsd:string .
:TV_Line_1018_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1018 ; :text "del desdichado hijo caído de Edipo."^^xsd:string .
:TV_Line_1019_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1019 ; :text "Por eso los dioses ya no aceptan de nosotros"^^xsd:string .
:TV_Line_1020_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1020 ; :text "plegarias sacrificiales ni llama de muslos quemados,"^^xsd:string .
:TV_Line_1021_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1021 ; :text "ni ave alguna deja oír gritos de buen augurio,"^^xsd:string .
:TV_Line_1022_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1022 ; :text "porque han comido la grasa de sangre destructora de hombres."^^xsd:string .
:TV_Line_1023_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1023 ; :text "Reflexiona, pues, hijo, sobre estas cosas. Para todos los hombres"^^xsd:string .
:TV_Line_1024_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1024 ; :text "es común equivocarse;"^^xsd:string .
:TV_Line_1025_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1025 ; :text "pero cuando yerra, aquel hombre ya no es"^^xsd:string .
:TV_Line_1026_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1026 ; :text "insensato ni desgraciado, si, caído en el mal,"^^xsd:string .
:TV_Line_1027_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1027 ; :text "lo remedia y no permanece inmóvil;"^^xsd:string .
:TV_Line_1028_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1028 ; :text "la obstinación, ciertamente, incurre en torpeza."^^xsd:string .
:TV_Line_1029_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1029 ; :text "Cede ante el muerto, y no aguijonees a quien ha perecido;"^^xsd:string .
:TV_Line_1030_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1030 ; :text "¿qué fuerza hay en matar otra vez al muerto?"^^xsd:string .
:TV_Line_1031_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1031 ; :text "Pensando bien por ti, bien hablo; y aprender"^^xsd:string .
:TV_Line_1032_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1032 ; :text "de quien habla bien es lo más dulce, si trae provecho."^^xsd:string .
