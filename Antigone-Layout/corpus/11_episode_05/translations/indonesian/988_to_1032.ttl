@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:episode_05-translations-988-1032-indonesian a owl:Ontology .
# Indonesian translation variants for 988_to_1032.ttl

:TV_Line_988_ID a :TranslationVariant ;
:text "Para penguasa Thebes, kami datang melalui jalan bersama,"^^xsd:string ;
:relatedTo :Line_988 .

:TV_Line_989_ID a :TranslationVariant ;
:text "dua orang melihat dengan mata satu orang; sebab bagi orang buta"^^xsd:string ;
:relatedTo :Line_989 .

:TV_Line_990_ID a :TranslationVariant ;
:text "jalan ini berasal dari seorang penuntun."^^xsd:string ;
:relatedTo :Line_990 .

:TV_Line_991_ID a :TranslationVariant ;
:text "Apa hal baru, Teiresias yang tua?"^^xsd:string ;
:relatedTo :Line_991 .

:TV_Line_992_ID a :TranslationVariant ;
:text "Aku akan mengajarkan, dan engkau taatilah sang peramal."^^xsd:string ;
:relatedTo :Line_992 .

:TV_Line_993_ID a :TranslationVariant ;
:text "Memang sebelumnya aku tidak pernah menjauh dari nasihatmu."^^xsd:string ;
:relatedTo :Line_993 .

:TV_Line_994_ID a :TranslationVariant ;
:text "Karena itu engkau menakhodai kota ini di jalan yang lurus."^^xsd:string ;
:relatedTo :Line_994 .

:TV_Line_995_ID a :TranslationVariant ;
:text "Aku, setelah mengalaminya, dapat bersaksi bahwa itu bermanfaat."^^xsd:string ;
:relatedTo :Line_995 .

:TV_Line_996_ID a :TranslationVariant ;
:text "Berpikirlah, kini sekali lagi berdiri di atas mata pisau nasib."^^xsd:string ;
:relatedTo :Line_996 .

:TV_Line_997_ID a :TranslationVariant ;
:text "Apa itu? Betapa aku menggigil mendengar mulutmu."^^xsd:string ;
:relatedTo :Line_997 .

:TV_Line_998_ID a :TranslationVariant ;
:text "Engkau akan tahu, ketika mendengar tanda-tanda seniku."^^xsd:string ;
:relatedTo :Line_998 .

:TV_Line_999_ID a :TranslationVariant ;
:text "Sebab ketika aku duduk di kursi tua pengamat burung"^^xsd:string ;
:relatedTo :Line_999 .

:TV_Line_1000_ID a :TranslationVariant ;
:text "di mana bagiku ada pelabuhan bagi setiap burung,"^^xsd:string ;
:relatedTo :Line_1000 .

:TV_Line_1001_ID a :TranslationVariant ;
:text "aku mendengar suara burung-burung yang tak kukenal, dengan buruk"^^xsd:string ;
:relatedTo :Line_1001 .

:TV_Line_1002_ID a :TranslationVariant ;
:text "menjerit dalam rangsangan jahat dan membiadab;"^^xsd:string ;
:relatedTo :Line_1002 .

:TV_Line_1003_ID a :TranslationVariant ;
:text "dan saling mencabik dengan cakar-cakar pembunuh,"^^xsd:string ;
:relatedTo :Line_1003 .

:TV_Line_1004_ID a :TranslationVariant ;
:text "aku mengetahuinya; sebab deru sayap tidak samar."^^xsd:string ;
:relatedTo :Line_1004 .

:TV_Line_1005_ID a :TranslationVariant ;
:text "Segera, karena takut, aku menguji korban bakaran"^^xsd:string ;
:relatedTo :Line_1005 .

:TV_Line_1006_ID a :TranslationVariant ;
:text "di altar-altar yang menyala seluruhnya; tetapi dari korban-korban"^^xsd:string ;
:relatedTo :Line_1006 .

:TV_Line_1007_ID a :TranslationVariant ;
:text "Hefaistos tidak bersinar, melainkan di atas abu"^^xsd:string ;
:relatedTo :Line_1007 .

:TV_Line_1008_ID a :TranslationVariant ;
:text "tetesan lemak paha yang membusuk meleleh"^^xsd:string ;
:relatedTo :Line_1008 .

:TV_Line_1009_ID a :TranslationVariant ;
:text "dan berasap dan meludah; dan tinggi di udara"^^xsd:string ;
:relatedTo :Line_1009 .

:TV_Line_1010_ID a :TranslationVariant ;
:text "empedu-empedu terserak, dan paha-paha yang jatuh"^^xsd:string ;
:relatedTo :Line_1010 .

:TV_Line_1011_ID a :TranslationVariant ;
:text "terbaring telanjang dari lemak penutupnya."^^xsd:string ;
:relatedTo :Line_1011 .

:TV_Line_1012_ID a :TranslationVariant ;
:text "Hal-hal demikian kupelajari dari anak ini"^^xsd:string ;
:relatedTo :Line_1012 .

:TV_Line_1013_ID a :TranslationVariant ;
:text "sebagai ramalan ritus-ritus tanpa tanda yang sedang gagal;"^^xsd:string ;
:relatedTo :Line_1013 .

:TV_Line_1014_ID a :TranslationVariant ;
:text "sebab ia penuntunku, dan aku penuntun bagi orang lain."^^xsd:string ;
:relatedTo :Line_1014 .

:TV_Line_1015_ID a :TranslationVariant ;
:text "Dan karena pikiranmu, hal-hal ini membuat kota sakit;"^^xsd:string ;
:relatedTo :Line_1015 .

:TV_Line_1016_ID a :TranslationVariant ;
:text "sebab altar-altar dan perapian-perapian kami seluruhnya"^^xsd:string ;
:relatedTo :Line_1016 .

:TV_Line_1017_ID a :TranslationVariant ;
:text "penuh oleh makanan dari burung-burung dan anjing-anjing"^^xsd:string ;
:relatedTo :Line_1017 .

:TV_Line_1018_ID a :TranslationVariant ;
:text "dari putra Oidipus malang yang telah jatuh."^^xsd:string ;
:relatedTo :Line_1018 .

:TV_Line_1019_ID a :TranslationVariant ;
:text "Lalu para dewa tidak lagi menerima dari kami"^^xsd:string ;
:relatedTo :Line_1019 .

:TV_Line_1020_ID a :TranslationVariant ;
:text "doa-doa korban maupun nyala paha-paha korban,"^^xsd:string ;
:relatedTo :Line_1020 .

:TV_Line_1021_ID a :TranslationVariant ;
:text "dan burung pun tidak mengeluarkan teriakan bertanda baik,"^^xsd:string ;
:relatedTo :Line_1021 .

:TV_Line_1022_ID a :TranslationVariant ;
:text "setelah mereka memakan lemak darah pembunuh manusia."^^xsd:string ;
:relatedTo :Line_1022 .

:TV_Line_1023_ID a :TranslationVariant ;
:text "Karena itu, anakku, pikirkanlah ini. Sebab bagi manusia"^^xsd:string ;
:relatedTo :Line_1023 .

:TV_Line_1024_ID a :TranslationVariant ;
:text "semuanya, berbuat salah adalah hal bersama;"^^xsd:string ;
:relatedTo :Line_1024 .

:TV_Line_1025_ID a :TranslationVariant ;
:text "tetapi ketika ia bersalah, orang itu tidak lagi menjadi pria"^^xsd:string ;
:relatedTo :Line_1025 .

:TV_Line_1026_ID a :TranslationVariant ;
:text "tak berakal atau celaka, siapa pun yang ke dalam keburukan"^^xsd:string ;
:relatedTo :Line_1026 .

:TV_Line_1027_ID a :TranslationVariant ;
:text "telah jatuh, lalu memperbaikinya dan tidak tetap tak bergerak;"^^xsd:string ;
:relatedTo :Line_1027 .

:TV_Line_1028_ID a :TranslationVariant ;
:text "keras kepala, ketahuilah, menanggung tuduhan kebodohan."^^xsd:string ;
:relatedTo :Line_1028 .

:TV_Line_1029_ID a :TranslationVariant ;
:text "Tetapi mengalahlah kepada yang mati, jangan menusuk yang telah binasa;"^^xsd:string ;
:relatedTo :Line_1029 .

:TV_Line_1030_ID a :TranslationVariant ;
:text "keberanian apa yang ada dalam membunuh lagi orang yang sudah mati?"^^xsd:string ;
:relatedTo :Line_1030 .

:TV_Line_1031_ID a :TranslationVariant ;
:text "Karena berpikir baik bagimu, aku berkata baik; dan belajar"^^xsd:string ;
:relatedTo :Line_1031 .

:TV_Line_1032_ID a :TranslationVariant ;
:text "dari orang yang berkata baik adalah paling manis, jika membawa keuntungan."^^xsd:string ;
:relatedTo :Line_1032 .
