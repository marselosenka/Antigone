@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1244-1276-italian a owl:Ontology .
# Italian translation variants for 1244_to_1276.ttl

:TV_Line_1244_IT a :TranslationVariant ;
:text "Che cosa potresti congetturare da ciò? La donna di nuovo"^^xsd:string ;
:relatedTo :Line_1244 .

:TV_Line_1245_IT a :TranslationVariant ;
:text "se n’è andata, prima di dire una parola buona o cattiva."^^xsd:string ;
:relatedTo :Line_1245 .

:TV_Line_1246_IT a :TranslationVariant ;
:text "Anch’io sono stupito; ma mi nutro di speranze"^^xsd:string ;
:relatedTo :Line_1246 .

:TV_Line_1247_IT a :TranslationVariant ;
:text "che, avendo udito i dolori del figlio, non ritenga degno"^^xsd:string ;
:relatedTo :Line_1247 .

:TV_Line_1248_IT a :TranslationVariant ;
:text "levare lamento in città, ma dentro, sotto il tetto,"^^xsd:string ;
:relatedTo :Line_1248 .

:TV_Line_1249_IT a :TranslationVariant ;
:text "affiderà alle serve il lutto domestico da gemere."^^xsd:string ;
:relatedTo :Line_1249 .

:TV_Line_1250_IT a :TranslationVariant ;
:text "Non è infatti inesperta di giudizio, così da sbagliare."^^xsd:string ;
:relatedTo :Line_1250 .

:TV_Line_1251_IT a :TranslationVariant ;
:text "Non lo so; a me tuttavia sia il silenzio eccessivo"^^xsd:string ;
:relatedTo :Line_1251 .

:TV_Line_1252_IT a :TranslationVariant ;
:text "sembra pesante, sia il molto grido vano."^^xsd:string ;
:relatedTo :Line_1252 .

:TV_Line_1253_IT a :TranslationVariant ;
:text "Ma sapremo se forse qualcosa di trattenuto"^^xsd:string ;
:relatedTo :Line_1253 .

:TV_Line_1254_IT a :TranslationVariant ;
:text "nasconde in segreto nel cuore adirato,"^^xsd:string ;
:relatedTo :Line_1254 .

:TV_Line_1255_IT a :TranslationVariant ;
:text "andando verso la casa; infatti dici bene:"^^xsd:string ;
:relatedTo :Line_1255 .

:TV_Line_1256_IT a :TranslationVariant ;
:text "anche del troppo silenzio c’è da qualche parte un peso."^^xsd:string ;
:relatedTo :Line_1256 .

:TV_Line_1257_IT a :TranslationVariant ;
:text "Ed ecco, questo signore in persona arriva,"^^xsd:string ;
:relatedTo :Line_1257 .

:TV_Line_1258_IT a :TranslationVariant ;
:text "tenendo tra le mani un segno manifesto,"^^xsd:string ;
:relatedTo :Line_1258 .

:TV_Line_1259_IT a :TranslationVariant ;
:text "se è lecito dirlo, non una rovina altrui,"^^xsd:string ;
:relatedTo :Line_1259 .

:TV_Line_1260_IT a :TranslationVariant ;
:text "ma avendo egli stesso errato."^^xsd:string ;
:relatedTo :Line_1260 .

:TV_Line_1261_IT a :TranslationVariant ;
:text "Io, errori di menti dissennate,"^^xsd:string ;
:relatedTo :Line_1261 .

:TV_Line_1262_IT a :TranslationVariant ;
:text "duri e mortali,"^^xsd:string ;
:relatedTo :Line_1262 .

:TV_Line_1263_IT a :TranslationVariant ;
:text "o voi che guardate uccisori"^^xsd:string ;
:relatedTo :Line_1263 .

:TV_Line_1264_IT a :TranslationVariant ;
:text "e morti dello stesso sangue."^^xsd:string ;
:relatedTo :Line_1264 .

:TV_Line_1265_IT a :TranslationVariant ;
:text "Ahimè, sventurate le mie decisioni."^^xsd:string ;
:relatedTo :Line_1265 .

:TV_Line_1266_IT a :TranslationVariant ;
:text "Io, figlio, giovane con giovane sorte,"^^xsd:string ;
:relatedTo :Line_1266 .

:TV_Line_1267_IT a :TranslationVariant ;
:text "ahimè, ahimè,"^^xsd:string ;
:relatedTo :Line_1267 .

:TV_Line_1268_IT a :TranslationVariant ;
:text "sei morto, sei stato sciolto,"^^xsd:string ;
:relatedTo :Line_1268 .

:TV_Line_1269_IT a :TranslationVariant ;
:text "per le mie, non per le tue, cattive decisioni."^^xsd:string ;
:relatedTo :Line_1269 .

:TV_Line_1270_IT a :TranslationVariant ;
:text "Ahimè, come sembri vedere tardi la giustizia."^^xsd:string ;
:relatedTo :Line_1270 .

:TV_Line_1271_IT a :TranslationVariant ;
:text "Ahimè,"^^xsd:string ;
:relatedTo :Line_1271 .

:TV_Line_1272_IT a :TranslationVariant ;
:text "lo so, avendolo imparato, misero; e sul mio capo"^^xsd:string ;
:relatedTo :Line_1272 .

:TV_Line_1273_IT a :TranslationVariant ;
:text "un dio allora, proprio allora, avendo grande peso su di me,"^^xsd:string ;
:relatedTo :Line_1273 .

:TV_Line_1274_IT a :TranslationVariant ;
:text "mi colpì, e mi scosse su vie selvagge,"^^xsd:string ;
:relatedTo :Line_1274 .

:TV_Line_1275_IT a :TranslationVariant ;
:text "ahimè, rovesciando la gioia calpestata."^^xsd:string ;
:relatedTo :Line_1275 .

:TV_Line_1276_IT a :TranslationVariant ;
:text "Ah, ah, dolori dei mortali difficili da sopportare."^^xsd:string ;
:relatedTo :Line_1276 .
