@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1155-1182-greek a owl:Ontology .

:TV_Line_1155_GR a :TranslationVariant ;
    :text "Κάτοικοι της γης του Κάδμου και των σπιτιών του Αμφίονα,"^^xsd:string ;
    :relatedTo :Line_1155 .

:TV_Line_1156_GR a :TranslationVariant ;
    :text "δεν υπάρχει ανθρώπινη ζωή που, όσο στέκει,"^^xsd:string ;
    :relatedTo :Line_1156 .

:TV_Line_1157_GR a :TranslationVariant ;
    :text "θα μπορούσα ποτέ ούτε να την παινέσω ούτε να την κατηγορήσω."^^xsd:string ;
    :relatedTo :Line_1157 .

:TV_Line_1158_GR a :TranslationVariant ;
    :text "Γιατί η τύχη σηκώνει όρθιο τον άνθρωπο και η τύχη τον γκρεμίζει"^^xsd:string ;
    :relatedTo :Line_1158 .

:TV_Line_1159_GR a :TranslationVariant ;
    :text "και τον ευτυχισμένο και τον δυστυχισμένο, πάντα."^^xsd:string ;
    :relatedTo :Line_1159 .

:TV_Line_1160_GR a :TranslationVariant ;
    :text "Και κανένας μάντης δεν γνωρίζει τι είναι ορισμένο για τους θνητούς."^^xsd:string ;
    :relatedTo :Line_1160 .

:TV_Line_1161_GR a :TranslationVariant ;
    :text "Γιατί ο Κρέοντας κάποτε ήταν αξιοζήλευτος, όπως μου φαινόταν,"^^xsd:string ;
    :relatedTo :Line_1161 .

:TV_Line_1162_GR a :TranslationVariant ;
    :text "αφού έσωσε αυτήν εδώ τη γη των Καδμείων από τους εχθρούς,"^^xsd:string ;
    :relatedTo :Line_1162 .

:TV_Line_1163_GR a :TranslationVariant ;
    :text "και παίρνοντας την απόλυτη εξουσία της χώρας,"^^xsd:string ;
    :relatedTo :Line_1163 .

:TV_Line_1164_GR a :TranslationVariant ;
    :text "την κυβερνούσε, ανθίζοντας με ευγενική γενιά παιδιών."^^xsd:string ;
    :relatedTo :Line_1164 .

:TV_Line_1165_GR a :TranslationVariant ;
    :text "Και τώρα όλα χάθηκαν. Γιατί όταν οι άνθρωποι χάσουν"^^xsd:string ;
    :relatedTo :Line_1165 .

:TV_Line_1166_GR a :TranslationVariant ;
    :text "τις χαρές τους, εγώ δεν θεωρώ έναν τέτοιο άνθρωπο"^^xsd:string ;
    :relatedTo :Line_1166 .

:TV_Line_1167_GR a :TranslationVariant ;
    :text "ζωντανό, αλλά τον λογαριάζω για νεκρό που ακόμα αναπνέει."^^xsd:string ;
    :relatedTo :Line_1167 .

:TV_Line_1168_GR a :TranslationVariant ;
    :text "Ας έχει μεγάλα πλούτη στο σπίτι του, αν θέλεις,"^^xsd:string ;
    :relatedTo :Line_1168 .

:TV_Line_1169_GR a :TranslationVariant ;
    :text "και ας ζει έχοντας την όψη βασιλιά· αν όμως λείπει"^^xsd:string ;
    :relatedTo :Line_1169 .

:TV_Line_1170_GR a :TranslationVariant ;
    :text "η χαρά από αυτά, όλα τα άλλα δεν θα τα αγόραζα"^^xsd:string ;
    :relatedTo :Line_1170 .

:TV_Line_1171_GR a :TranslationVariant ;
    :text "από κανέναν άνθρωπο ούτε για σκιά καπνού, μπροστά στην ευτυχία."^^xsd:string ;
    :relatedTo :Line_1171 .

:TV_Line_1172_GR a :TranslationVariant ;
    :text "Τι βάρος συμφοράς για το βασιλικό σπίτι φέρνεις τώρα;"^^xsd:string ;
    :relatedTo :Line_1172 .

:TV_Line_1173_GR a :TranslationVariant ;
    :text "Είναι νεκροί· και οι ζωντανοί είναι αίτιοι για τον θάνατό τους."^^xsd:string ;
    :relatedTo :Line_1173 .

:TV_Line_1174_GR a :TranslationVariant ;
    :text "Και ποιος σκότωσε; Ποιος είναι ο νεκρός; Μίλα."^^xsd:string ;
    :relatedTo :Line_1174 .

:TV_Line_1175_GR a :TranslationVariant ;
    :text "Ο Αίμων χάθηκε· το ίδιο του το χέρι τον μάτωσε."^^xsd:string ;
    :relatedTo :Line_1175 .

:TV_Line_1176_GR a :TranslationVariant ;
    :text "Από το χέρι του πατέρα του ή από το δικό του;"^^xsd:string ;
    :relatedTo :Line_1176 .

:TV_Line_1177_GR a :TranslationVariant ;
    :text "Από το δικό του, οργισμένος με τον πατέρα του για τον φόνο."^^xsd:string ;
    :relatedTo :Line_1177 .

:TV_Line_1178_GR a :TranslationVariant ;
    :text "Ω μάντη, πόσο σωστά βγήκε ο λόγος σου."^^xsd:string ;
    :relatedTo :Line_1178 .

:TV_Line_1179_GR a :TranslationVariant ;
    :text "Αφού έτσι έχουν τα πράγματα, τώρα πρέπει να σκεφτούμε τα υπόλοιπα."^^xsd:string ;
    :relatedTo :Line_1179 .

:TV_Line_1180_GR a :TranslationVariant ;
    :text "Και τώρα βλέπω την άμοιρη Ευρυδίκη εδώ κοντά,"^^xsd:string ;
    :relatedTo :Line_1180 .

:TV_Line_1181_GR a :TranslationVariant ;
    :text "τη γυναίκα του Κρέοντα, να βγαίνει από το παλάτι,"^^xsd:string ;
    :relatedTo :Line_1181 .

:TV_Line_1182_GR a :TranslationVariant ;
    :text "είτε επειδή άκουσε για τον γιο της είτε από τύχη."^^xsd:string ;
    :relatedTo :Line_1182 .