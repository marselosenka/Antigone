@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1244-1276-portuguese a owl:Ontology .
# Portuguese translation variants for 1244_to_1276.ttl

:TV_Line_1244_PT a :TranslationVariant ;
:text "Que poderias conjecturar disto? A mulher de novo"^^xsd:string ;
:relatedTo :Line_1244 .

:TV_Line_1245_PT a :TranslationVariant ;
:text "partiu, antes de dizer palavra boa ou má."^^xsd:string ;
:relatedTo :Line_1245 .

:TV_Line_1246_PT a :TranslationVariant ;
:text "Eu mesmo estou assombrado; mas alimento-me de esperanças"^^xsd:string ;
:relatedTo :Line_1246 .

:TV_Line_1247_PT a :TranslationVariant ;
:text "de que, ouvindo as dores do filho, ao lamento da cidade,"^^xsd:string ;
:relatedTo :Line_1247 .

:TV_Line_1248_PT a :TranslationVariant ;
:text "não julgará digno fazê-lo, mas dentro, sob o teto,"^^xsd:string ;
:relatedTo :Line_1248 .

:TV_Line_1249_PT a :TranslationVariant ;
:text "ordenará às servas gemerem o luto doméstico."^^xsd:string ;
:relatedTo :Line_1249 .

:TV_Line_1250_PT a :TranslationVariant ;
:text "Pois não é inexperiente de juízo, a ponto de errar."^^xsd:string ;
:relatedTo :Line_1250 .

:TV_Line_1251_PT a :TranslationVariant ;
:text "Não sei; para mim, porém, o silêncio excessivo"^^xsd:string ;
:relatedTo :Line_1251 .

:TV_Line_1252_PT a :TranslationVariant ;
:text "parece pesar tanto quanto o muito grito em vão."^^xsd:string ;
:relatedTo :Line_1252 .

:TV_Line_1253_PT a :TranslationVariant ;
:text "Mas saberemos se algo incontido"^^xsd:string ;
:relatedTo :Line_1253 .

:TV_Line_1254_PT a :TranslationVariant ;
:text "ela encobre em segredo no coração irritado,"^^xsd:string ;
:relatedTo :Line_1254 .

:TV_Line_1255_PT a :TranslationVariant ;
:text "indo até a casa; pois, sim, falas bem:"^^xsd:string ;
:relatedTo :Line_1255 .

:TV_Line_1256_PT a :TranslationVariant ;
:text "também do silêncio excessivo há, em algum lugar, peso."^^xsd:string ;
:relatedTo :Line_1256 .

:TV_Line_1257_PT a :TranslationVariant ;
:text "E na verdade este próprio senhor se aproxima,"^^xsd:string ;
:relatedTo :Line_1257 .

:TV_Line_1258_PT a :TranslationVariant ;
:text "tendo nas mãos um memorial evidente,"^^xsd:string ;
:relatedTo :Line_1258 .

:TV_Line_1259_PT a :TranslationVariant ;
:text "se é lícito dizer, uma ruína não alheia,"^^xsd:string ;
:relatedTo :Line_1259 .

:TV_Line_1260_PT a :TranslationVariant ;
:text "mas ele próprio tendo errado."^^xsd:string ;
:relatedTo :Line_1260 .

:TV_Line_1261_PT a :TranslationVariant ;
:text "Ai, erros de pensamentos insensatos,"^^xsd:string ;
:relatedTo :Line_1261 .

:TV_Line_1262_PT a :TranslationVariant ;
:text "duros, mortíferos,"^^xsd:string ;
:relatedTo :Line_1262 .

:TV_Line_1263_PT a :TranslationVariant ;
:text "ó vós que vedes os que mataram e"^^xsd:string ;
:relatedTo :Line_1263 .

:TV_Line_1264_PT a :TranslationVariant ;
:text "os que morreram, de mesma estirpe."^^xsd:string ;
:relatedTo :Line_1264 .

:TV_Line_1265_PT a :TranslationVariant ;
:text "Ai de mim, infelizes minhas deliberações."^^xsd:string ;
:relatedTo :Line_1265 .

:TV_Line_1266_PT a :TranslationVariant ;
:text "Ai, filho, jovem com jovem destino,"^^xsd:string ;
:relatedTo :Line_1266 .

:TV_Line_1267_PT a :TranslationVariant ;
:text "ai, ai,"^^xsd:string ;
:relatedTo :Line_1267 .

:TV_Line_1268_PT a :TranslationVariant ;
:text "morreste, foste libertado,"^^xsd:string ;
:relatedTo :Line_1268 .

:TV_Line_1269_PT a :TranslationVariant ;
:text "por minhas más deliberações, não pelas tuas."^^xsd:string ;
:relatedTo :Line_1269 .

:TV_Line_1270_PT a :TranslationVariant ;
:text "Ai de mim, como pareces ter visto a justiça tarde."^^xsd:string ;
:relatedTo :Line_1270 .

:TV_Line_1271_PT a :TranslationVariant ;
:text "Ai de mim,"^^xsd:string ;
:relatedTo :Line_1271 .

:TV_Line_1272_PT a :TranslationVariant ;
:text "tenho aprendido, miserável; e sobre minha cabeça"^^xsd:string ;
:relatedTo :Line_1272 .

:TV_Line_1273_PT a :TranslationVariant ;
:text "um deus então, sim então, tendo-me com grande peso,"^^xsd:string ;
:relatedTo :Line_1273 .

:TV_Line_1274_PT a :TranslationVariant ;
:text "golpeou-me, e lançou-me em caminhos selvagens,"^^xsd:string ;
:relatedTo :Line_1274 .

:TV_Line_1275_PT a :TranslationVariant ;
:text "ai de mim, derrubando minha alegria pisoteada."^^xsd:string ;
:relatedTo :Line_1275 .

:TV_Line_1276_PT a :TranslationVariant ;
:text "Ai, ai, ó labores difíceis dos mortais."^^xsd:string ;
:relatedTo :Line_1276 .
