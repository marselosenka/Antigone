@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1155-1182-portuguese a owl:Ontology .
# Portuguese translation variants for 1155_to_1182.ttl

:TV_Line_1155_PT a :TranslationVariant ;
:text "Vizinhos de Cadmo e das casas de Anfião,"^^xsd:string ;
:relatedTo :Line_1155 .

:TV_Line_1156_PT a :TranslationVariant ;
:text "não há estado algum da vida humana que eu,"^^xsd:string ;
:relatedTo :Line_1156 .

:TV_Line_1157_PT a :TranslationVariant ;
:text "vendo-o firme, pudesse jamais louvar ou censurar."^^xsd:string ;
:relatedTo :Line_1157 .

:TV_Line_1158_PT a :TranslationVariant ;
:text "Pois a sorte ergue, e a sorte derruba"^^xsd:string ;
:relatedTo :Line_1158 .

:TV_Line_1159_PT a :TranslationVariant ;
:text "o afortunado e o desgraçado, sempre;"^^xsd:string ;
:relatedTo :Line_1159 .

:TV_Line_1160_PT a :TranslationVariant ;
:text "e nenhum adivinho há das coisas estabelecidas para os mortais."^^xsd:string ;
:relatedTo :Line_1160 .

:TV_Line_1161_PT a :TranslationVariant ;
:text "Pois Creonte era invejável, ao menos para mim, outrora,"^^xsd:string ;
:relatedTo :Line_1161 .

:TV_Line_1162_PT a :TranslationVariant ;
:text "tendo salvado esta terra cadmeia dos inimigos"^^xsd:string ;
:relatedTo :Line_1162 .

:TV_Line_1163_PT a :TranslationVariant ;
:text "e, tomando o poder único completo da região,"^^xsd:string ;
:relatedTo :Line_1163 .

:TV_Line_1164_PT a :TranslationVariant ;
:text "governava-a, florescendo em nobre semente de filhos;"^^xsd:string ;
:relatedTo :Line_1164 .

:TV_Line_1165_PT a :TranslationVariant ;
:text "e agora tudo se foi. Pois quando os homens traem"^^xsd:string ;
:relatedTo :Line_1165 .

:TV_Line_1166_PT a :TranslationVariant ;
:text "os prazeres, eu não considero esse homem"^^xsd:string ;
:relatedTo :Line_1166 .

:TV_Line_1167_PT a :TranslationVariant ;
:text "vivo, mas o julgo um morto animado."^^xsd:string ;
:relatedTo :Line_1167 .

:TV_Line_1168_PT a :TranslationVariant ;
:text "Pois enriquece em casa, se quiseres, grandemente,"^^xsd:string ;
:relatedTo :Line_1168 .

:TV_Line_1169_PT a :TranslationVariant ;
:text "e vive tendo aparência de tirano; mas se faltar"^^xsd:string ;
:relatedTo :Line_1169 .

:TV_Line_1170_PT a :TranslationVariant ;
:text "a alegria dessas coisas, o resto eu, por sombra de fumaça,"^^xsd:string ;
:relatedTo :Line_1170 .

:TV_Line_1171_PT a :TranslationVariant ;
:text "não compraria de homem algum em troca do prazer."^^xsd:string ;
:relatedTo :Line_1171 .

:TV_Line_1172_PT a :TranslationVariant ;
:text "Que peso dos reis vens trazendo agora?"^^xsd:string ;
:relatedTo :Line_1172 .

:TV_Line_1173_PT a :TranslationVariant ;
:text "Morreram; e os vivos são culpados da morte."^^xsd:string ;
:relatedTo :Line_1173 .

:TV_Line_1174_PT a :TranslationVariant ;
:text "E quem mata? E quem jaz morto? Fala."^^xsd:string ;
:relatedTo :Line_1174 .

:TV_Line_1175_PT a :TranslationVariant ;
:text "Hêmon pereceu; por sua própria mão ensanguenta-se."^^xsd:string ;
:relatedTo :Line_1175 .

:TV_Line_1176_PT a :TranslationVariant ;
:text "Por mão paterna ou pela própria?"^^xsd:string ;
:relatedTo :Line_1176 .

:TV_Line_1177_PT a :TranslationVariant ;
:text "Por si mesmo, irado contra o pai pelo assassínio."^^xsd:string ;
:relatedTo :Line_1177 .

:TV_Line_1178_PT a :TranslationVariant ;
:text "Ó adivinho, como cumpriste correta a palavra."^^xsd:string ;
:relatedTo :Line_1178 .

:TV_Line_1179_PT a :TranslationVariant ;
:text "Como estas coisas assim estão, resta deliberar sobre o restante."^^xsd:string ;
:relatedTo :Line_1179 .

:TV_Line_1180_PT a :TranslationVariant ;
:text "E na verdade vejo a infeliz Eurídice ao mesmo tempo,"^^xsd:string ;
:relatedTo :Line_1180 .

:TV_Line_1181_PT a :TranslationVariant ;
:text "a esposa de Creonte; e dos palácios"^^xsd:string ;
:relatedTo :Line_1181 .

:TV_Line_1182_PT a :TranslationVariant ;
:text "vem, ou por ouvir do filho, ou por acaso."^^xsd:string ;
:relatedTo :Line_1182 .
