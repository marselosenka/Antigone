@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1244-1276-bengali a owl:Ontology .
# Bengali translation variants for 1244_to_1276.ttl

:TV_Line_1244_BN a :TranslationVariant ;
:text "কোরাস: এ থেকে তুমি কী অনুমান করবে? নারীটি আবার"^^xsd:string ;
:relatedTo :Line_1244 .

:TV_Line_1245_BN a :TranslationVariant ;
:text "চলে গেল, ভালো বা মন্দ কোনো কথা বলার আগেই।"^^xsd:string ;
:relatedTo :Line_1245 .

:TV_Line_1246_BN a :TranslationVariant ;
:text "দূত: আমিও বিস্মিত; তবু আশা পোষণ করছি"^^xsd:string ;
:relatedTo :Line_1246 .

:TV_Line_1247_BN a :TranslationVariant ;
:text "পুত্রের দুঃখ শুনে নগরে প্রকাশ্য বিলাপকে"^^xsd:string ;
:relatedTo :Line_1247 .

:TV_Line_1248_BN a :TranslationVariant ;
:text "সে উপযুক্ত মনে করবে না, বরং গৃহের ভেতরে"^^xsd:string ;
:relatedTo :Line_1248 .

:TV_Line_1249_BN a :TranslationVariant ;
:text "দাসীদের সামনে পারিবারিক শোক বিলাপের জন্য রাখবে।"^^xsd:string ;
:relatedTo :Line_1249 .

:TV_Line_1250_BN a :TranslationVariant ;
:text "কারণ সে বিচারবোধে অনভিজ্ঞ নয়, যাতে ভুল করে।"^^xsd:string ;
:relatedTo :Line_1250 .

:TV_Line_1251_BN a :TranslationVariant ;
:text "কোরাস: জানি না; তবে আমার কাছে অতিরিক্ত নীরবতা"^^xsd:string ;
:relatedTo :Line_1251 .

:TV_Line_1252_BN a :TranslationVariant ;
:text "ব্যর্থ উচ্চ চিৎকারের চেয়ে কম ভারী বলে মনে হয় না।"^^xsd:string ;
:relatedTo :Line_1252 .

:TV_Line_1253_BN a :TranslationVariant ;
:text "দূত: তবে আমরা জানতে পারব, সে কি কোনো অসংযত জিনিস"^^xsd:string ;
:relatedTo :Line_1253 .

:TV_Line_1254_BN a :TranslationVariant ;
:text "গোপন ক্রুদ্ধ হৃদয়ে আড়াল করে রাখছে,"^^xsd:string ;
:relatedTo :Line_1254 .

:TV_Line_1255_BN a :TranslationVariant ;
:text "গৃহের দিকে এগিয়ে গিয়ে; কারণ তুমি নিশ্চয়ই ভালো বলছ;"^^xsd:string ;
:relatedTo :Line_1255 .

:TV_Line_1256_BN a :TranslationVariant ;
:text "অতিরিক্ত নীরবতারও কোথাও এক ভার আছে।"^^xsd:string ;
:relatedTo :Line_1256 .

:TV_Line_1257_BN a :TranslationVariant ;
:text "কোরাস: আর দেখো, রাজা নিজেই এখানে এসে পৌঁছেছেন,"^^xsd:string ;
:relatedTo :Line_1257 .

:TV_Line_1258_BN a :TranslationVariant ;
:text "হাতে ধরে এনেছেন স্পষ্ট স্মারক,"^^xsd:string ;
:relatedTo :Line_1258 .

:TV_Line_1259_BN a :TranslationVariant ;
:text "যদি বলা বিধিসম্মত হয়, অন্যের নয়"^^xsd:string ;
:relatedTo :Line_1259 .

:TV_Line_1260_BN a :TranslationVariant ;
:text "নিজের ভুলে আনা বিপর্যয়।"^^xsd:string ;
:relatedTo :Line_1260 .

:TV_Line_1261_BN a :TranslationVariant ;
:text "ক্রেয়োন: হায়, বিভ্রান্ত মনের ভুলগুলি,"^^xsd:string ;
:relatedTo :Line_1261 .

:TV_Line_1262_BN a :TranslationVariant ;
:text "কঠিন, মৃত্যুময়,"^^xsd:string ;
:relatedTo :Line_1262 .

:TV_Line_1263_BN a :TranslationVariant ;
:text "হে হত্যাকারী ও"^^xsd:string ;
:relatedTo :Line_1263 .

:TV_Line_1264_BN a :TranslationVariant ;
:text "নিহত আত্মীয়দের দেখছ যারা।"^^xsd:string ;
:relatedTo :Line_1264 .

:TV_Line_1265_BN a :TranslationVariant ;
:text "হায়, আমার অকল্যাণকর পরামর্শগুলি!"^^xsd:string ;
:relatedTo :Line_1265 .

:TV_Line_1266_BN a :TranslationVariant ;
:text "হে পুত্র, তরুণ, তরুণ মৃত্যুর সঙ্গে,"^^xsd:string ;
:relatedTo :Line_1266 .

:TV_Line_1267_BN a :TranslationVariant ;
:text "হায় হায়, হায় হায়,"^^xsd:string ;
:relatedTo :Line_1267 .

:TV_Line_1268_BN a :TranslationVariant ;
:text "তুমি মরেছ, মুক্ত হয়েছ,"^^xsd:string ;
:relatedTo :Line_1268 .

:TV_Line_1269_BN a :TranslationVariant ;
:text "আমার কুপরামর্শে, তোমার নয়।"^^xsd:string ;
:relatedTo :Line_1269 .

:TV_Line_1270_BN a :TranslationVariant ;
:text "কোরাস: হায়, মনে হয় তুমি দেরিতে ন্যায় দেখেছ।"^^xsd:string ;
:relatedTo :Line_1270 .

:TV_Line_1271_BN a :TranslationVariant ;
:text "ক্রেয়োন: হায়,"^^xsd:string ;
:relatedTo :Line_1271 .

:TV_Line_1272_BN a :TranslationVariant ;
:text "হতভাগা আমি শিখে নিয়েছি; আর আমার মাথায়"^^xsd:string ;
:relatedTo :Line_1272 .

:TV_Line_1273_BN a :TranslationVariant ;
:text "এক দেবতা তখন, হ্যাঁ তখন, আমাকে ধরে বড় ভারে"^^xsd:string ;
:relatedTo :Line_1273 .

:TV_Line_1274_BN a :TranslationVariant ;
:text "আঘাত করলেন, আর বন্য পথে ঝাঁকিয়ে দিলেন,"^^xsd:string ;
:relatedTo :Line_1274 .

:TV_Line_1275_BN a :TranslationVariant ;
:text "হায়, পদদলিত আনন্দ উল্টে দিয়ে।"^^xsd:string ;
:relatedTo :Line_1275 .

:TV_Line_1276_BN a :TranslationVariant ;
:text "হায় হায়, মর্ত্যদের দুঃসহ কষ্টগুলি।"^^xsd:string ;
:relatedTo :Line_1276 .
