@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1244-1276-arabic a owl:Ontology .
# Arabic translation variants for 1244_to_1276.ttl

:TV_Line_1244_AR a :TranslationVariant ;
:text "بماذا تظن هذا؟ إن المرأة ثانيةً"^^xsd:string ;
:relatedTo :Line_1244 .

:TV_Line_1245_AR a :TranslationVariant ;
:text "قد مضت، قبل أن تقول كلمة صالحة أو سيئة."^^xsd:string ;
:relatedTo :Line_1245 .

:TV_Line_1246_AR a :TranslationVariant ;
:text "أنا أيضًا دهشت؛ ولكني أغذي نفسي بالآمال"^^xsd:string ;
:relatedTo :Line_1246 .

:TV_Line_1247_AR a :TranslationVariant ;
:text "أنها، إذ سمعت آلام ابنها، لن ترى من اللائق"^^xsd:string ;
:relatedTo :Line_1247 .

:TV_Line_1248_AR a :TranslationVariant ;
:text "أن ترفع نواحًا إلى المدينة، بل داخل السقف"^^xsd:string ;
:relatedTo :Line_1248 .

:TV_Line_1249_AR a :TranslationVariant ;
:text "ستأمر الخادمات أن يندبن حزن البيت."^^xsd:string ;
:relatedTo :Line_1249 .

:TV_Line_1250_AR a :TranslationVariant ;
:text "فهي ليست بلا معرفة حتى تخطئ."^^xsd:string ;
:relatedTo :Line_1250 .

:TV_Line_1251_AR a :TranslationVariant ;
:text "لا أعلم؛ لكن في رأيي، إن الصمت المفرط"^^xsd:string ;
:relatedTo :Line_1251 .

:TV_Line_1252_AR a :TranslationVariant ;
:text "يبدو ثقيلًا، وكذلك كثرة الصراخ الباطل."^^xsd:string ;
:relatedTo :Line_1252 .

:TV_Line_1253_AR a :TranslationVariant ;
:text "إذن سنعلم هل تخفي شيئًا مكبوحًا"^^xsd:string ;
:relatedTo :Line_1253 .

:TV_Line_1254_AR a :TranslationVariant ;
:text "في قلبها الخفي، وهي غاضبة،"^^xsd:string ;
:relatedTo :Line_1254 .

:TV_Line_1255_AR a :TranslationVariant ;
:text "حين نمضي إلى البيوت؛ فإنك حقًا تقول حسنًا،"^^xsd:string ;
:relatedTo :Line_1255 .

:TV_Line_1256_AR a :TranslationVariant ;
:text "فللصمت المفرط أيضًا ثقل ما."^^xsd:string ;
:relatedTo :Line_1256 .

:TV_Line_1257_AR a :TranslationVariant ;
:text "وها هو الملك نفسه قد أقبل،"^^xsd:string ;
:relatedTo :Line_1257 .

:TV_Line_1258_AR a :TranslationVariant ;
:text "حاملًا بيده ذكرى ظاهرة،"^^xsd:string ;
:relatedTo :Line_1258 .

:TV_Line_1259_AR a :TranslationVariant ;
:text "إن جاز القول، لا كارثة غريبة،"^^xsd:string ;
:relatedTo :Line_1259 .

:TV_Line_1260_AR a :TranslationVariant ;
:text "بل هو نفسه أخطأ."^^xsd:string ;
:relatedTo :Line_1260 .

:TV_Line_1261_AR a :TranslationVariant ;
:text "آه، أخطاء العقول سيئة الرأي،"^^xsd:string ;
:relatedTo :Line_1261 .

:TV_Line_1262_AR a :TranslationVariant ;
:text "صلبة قاتلة،"^^xsd:string ;
:relatedTo :Line_1262 .

:TV_Line_1263_AR a :TranslationVariant ;
:text "يا من تنظرون إلى القاتلين"^^xsd:string ;
:relatedTo :Line_1263 .

:TV_Line_1264_AR a :TranslationVariant ;
:text "والمقتولين من الدم نفسه."^^xsd:string ;
:relatedTo :Line_1264 .

:TV_Line_1265_AR a :TranslationVariant ;
:text "وا حسرتاه على مشوراتي المنكودة."^^xsd:string ;
:relatedTo :Line_1265 .

:TV_Line_1266_AR a :TranslationVariant ;
:text "آه يا بني، يا شابًا مع مصير شاب،"^^xsd:string ;
:relatedTo :Line_1266 .

:TV_Line_1267_AR a :TranslationVariant ;
:text "آه آه،"^^xsd:string ;
:relatedTo :Line_1267 .

:TV_Line_1268_AR a :TranslationVariant ;
:text "لقد متّ، وانفلتّ،"^^xsd:string ;
:relatedTo :Line_1268 .

:TV_Line_1269_AR a :TranslationVariant ;
:text "بسبب سوء رأيي أنا لا سوء رأيك أنت."^^xsd:string ;
:relatedTo :Line_1269 .

:TV_Line_1270_AR a :TranslationVariant ;
:text "واحسرتاه، كأنك رأيت العدل متأخرًا."^^xsd:string ;
:relatedTo :Line_1270 .

:TV_Line_1271_AR a :TranslationVariant ;
:text "واحسرتاه،"^^xsd:string ;
:relatedTo :Line_1271 .

:TV_Line_1272_AR a :TranslationVariant ;
:text "لقد عرفت وأنا شقي؛ وفي رأسي"^^xsd:string ;
:relatedTo :Line_1272 .

:TV_Line_1273_AR a :TranslationVariant ;
:text "إله، عندئذ، نعم عندئذ، وقد أمسك بي بثقل عظيم،"^^xsd:string ;
:relatedTo :Line_1273 .

:TV_Line_1274_AR a :TranslationVariant ;
:text "ضربني، وزلزلني في طرق وحشية،"^^xsd:string ;
:relatedTo :Line_1274 .

:TV_Line_1275_AR a :TranslationVariant ;
:text "واحسرتاه، مقلّبًا فرحي المدوس."^^xsd:string ;
:relatedTo :Line_1275 .

:TV_Line_1276_AR a :TranslationVariant ;
:text "واهًا واهًا، يا آلام البشر الشاقة."^^xsd:string ;
:relatedTo :Line_1276 .
