@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1244-1276-spanish a owl:Ontology .
# Spanish translation variants for 1244_to_1276.ttl

:TV_Line_1244_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1244 ; :text "¿Qué podrías conjeturar de esto? La mujer de nuevo"^^xsd:string .
:TV_Line_1245_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1245 ; :text "se ha ido, antes de decir palabra buena o mala."^^xsd:string .
:TV_Line_1246_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1246 ; :text "También yo estoy asombrado; pero alimento la esperanza"^^xsd:string .
:TV_Line_1247_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1247 ; :text "de que, al oír los dolores de su hijo, no considere digno"^^xsd:string .
:TV_Line_1248_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1248 ; :text "entregarlos al lamento de la ciudad, sino que dentro, bajo techo,"^^xsd:string .
:TV_Line_1249_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1249 ; :text "ordenará a las esclavas gemir el duelo de la casa."^^xsd:string .
:TV_Line_1250_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1250 ; :text "Pues no carece de juicio como para equivocarse."^^xsd:string .
:TV_Line_1251_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1251 ; :text "No lo sé; pero a mí, en todo caso, el silencio excesivo"^^xsd:string .
:TV_Line_1252_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1252 ; :text "me parece cargar tanto peso como el mucho grito inútil."^^xsd:string .
:TV_Line_1253_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1253 ; :text "Entonces sabremos si quizá oculta algo incontenible"^^xsd:string .
:TV_Line_1254_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1254 ; :text "en secreto, en su corazón irritado,"^^xsd:string .
:TV_Line_1255_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1255 ; :text "al pasar junto a la casa; pues dices bien:"^^xsd:string .
:TV_Line_1256_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1256 ; :text "también en el silencio excesivo hay, en algún lugar, peso."^^xsd:string .
:TV_Line_1257_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1257 ; :text "Y he aquí que llega el propio señor,"^^xsd:string .
:TV_Line_1258_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1258 ; :text "trayendo en sus manos un testimonio manifiesto,"^^xsd:string .
:TV_Line_1259_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1259 ; :text "si es lícito decirlo, no de una ruina ajena,"^^xsd:string .
:TV_Line_1260_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1260 ; :text "sino de haber errado él mismo."^^xsd:string .
:TV_Line_1261_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1261 ; :text "Ay, errores de pensamientos insensatos,"^^xsd:string .
:TV_Line_1262_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1262 ; :text "duros y mortales,"^^xsd:string .
:TV_Line_1263_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1263 ; :text "vosotros que miráis a quienes mataron"^^xsd:string .
:TV_Line_1264_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1264 ; :text "y a quienes murieron dentro de la misma sangre."^^xsd:string .
:TV_Line_1265_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1265 ; :text "Ay de mis decisiones desdichadas."^^xsd:string .
:TV_Line_1266_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1266 ; :text "Ay, hijo, joven con un destino joven,"^^xsd:string .
:TV_Line_1267_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1267 ; :text "ay, ay,"^^xsd:string .
:TV_Line_1268_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1268 ; :text "has muerto, te has liberado,"^^xsd:string .
:TV_Line_1269_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1269 ; :text "por mis malos consejos, no por los tuyos."^^xsd:string .
:TV_Line_1270_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1270 ; :text "Ay, parece que has visto la justicia demasiado tarde."^^xsd:string .
:TV_Line_1271_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1271 ; :text "¡Ay de mí!"^^xsd:string .
:TV_Line_1272_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1272 ; :text "He aprendido, desdichado; y sobre mi cabeza"^^xsd:string .
:TV_Line_1273_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1273 ; :text "un dios entonces, entonces, teniendo gran peso,"^^xsd:string .
:TV_Line_1274_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1274 ; :text "me golpeó y me sacudió por caminos salvajes,"^^xsd:string .
:TV_Line_1275_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1275 ; :text "ay, volcando mi alegría pisoteada."^^xsd:string .
:TV_Line_1276_ES a owl:NamedIndividual, :TranslationVariant ; :relatedTo :Line_1276 ; :text "Ay, ay, penas de los mortales, difíciles penas."^^xsd:string .
