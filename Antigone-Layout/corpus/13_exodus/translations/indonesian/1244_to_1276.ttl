@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1244-1276-indonesian a owl:Ontology .
# Indonesian translation variants for 1244_to_1276.ttl

:TV_Line_1244_ID a :TranslationVariant ;
:text "Bagaimana engkau menafsirkan ini? Perempuan itu kembali"^^xsd:string ;
:relatedTo :Line_1244 .

:TV_Line_1245_ID a :TranslationVariant ;
:text "telah pergi, sebelum mengucapkan kata baik ataupun buruk."^^xsd:string ;
:relatedTo :Line_1245 .

:TV_Line_1246_ID a :TranslationVariant ;
:text "Aku sendiri juga terheran; tetapi aku memberi makan harapan"^^xsd:string ;
:relatedTo :Line_1246 .

:TV_Line_1247_ID a :TranslationVariant ;
:text "bahwa setelah mendengar duka anaknya ketika datang ke kota,"^^xsd:string ;
:relatedTo :Line_1247 .

:TV_Line_1248_ID a :TranslationVariant ;
:text "ia tidak akan menganggap pantas ratapan keras,"^^xsd:string ;
:relatedTo :Line_1248 .

:TV_Line_1249_ID a :TranslationVariant ;
:text "melainkan di dalam rumah akan memerintahkan para pelayan meratapi duka keluarga."^^xsd:string ;
:relatedTo :Line_1249 .

:TV_Line_1250_ID a :TranslationVariant ;
:text "Sebab ia tidak asing dengan pertimbangan, sehingga akan tersesat."^^xsd:string ;
:relatedTo :Line_1250 .

:TV_Line_1251_ID a :TranslationVariant ;
:text "Aku tidak tahu; tetapi bagiku keheningan yang terlalu besar"^^xsd:string ;
:relatedTo :Line_1251 .

:TV_Line_1252_ID a :TranslationVariant ;
:text "tampak berat hadir, seperti juga banyak teriakan sia-sia."^^xsd:string ;
:relatedTo :Line_1252 .

:TV_Line_1253_ID a :TranslationVariant ;
:text "Tetapi kita akan tahu apakah sesuatu yang tak tertahan"^^xsd:string ;
:relatedTo :Line_1253 .

:TV_Line_1254_ID a :TranslationVariant ;
:text "ia sembunyikan dalam hati rahasia yang marah,"^^xsd:string ;
:relatedTo :Line_1254 .

:TV_Line_1255_ID a :TranslationVariant ;
:text "ketika kita berjalan menuju rumah; sebab engkau memang berkata benar:"^^xsd:string ;
:relatedTo :Line_1255 .

:TV_Line_1256_ID a :TranslationVariant ;
:text "sebab dalam keheningan yang terlalu besar pun ada suatu beban."^^xsd:string ;
:relatedTo :Line_1256 .

:TV_Line_1257_ID a :TranslationVariant ;
:text "Dan sungguh di sini raja sendiri datang,"^^xsd:string ;
:relatedTo :Line_1257 .

:TV_Line_1258_ID a :TranslationVariant ;
:text "memegang tanda kenangan yang jelas di tangannya,"^^xsd:string ;
:relatedTo :Line_1258 .

:TV_Line_1259_ID a :TranslationVariant ;
:text "jika boleh dikatakan, bukan bencana milik orang lain,"^^xsd:string ;
:relatedTo :Line_1259 .

:TV_Line_1260_ID a :TranslationVariant ;
:text "melainkan karena ia sendiri telah bersalah."^^xsd:string ;
:relatedTo :Line_1260 .

:TV_Line_1261_ID a :TranslationVariant ;
:text "Io, kesalahan-kesalahan pikiran yang berpikiran buruk,"^^xsd:string ;
:relatedTo :Line_1261 .

:TV_Line_1262_ID a :TranslationVariant ;
:text "keras dan mematikan,"^^xsd:string ;
:relatedTo :Line_1262 .

:TV_Line_1263_ID a :TranslationVariant ;
:text "wahai kalian yang melihat pembunuh"^^xsd:string ;
:relatedTo :Line_1263 .

:TV_Line_1264_ID a :TranslationVariant ;
:text "dan yang terbunuh dari keluarga sendiri."^^xsd:string ;
:relatedTo :Line_1264 .

:TV_Line_1265_ID a :TranslationVariant ;
:text "Aduh, nasihat-nasihatku yang tak beruntung."^^xsd:string ;
:relatedTo :Line_1265 .

:TV_Line_1266_ID a :TranslationVariant ;
:text "Io, anakku, muda bersama nasib muda,"^^xsd:string ;
:relatedTo :Line_1266 .

:TV_Line_1267_ID a :TranslationVariant ;
:text "aiai, aiai,"^^xsd:string ;
:relatedTo :Line_1267 .

:TV_Line_1268_ID a :TranslationVariant ;
:text "engkau mati, engkau telah dilepaskan,"^^xsd:string ;
:relatedTo :Line_1268 .

:TV_Line_1269_ID a :TranslationVariant ;
:text "oleh kebodohanku, bukan oleh kebodohanmu."^^xsd:string ;
:relatedTo :Line_1269 .

:TV_Line_1270_ID a :TranslationVariant ;
:text "Aduh, tampaknya engkau melihat keadilan terlalu terlambat."^^xsd:string ;
:relatedTo :Line_1270 .

:TV_Line_1271_ID a :TranslationVariant ;
:text "Aduh,"^^xsd:string ;
:relatedTo :Line_1271 .

:TV_Line_1272_ID a :TranslationVariant ;
:text "aku telah belajar, aku yang malang; dan di atas kepalaku"^^xsd:string ;
:relatedTo :Line_1272 .

:TV_Line_1273_ID a :TranslationVariant ;
:text "seorang dewa saat itu, ya saat itu, memegang beban besar atas diriku"^^xsd:string ;
:relatedTo :Line_1273 .

:TV_Line_1274_ID a :TranslationVariant ;
:text "dan memukulku, mengguncangku ke jalan-jalan liar,"^^xsd:string ;
:relatedTo :Line_1274 .

:TV_Line_1275_ID a :TranslationVariant ;
:text "aduh, membalikkan kegembiraanku yang terinjak-injak."^^xsd:string ;
:relatedTo :Line_1275 .

:TV_Line_1276_ID a :TranslationVariant ;
:text "Feu, feu, io, kerja-kerja manusia fana yang sulit ditanggung."^^xsd:string ;
:relatedTo :Line_1276 .
