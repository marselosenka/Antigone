@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1244-1276-german a owl:Ontology .
# German translation variants for 1244_to_1276.ttl

:TV_Line_1244_DE a :TranslationVariant ;
:text "Was würdest du daraus schließen? Die Frau ist wieder"^^xsd:string ;
:relatedTo :Line_1244 .

:TV_Line_1245_DE a :TranslationVariant ;
:text "fort, bevor sie ein gutes oder schlechtes Wort sprach."^^xsd:string ;
:relatedTo :Line_1245 .

:TV_Line_1246_DE a :TranslationVariant ;
:text "Auch ich selbst bin erstaunt; doch nähre ich mich mit Hoffnungen,"^^xsd:string ;
:relatedTo :Line_1246 .

:TV_Line_1247_DE a :TranslationVariant ;
:text "dass sie, da sie die Leiden des Kindes hört, in die Stadt hinein Jammer"^^xsd:string ;
:relatedTo :Line_1247 .

:TV_Line_1248_DE a :TranslationVariant ;
:text "nicht für würdig halten wird, sondern unter dem Dach drinnen"^^xsd:string ;
:relatedTo :Line_1248 .

:TV_Line_1249_DE a :TranslationVariant ;
:text "den Dienerinnen auferlegen wird, den häuslichen Schmerz zu beklagen."^^xsd:string ;
:relatedTo :Line_1249 .

:TV_Line_1250_DE a :TranslationVariant ;
:text "Denn sie ist des Sinnes nicht unerfahren, sodass sie fehlgehen könnte."^^xsd:string ;
:relatedTo :Line_1250 .

:TV_Line_1251_DE a :TranslationVariant ;
:text "Ich weiß nicht; mir jedenfalls scheint sowohl allzu großes Schweigen"^^xsd:string ;
:relatedTo :Line_1251 .

:TV_Line_1252_DE a :TranslationVariant ;
:text "schwer anzuhaften als auch viel vergebliches Schreien."^^xsd:string ;
:relatedTo :Line_1252 .

:TV_Line_1253_DE a :TranslationVariant ;
:text "Doch wir werden wissen, ob sie nicht etwas Unbeherrschbares"^^xsd:string ;
:relatedTo :Line_1253 .

:TV_Line_1254_DE a :TranslationVariant ;
:text "heimlich im zürnenden Herzen verborgen bedeckt,"^^xsd:string ;
:relatedTo :Line_1254 .

:TV_Line_1255_DE a :TranslationVariant ;
:text "wenn wir am Haus entlanggehen; denn du sprichst wohl gut;"^^xsd:string ;
:relatedTo :Line_1255 .

:TV_Line_1256_DE a :TranslationVariant ;
:text "denn auch in allzu großem Schweigen liegt wohl Schwere."^^xsd:string ;
:relatedTo :Line_1256 .

:TV_Line_1257_DE a :TranslationVariant ;
:text "Und doch, dieser Herr selbst kommt herbei,"^^xsd:string ;
:relatedTo :Line_1257 .

:TV_Line_1258_DE a :TranslationVariant ;
:text "ein deutliches Denkmal durch die Hand haltend,"^^xsd:string ;
:relatedTo :Line_1258 .

:TV_Line_1259_DE a :TranslationVariant ;
:text "wenn es erlaubt ist zu sagen, kein fremdes"^^xsd:string ;
:relatedTo :Line_1259 .

:TV_Line_1260_DE a :TranslationVariant ;
:text "Unheil, sondern eines, da er selbst fehlte."^^xsd:string ;
:relatedTo :Line_1260 .

:TV_Line_1261_DE a :TranslationVariant ;
:text "Io, Fehltritte törichter Sinne,"^^xsd:string ;
:relatedTo :Line_1261 .

:TV_Line_1262_DE a :TranslationVariant ;
:text "hart und todbringend,"^^xsd:string ;
:relatedTo :Line_1262 .

:TV_Line_1263_DE a :TranslationVariant ;
:text "o ihr, die ihr Tötende und"^^xsd:string ;
:relatedTo :Line_1263 .

:TV_Line_1264_DE a :TranslationVariant ;
:text "Getötete seht, aus demselben Geschlecht."^^xsd:string ;
:relatedTo :Line_1264 .

:TV_Line_1265_DE a :TranslationVariant ;
:text "Weh mir um meine unglückseligen Ratschlüsse."^^xsd:string ;
:relatedTo :Line_1265 .

:TV_Line_1266_DE a :TranslationVariant ;
:text "Io, Kind, jung mit jungem Schicksal,"^^xsd:string ;
:relatedTo :Line_1266 .

:TV_Line_1267_DE a :TranslationVariant ;
:text "ai, ai,"^^xsd:string ;
:relatedTo :Line_1267 .

:TV_Line_1268_DE a :TranslationVariant ;
:text "du starbst, du wurdest gelöst,"^^xsd:string ;
:relatedTo :Line_1268 .

:TV_Line_1269_DE a :TranslationVariant ;
:text "durch meine, nicht deine schlechten Ratschlüsse."^^xsd:string ;
:relatedTo :Line_1269 .

:TV_Line_1270_DE a :TranslationVariant ;
:text "Weh, wie du offenbar spät das Recht gesehen hast."^^xsd:string ;
:relatedTo :Line_1270 .

:TV_Line_1271_DE a :TranslationVariant ;
:text "Weh mir,"^^xsd:string ;
:relatedTo :Line_1271 .

:TV_Line_1272_DE a :TranslationVariant ;
:text "ich habe es gelernt, elend; auf mein Haupt"^^xsd:string ;
:relatedTo :Line_1272 .

:TV_Line_1273_DE a :TranslationVariant ;
:text "hat damals also ein Gott, damals, mich mit großem Gewicht habend,"^^xsd:string ;
:relatedTo :Line_1273 .

:TV_Line_1274_DE a :TranslationVariant ;
:text "geschlagen und mich auf wilde Wege erschüttert,"^^xsd:string ;
:relatedTo :Line_1274 .

:TV_Line_1275_DE a :TranslationVariant ;
:text "weh mir, meine zertretene Freude umstürzend."^^xsd:string ;
:relatedTo :Line_1275 .

:TV_Line_1276_DE a :TranslationVariant ;
:text "Pheu, pheu, io, leidvolle Mühen der Sterblichen."^^xsd:string ;
:relatedTo :Line_1276 .
