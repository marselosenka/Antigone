@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1277-1305-german a owl:Ontology .
# German translation variants for 1277_to_1305.ttl

# Line 1277 does not exist in canonical.

:TV_Line_1278_DE a :TranslationVariant ;
:text "O Herr, wie du es hast und besitzt,"^^xsd:string ;
:relatedTo :Line_1278 .

:TV_Line_1279_DE a :TranslationVariant ;
:text "scheinst du dies hier vor den Händen zu tragen, das aber im Haus"^^xsd:string ;
:relatedTo :Line_1279 .

:TV_Line_1280_DE a :TranslationVariant ;
:text "angekommen zu sein und bald Übel sehen zu werden."^^xsd:string ;
:relatedTo :Line_1280 .

:TV_Line_1281_DE a :TranslationVariant ;
:text "Was? Gibt es nun noch Schlimmeres aus Übeln?"^^xsd:string ;
:relatedTo :Line_1281 .

:TV_Line_1282_DE a :TranslationVariant ;
:text "Die Frau ist tot, die ganz wahre Mutter dieses Toten,"^^xsd:string ;
:relatedTo :Line_1282 .

:TV_Line_1283_DE a :TranslationVariant ;
:text "unglücklich, eben durch frisch schneidende Schläge."^^xsd:string ;
:relatedTo :Line_1283 .

:TV_Line_1284_DE a :TranslationVariant ;
:text "Io, io, schwer zu reinigender Hafen des Hades,"^^xsd:string ;
:relatedTo :Line_1284 .

:TV_Line_1285_DE a :TranslationVariant ;
:text "warum denn, warum vernichtest du mich?"^^xsd:string ;
:relatedTo :Line_1285 .

:TV_Line_1286_DE a :TranslationVariant ;
:text "O du, der du mir Übles meldest,"^^xsd:string ;
:relatedTo :Line_1286 .

:TV_Line_1287_DE a :TranslationVariant ;
:text "Leiden voraussendend, welches Wort rufst du?"^^xsd:string ;
:relatedTo :Line_1287 .

:TV_Line_1288_DE a :TranslationVariant ;
:text "Ai, ai, einen zugrunde gegangenen Mann hast du vollends vernichtet."^^xsd:string ;
:relatedTo :Line_1288 .

:TV_Line_1289_DE a :TranslationVariant ;
:text "Was sagst du, o Knabe? Was für Neues sagst du mir,"^^xsd:string ;
:relatedTo :Line_1289 .

:TV_Line_1290_DE a :TranslationVariant ;
:text "ai, ai,"^^xsd:string ;
:relatedTo :Line_1290 .

:TV_Line_1291_DE a :TranslationVariant ;
:text "dass ein Schlachtopfer auf Verderben,"^^xsd:string ;
:relatedTo :Line_1291 .

:TV_Line_1292_DE a :TranslationVariant ;
:text "ein weibliches Schicksal, darüber liegt?"^^xsd:string ;
:relatedTo :Line_1292 .

:TV_Line_1293_DE a :TranslationVariant ;
:text "Zu sehen ist es möglich; denn sie ist nicht mehr in den Gemächern."^^xsd:string ;
:relatedTo :Line_1293 .

:TV_Line_1294_DE a :TranslationVariant ;
:text "Weh mir,"^^xsd:string ;
:relatedTo :Line_1294 .

:TV_Line_1295_DE a :TranslationVariant ;
:text "dieses andere, zweite Übel sehe ich, Elender."^^xsd:string ;
:relatedTo :Line_1295 .

:TV_Line_1296_DE a :TranslationVariant ;
:text "Welches Schicksal, welches wartet denn noch auf mich?"^^xsd:string ;
:relatedTo :Line_1296 .

:TV_Line_1297_DE a :TranslationVariant ;
:text "Eben habe ich ein Kind in den Händen,"^^xsd:string ;
:relatedTo :Line_1297 .

:TV_Line_1298_DE a :TranslationVariant ;
:text "elend, und den gegenüberliegenden Toten sehe ich an."^^xsd:string ;
:relatedTo :Line_1298 .

# Line 1299 does not exist in canonical.

:TV_Line_1300_DE a :TranslationVariant ;
:text "Pheu, pheu, unglückliche Mutter, pheu, Kind."^^xsd:string ;
:relatedTo :Line_1300 .

:TV_Line_1301_DE a :TranslationVariant ;
:text "Sie aber, scharf getroffen, am Altar sitzend,"^^xsd:string ;
:relatedTo :Line_1301 .

:TV_Line_1302_DE a :TranslationVariant ;
:text "löst die dunklen Lider, nachdem sie zuerst geschrien hatte"^^xsd:string ;
:relatedTo :Line_1302 .

:TV_Line_1303_DE a :TranslationVariant ;
:text "um das leere Bett des zuvor gestorbenen Megareus,"^^xsd:string ;
:relatedTo :Line_1303 .

:TV_Line_1304_DE a :TranslationVariant ;
:text "dann wieder um diesen, zuletzt aber gegen dich schlimme"^^xsd:string ;
:relatedTo :Line_1304 .

:TV_Line_1305_DE a :TranslationVariant ;
:text "Taten besungen, den Kindertöter nennend."^^xsd:string ;
:relatedTo :Line_1305 .
