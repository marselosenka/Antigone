@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1244-1276-french a owl:Ontology .
# French translation variants for 1244_to_1276.ttl

:TV_Line_1244_FR a :TranslationVariant ;
:text "Que pourrais-tu conjecturer de cela ? La femme de nouveau"^^xsd:string ;
:relatedTo :Line_1244 .

:TV_Line_1245_FR a :TranslationVariant ;
:text "est partie, avant de dire une parole bonne ou mauvaise."^^xsd:string ;
:relatedTo :Line_1245 .

:TV_Line_1246_FR a :TranslationVariant ;
:text "Moi aussi je suis stupéfait ; mais je me nourris d’espoirs :"^^xsd:string ;
:relatedTo :Line_1246 .

:TV_Line_1247_FR a :TranslationVariant ;
:text "ayant entendu les douleurs de son enfant, elle ne jugera pas digne"^^xsd:string ;
:relatedTo :Line_1247 .

:TV_Line_1248_FR a :TranslationVariant ;
:text "de faire dans la cité une lamentation, mais à l’intérieur, sous le toit,"^^xsd:string ;
:relatedTo :Line_1248 .

:TV_Line_1249_FR a :TranslationVariant ;
:text "elle ordonnera à ses servantes de gémir le deuil domestique."^^xsd:string ;
:relatedTo :Line_1249 .

:TV_Line_1250_FR a :TranslationVariant ;
:text "Car elle n’est pas sans jugement, au point de fauter."^^xsd:string ;
:relatedTo :Line_1250 .

:TV_Line_1251_FR a :TranslationVariant ;
:text "Je ne sais ; pour moi, du moins, le trop grand silence"^^xsd:string ;
:relatedTo :Line_1251 .

:TV_Line_1252_FR a :TranslationVariant ;
:text "me semble lourd, comme le cri abondant en vain."^^xsd:string ;
:relatedTo :Line_1252 .

:TV_Line_1253_FR a :TranslationVariant ;
:text "Mais nous saurons si elle ne cache pas quelque chose de retenu"^^xsd:string ;
:relatedTo :Line_1253 .

:TV_Line_1254_FR a :TranslationVariant ;
:text "en secret dans son cœur irrité,"^^xsd:string ;
:relatedTo :Line_1254 .

:TV_Line_1255_FR a :TranslationVariant ;
:text "en allant près de la maison ; car tu parles bien :"^^xsd:string ;
:relatedTo :Line_1255 .

:TV_Line_1256_FR a :TranslationVariant ;
:text "il y a quelque poids même dans le trop grand silence."^^xsd:string ;
:relatedTo :Line_1256 .

:TV_Line_1257_FR a :TranslationVariant ;
:text "Et voici justement le seigneur lui-même qui arrive,"^^xsd:string ;
:relatedTo :Line_1257 .

:TV_Line_1258_FR a :TranslationVariant ;
:text "portant dans ses mains un mémorial manifeste,"^^xsd:string ;
:relatedTo :Line_1258 .

:TV_Line_1259_FR a :TranslationVariant ;
:text "s’il est permis de le dire, non pas un malheur étranger,"^^xsd:string ;
:relatedTo :Line_1259 .

:TV_Line_1260_FR a :TranslationVariant ;
:text "mais un malheur où lui-même a fauté."^^xsd:string ;
:relatedTo :Line_1260 .

:TV_Line_1261_FR a :TranslationVariant ;
:text "Io, erreurs de pensées mauvaises,"^^xsd:string ;
:relatedTo :Line_1261 .

:TV_Line_1262_FR a :TranslationVariant ;
:text "dures, mortelles,"^^xsd:string ;
:relatedTo :Line_1262 .

:TV_Line_1263_FR a :TranslationVariant ;
:text "ô vous qui regardez des proches"^^xsd:string ;
:relatedTo :Line_1263 .

:TV_Line_1264_FR a :TranslationVariant ;
:text "ayant tué et étant morts."^^xsd:string ;
:relatedTo :Line_1264 .

:TV_Line_1265_FR a :TranslationVariant ;
:text "Hélas, malheureux conseils des miens."^^xsd:string ;
:relatedTo :Line_1265 .

:TV_Line_1266_FR a :TranslationVariant ;
:text "Io, enfant, jeune avec un jeune destin,"^^xsd:string ;
:relatedTo :Line_1266 .

:TV_Line_1267_FR a :TranslationVariant ;
:text "aiai, aiai,"^^xsd:string ;
:relatedTo :Line_1267 .

:TV_Line_1268_FR a :TranslationVariant ;
:text "tu es mort, tu as été délivré,"^^xsd:string ;
:relatedTo :Line_1268 .

:TV_Line_1269_FR a :TranslationVariant ;
:text "par mes mauvais conseils, non par les tiens."^^xsd:string ;
:relatedTo :Line_1269 .

:TV_Line_1270_FR a :TranslationVariant ;
:text "Hélas, comme tu sembles avoir vu la justice tardivement."^^xsd:string ;
:relatedTo :Line_1270 .

:TV_Line_1271_FR a :TranslationVariant ;
:text "Hélas,"^^xsd:string ;
:relatedTo :Line_1271 .

:TV_Line_1272_FR a :TranslationVariant ;
:text "je l’ai appris, malheureux ; et sur ma tête"^^xsd:string ;
:relatedTo :Line_1272 .

:TV_Line_1273_FR a :TranslationVariant ;
:text "un dieu alors, alors, me tenant d’un grand poids,"^^xsd:string ;
:relatedTo :Line_1273 .

:TV_Line_1274_FR a :TranslationVariant ;
:text "m’a frappé et m’a secoué sur des chemins sauvages,"^^xsd:string ;
:relatedTo :Line_1274 .

:TV_Line_1275_FR a :TranslationVariant ;
:text "hélas, renversant ma joie foulée aux pieds."^^xsd:string ;
:relatedTo :Line_1275 .

:TV_Line_1276_FR a :TranslationVariant ;
:text "Pheu, pheu, io, peines des mortels difficiles à porter."^^xsd:string ;
:relatedTo :Line_1276 .
