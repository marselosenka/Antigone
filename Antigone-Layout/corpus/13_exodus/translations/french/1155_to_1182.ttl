@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1155-1182-french a owl:Ontology .
# French translation variants for 1155_to_1182.ttl

:TV_Line_1155_FR a :TranslationVariant ;
:text "Voisins de Cadmos et des maisons d’Amphion,"^^xsd:string ;
:relatedTo :Line_1155 .

:TV_Line_1156_FR a :TranslationVariant ;
:text "il n’est aucune vie humaine telle que, la voyant stable,"^^xsd:string ;
:relatedTo :Line_1156 .

:TV_Line_1157_FR a :TranslationVariant ;
:text "je puisse jamais la louer ni la blâmer."^^xsd:string ;
:relatedTo :Line_1157 .

:TV_Line_1158_FR a :TranslationVariant ;
:text "Car la fortune redresse, et la fortune renverse"^^xsd:string ;
:relatedTo :Line_1158 .

:TV_Line_1159_FR a :TranslationVariant ;
:text "toujours l’homme heureux comme l’homme malheureux ;"^^xsd:string ;
:relatedTo :Line_1159 .

:TV_Line_1160_FR a :TranslationVariant ;
:text "et nul devin ne connaît ce qui est établi pour les mortels."^^xsd:string ;
:relatedTo :Line_1160 .

:TV_Line_1161_FR a :TranslationVariant ;
:text "Car Créon était autrefois enviable, à mon avis,"^^xsd:string ;
:relatedTo :Line_1161 .

:TV_Line_1162_FR a :TranslationVariant ;
:text "ayant sauvé cette terre cadméenne de ses ennemis,"^^xsd:string ;
:relatedTo :Line_1162 .

:TV_Line_1163_FR a :TranslationVariant ;
:text "et, ayant reçu la monarchie entière du pays,"^^xsd:string ;
:relatedTo :Line_1163 .

:TV_Line_1164_FR a :TranslationVariant ;
:text "il la dirigeait, florissant par la noble semence de ses enfants ;"^^xsd:string ;
:relatedTo :Line_1164 .

:TV_Line_1165_FR a :TranslationVariant ;
:text "et maintenant tout lui est enlevé. Car lorsque les hommes"^^xsd:string ;
:relatedTo :Line_1165 .

:TV_Line_1166_FR a :TranslationVariant ;
:text "ont trahi les plaisirs, moi je ne dis pas"^^xsd:string ;
:relatedTo :Line_1166 .

:TV_Line_1167_FR a :TranslationVariant ;
:text "que cet homme vit, mais je le tiens pour un mort animé."^^xsd:string ;
:relatedTo :Line_1167 .

:TV_Line_1168_FR a :TranslationVariant ;
:text "Sois riche dans ta maison, si tu veux, grandement,"^^xsd:string ;
:relatedTo :Line_1168 .

:TV_Line_1169_FR a :TranslationVariant ;
:text "et vis avec l’apparence d’un tyran ; mais si manque"^^xsd:string ;
:relatedTo :Line_1169 .

:TV_Line_1170_FR a :TranslationVariant ;
:text "la joie de ces choses, tout le reste, moi, pour l’homme,"^^xsd:string ;
:relatedTo :Line_1170 .

:TV_Line_1171_FR a :TranslationVariant ;
:text "je ne l’achèterais pas au prix de l’ombre d’une fumée, auprès du plaisir."^^xsd:string ;
:relatedTo :Line_1171 .

:TV_Line_1172_FR a :TranslationVariant ;
:text "Quel est donc ce fardeau des rois que tu viens porter ?"^^xsd:string ;
:relatedTo :Line_1172 .

:TV_Line_1173_FR a :TranslationVariant ;
:text "Ils sont morts ; et les vivants sont coupables de leur mort."^^xsd:string ;
:relatedTo :Line_1173 .

:TV_Line_1174_FR a :TranslationVariant ;
:text "Et qui tue ? Qui est celui qui gît ? Parle."^^xsd:string ;
:relatedTo :Line_1174 .

:TV_Line_1175_FR a :TranslationVariant ;
:text "Hémon a péri ; il est ensanglanté par sa propre main."^^xsd:string ;
:relatedTo :Line_1175 .

:TV_Line_1176_FR a :TranslationVariant ;
:text "Est-ce par la main de son père ou par la sienne propre ?"^^xsd:string ;
:relatedTo :Line_1176 .

:TV_Line_1177_FR a :TranslationVariant ;
:text "Lui-même, par lui-même, irrité contre son père pour le meurtre."^^xsd:string ;
:relatedTo :Line_1177 .

:TV_Line_1178_FR a :TranslationVariant ;
:text "Ô devin, comme tu as accompli une parole juste."^^xsd:string ;
:relatedTo :Line_1178 .

:TV_Line_1179_FR a :TranslationVariant ;
:text "Puisqu’il en est ainsi, il reste à délibérer sur le reste."^^xsd:string ;
:relatedTo :Line_1179 .

:TV_Line_1180_FR a :TranslationVariant ;
:text "Et certes je vois la malheureuse Eurydice, en même temps,"^^xsd:string ;
:relatedTo :Line_1180 .

:TV_Line_1181_FR a :TranslationVariant ;
:text "l’épouse de Créon. Elle sort des demeures,"^^xsd:string ;
:relatedTo :Line_1181 .

:TV_Line_1182_FR a :TranslationVariant ;
:text "soit parce qu’elle a entendu parler de son fils, soit par hasard."^^xsd:string ;
:relatedTo :Line_1182 .
