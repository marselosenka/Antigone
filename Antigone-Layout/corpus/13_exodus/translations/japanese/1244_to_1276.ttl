@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1244-1276-japanese a owl:Ontology .
# Japanese translation variants for 1244_to_1276.ttl

:TV_Line_1244_JA a :TranslationVariant ;
:text "これをどう推し量るべきか。あの女はまた"^^xsd:string ;
:relatedTo :Line_1244 .

:TV_Line_1245_JA a :TranslationVariant ;
:text "去ってしまった、善い言葉も悪い言葉も言う前に。"^^xsd:string ;
:relatedTo :Line_1245 .

:TV_Line_1246_JA a :TranslationVariant ;
:text "私自身も驚いています。しかし希望で自らを養っています、"^^xsd:string ;
:relatedTo :Line_1246 .

:TV_Line_1247_JA a :TranslationVariant ;
:text "息子の苦しみを聞いても、町へ向かって"^^xsd:string ;
:relatedTo :Line_1247 .

:TV_Line_1248_JA a :TranslationVariant ;
:text "声を上げて嘆くのをふさわしいとは思わず、むしろ屋根の内で"^^xsd:string ;
:relatedTo :Line_1248 .

:TV_Line_1249_JA a :TranslationVariant ;
:text "侍女たちに身内の悲しみを嘆かせるのだろうと。"^^xsd:string ;
:relatedTo :Line_1249 .

:TV_Line_1250_JA a :TranslationVariant ;
:text "彼女は道を誤るほど、判断を欠いてはいませんから。"^^xsd:string ;
:relatedTo :Line_1250 .

:TV_Line_1251_JA a :TranslationVariant ;
:text "分からない。だが私には、過度の沈黙も重いものを"^^xsd:string ;
:relatedTo :Line_1251 .

:TV_Line_1252_JA a :TranslationVariant ;
:text "伴うように見える、無益な大きな叫びと同じく。"^^xsd:string ;
:relatedTo :Line_1252 .

:TV_Line_1253_JA a :TranslationVariant ;
:text "では、私たちは知るでしょう、抑え難い何かを"^^xsd:string ;
:relatedTo :Line_1253 .

:TV_Line_1254_JA a :TranslationVariant ;
:text "怒る心の奥に密かに隠しているのかどうかを、"^^xsd:string ;
:relatedTo :Line_1254 .

:TV_Line_1255_JA a :TranslationVariant ;
:text "館へ近づいて行けば。実際、あなたはよく言っています。"^^xsd:string ;
:relatedTo :Line_1255 .

:TV_Line_1256_JA a :TranslationVariant ;
:text "過度の沈黙にも、たしかに重みがあるのです。"^^xsd:string ;
:relatedTo :Line_1256 .

:TV_Line_1257_JA a :TranslationVariant ;
:text "そして見よ、王自身がここへ来る、"^^xsd:string ;
:relatedTo :Line_1257 .

:TV_Line_1258_JA a :TranslationVariant ;
:text "手に明らかな記念のしるしを持って、"^^xsd:string ;
:relatedTo :Line_1258 .

:TV_Line_1259_JA a :TranslationVariant ;
:text "言うことが許されるなら、他人のものではない"^^xsd:string ;
:relatedTo :Line_1259 .

:TV_Line_1260_JA a :TranslationVariant ;
:text "破滅を、自分自身が過って招いたものを。"^^xsd:string ;
:relatedTo :Line_1260 .

:TV_Line_1261_JA a :TranslationVariant ;
:text "ああ、思慮なき心の過ちよ、"^^xsd:string ;
:relatedTo :Line_1261 .

:TV_Line_1262_JA a :TranslationVariant ;
:text "固く、死をもたらすものよ、"^^xsd:string ;
:relatedTo :Line_1262 .

:TV_Line_1263_JA a :TranslationVariant ;
:text "おお、殺した者たちと"^^xsd:string ;
:relatedTo :Line_1263 .

:TV_Line_1264_JA a :TranslationVariant ;
:text "死んだ者たちを、同じ血筋の中に見る者たちよ。"^^xsd:string ;
:relatedTo :Line_1264 .

:TV_Line_1265_JA a :TranslationVariant ;
:text "ああ、私の不運な思慮よ。"^^xsd:string ;
:relatedTo :Line_1265 .

:TV_Line_1266_JA a :TranslationVariant ;
:text "ああ、子よ、若くして若い運命とともに、"^^xsd:string ;
:relatedTo :Line_1266 .

:TV_Line_1267_JA a :TranslationVariant ;
:text "ああ、ああ、"^^xsd:string ;
:relatedTo :Line_1267 .

:TV_Line_1268_JA a :TranslationVariant ;
:text "お前は死んだ、解き放たれた、"^^xsd:string ;
:relatedTo :Line_1268 .

:TV_Line_1269_JA a :TranslationVariant ;
:text "私の悪い判断によってであって、お前のものによってではない。"^^xsd:string ;
:relatedTo :Line_1269 .

:TV_Line_1270_JA a :TranslationVariant ;
:text "ああ、あなたは遅すぎて正義を見たようだ。"^^xsd:string ;
:relatedTo :Line_1270 .

:TV_Line_1271_JA a :TranslationVariant ;
:text "ああ、"^^xsd:string ;
:relatedTo :Line_1271 .

:TV_Line_1272_JA a :TranslationVariant ;
:text "私は学んだ、哀れな者として。そして私の頭に"^^xsd:string ;
:relatedTo :Line_1272 .

:TV_Line_1273_JA a :TranslationVariant ;
:text "その時、神が大きな重荷を持って"^^xsd:string ;
:relatedTo :Line_1273 .

:TV_Line_1274_JA a :TranslationVariant ;
:text "私を打ち、荒々しい道へと揺さぶり入れた、"^^xsd:string ;
:relatedTo :Line_1274 .

:TV_Line_1275_JA a :TranslationVariant ;
:text "ああ、踏みにじられた喜びを覆しながら。"^^xsd:string ;
:relatedTo :Line_1275 .

:TV_Line_1276_JA a :TranslationVariant ;
:text "ああ、ああ、死すべき者の苦労は耐え難い苦労だ。"^^xsd:string ;
:relatedTo :Line_1276 .
