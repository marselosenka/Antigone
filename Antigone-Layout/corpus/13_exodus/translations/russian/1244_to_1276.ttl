@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:exodus-translations-1244-1276-russian a owl:Ontology .
# Russian translation variants for 1244_to_1276.ttl

:TV_Line_1244_RU a :TranslationVariant ;
:text "Что бы ты об этом предположил? Женщина снова"^^xsd:string ;
:relatedTo :Line_1244 .

:TV_Line_1245_RU a :TranslationVariant ;
:text "ушла, прежде чем сказать доброе или злое слово."^^xsd:string ;
:relatedTo :Line_1245 .

:TV_Line_1246_RU a :TranslationVariant ;
:text "Я и сам изумлен; но питаюсь надеждами,"^^xsd:string ;
:relatedTo :Line_1246 .

:TV_Line_1247_RU a :TranslationVariant ;
:text "что, услышав страдания сына, она не сочтет достойным"^^xsd:string ;
:relatedTo :Line_1247 .

:TV_Line_1248_RU a :TranslationVariant ;
:text "городского плача, но внутри под кровом"^^xsd:string ;
:relatedTo :Line_1248 .

:TV_Line_1249_RU a :TranslationVariant ;
:text "служанкам поручит стонать о домашнем горе."^^xsd:string ;
:relatedTo :Line_1249 .

:TV_Line_1250_RU a :TranslationVariant ;
:text "Ведь она не лишена рассудка, чтобы ошибиться."^^xsd:string ;
:relatedTo :Line_1250 .

:TV_Line_1251_RU a :TranslationVariant ;
:text "Не знаю; мне, однако, и чрезмерное молчание тяжелым"^^xsd:string ;
:relatedTo :Line_1251 .

:TV_Line_1252_RU a :TranslationVariant ;
:text "кажется, как и напрасный громкий крик."^^xsd:string ;
:relatedTo :Line_1252 .

:TV_Line_1253_RU a :TranslationVariant ;
:text "Но мы узнаем, не скрывает ли она чего-то неудержимого"^^xsd:string ;
:relatedTo :Line_1253 .

:TV_Line_1254_RU a :TranslationVariant ;
:text "тайно в гневящемся сердце,"^^xsd:string ;
:relatedTo :Line_1254 .

:TV_Line_1255_RU a :TranslationVariant ;
:text "проходя к дому; ведь ты хорошо говоришь:"^^xsd:string ;
:relatedTo :Line_1255 .

:TV_Line_1256_RU a :TranslationVariant ;
:text "есть где-то и тяжесть чрезмерного молчания."^^xsd:string ;
:relatedTo :Line_1256 .

:TV_Line_1257_RU a :TranslationVariant ;
:text "И вот сам владыка подходит сюда,"^^xsd:string ;
:relatedTo :Line_1257 .

:TV_Line_1258_RU a :TranslationVariant ;
:text "держа в руках заметный памятный знак,"^^xsd:string ;
:relatedTo :Line_1258 .

:TV_Line_1259_RU a :TranslationVariant ;
:text "если дозволено сказать, не чужую"^^xsd:string ;
:relatedTo :Line_1259 .

:TV_Line_1260_RU a :TranslationVariant ;
:text "беду, но свою собственную ошибку."^^xsd:string ;
:relatedTo :Line_1260 .

:TV_Line_1261_RU a :TranslationVariant ;
:text "Ио, ошибки безумных мыслей,"^^xsd:string ;
:relatedTo :Line_1261 .

:TV_Line_1262_RU a :TranslationVariant ;
:text "твердые, смертоносные,"^^xsd:string ;
:relatedTo :Line_1262 .

:TV_Line_1263_RU a :TranslationVariant ;
:text "о вы, видящие убивших и"^^xsd:string ;
:relatedTo :Line_1263 .

:TV_Line_1264_RU a :TranslationVariant ;
:text "умерших родичей."^^xsd:string ;
:relatedTo :Line_1264 .

:TV_Line_1265_RU a :TranslationVariant ;
:text "О горе моим несчастным решениям."^^xsd:string ;
:relatedTo :Line_1265 .

:TV_Line_1266_RU a :TranslationVariant ;
:text "Ио, дитя, молодой с молодой судьбой,"^^xsd:string ;
:relatedTo :Line_1266 .

:TV_Line_1267_RU a :TranslationVariant ;
:text "ай-ай, ай-ай,"^^xsd:string ;
:relatedTo :Line_1267 .

:TV_Line_1268_RU a :TranslationVariant ;
:text "ты умер, ты освобожден,"^^xsd:string ;
:relatedTo :Line_1268 .

:TV_Line_1269_RU a :TranslationVariant ;
:text "моими, а не твоими дурными решениями."^^xsd:string ;
:relatedTo :Line_1269 .

:TV_Line_1270_RU a :TranslationVariant ;
:text "О горе, как кажется, поздно ты увидел правду."^^xsd:string ;
:relatedTo :Line_1270 .

:TV_Line_1271_RU a :TranslationVariant ;
:text "О горе мне,"^^xsd:string ;
:relatedTo :Line_1271 .

:TV_Line_1272_RU a :TranslationVariant ;
:text "я, несчастный, узнал; и на мою голову"^^xsd:string ;
:relatedTo :Line_1272 .

:TV_Line_1273_RU a :TranslationVariant ;
:text "бог тогда, да тогда, имея великий груз,"^^xsd:string ;
:relatedTo :Line_1273 .

:TV_Line_1274_RU a :TranslationVariant ;
:text "ударил меня и сотряс на диких путях,"^^xsd:string ;
:relatedTo :Line_1274 .

:TV_Line_1275_RU a :TranslationVariant ;
:text "о горе, опрокидывая мою растоптанную радость."^^xsd:string ;
:relatedTo :Line_1275 .

:TV_Line_1276_RU a :TranslationVariant ;
:text "Фу, фу, ио, труды смертных, трудно выносимые."^^xsd:string ;
:relatedTo :Line_1276 .
