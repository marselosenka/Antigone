@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:stasimon_04-translations-966-987-portuguese a owl:Ontology .
# Portuguese translation variants for 966_to_987.ttl

:TV_Line_966_PT a :TranslationVariant ;
:text "Junto às rochas azul-escuras do mar duplo"^^xsd:string ;
:relatedTo :Line_966 .

:TV_Line_967_PT a :TranslationVariant ;
:text "estão as costas bosporianas e a praia dos trácios,"^^xsd:string ;
:relatedTo :Line_967 .

# Lines 968 and 969 do not exist in canonical.

:TV_Line_970_PT a :TranslationVariant ;
:text "Salmidesso, onde Ares, vizinho da cidade,"^^xsd:string ;
:relatedTo :Line_970 .

:TV_Line_971_PT a :TranslationVariant ;
:text "nos dois filhos de Fineu"^^xsd:string ;
:relatedTo :Line_971 .

:TV_Line_972_PT a :TranslationVariant ;
:text "viu a ferida amaldiçoada,"^^xsd:string ;
:relatedTo :Line_972 .

:TV_Line_973_PT a :TranslationVariant ;
:text "cegada pela esposa selvagem,"^^xsd:string ;
:relatedTo :Line_973 .

:TV_Line_974_PT a :TranslationVariant ;
:text "cego nos círculos vingadores dos olhos"^^xsd:string ;
:relatedTo :Line_974 .

:TV_Line_975_PT a :TranslationVariant ;
:text "golpeados por mãos sangrentas"^^xsd:string ;
:relatedTo :Line_975 .

:TV_Line_976_PT a :TranslationVariant ;
:text "e pelas pontas das lançadeiras."^^xsd:string ;
:relatedTo :Line_976 .

:TV_Line_977_PT a :TranslationVariant ;
:text "E consumindo-se, miseráveis, por miserável sofrimento,"^^xsd:string ;
:relatedTo :Line_977 .

# Lines 978 and 979 do not exist in canonical.

:TV_Line_980_PT a :TranslationVariant ;
:text "choravam, tendo da mãe geração sem núpcias;"^^xsd:string ;
:relatedTo :Line_980 .

:TV_Line_981_PT a :TranslationVariant ;
:text "e ela, semente dos antigos"^^xsd:string ;
:relatedTo :Line_981 .

:TV_Line_982_PT a :TranslationVariant ;
:text "Erectidas,"^^xsd:string ;
:relatedTo :Line_982 .

:TV_Line_983_PT a :TranslationVariant ;
:text "em grutas distantes"^^xsd:string ;
:relatedTo :Line_983 .

:TV_Line_984_PT a :TranslationVariant ;
:text "foi criada entre tempestades paternas,"^^xsd:string ;
:relatedTo :Line_984 .

:TV_Line_985_PT a :TranslationVariant ;
:text "Bóreas, parelho aos cavalos sobre o penhasco íngreme,"^^xsd:string ;
:relatedTo :Line_985 .

:TV_Line_986_PT a :TranslationVariant ;
:text "filha dos deuses; mas também sobre ela"^^xsd:string ;
:relatedTo :Line_986 .

:TV_Line_987_PT a :TranslationVariant ;
:text "as Moiras de longa vida se apoderaram, ó filha."^^xsd:string ;
:relatedTo :Line_987 .
