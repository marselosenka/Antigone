:experiencesEmotion :Emotion_AweAndReverence, :Emotion_Despair .

:Antigone_Character_Zeus 
    a :Character ;
    :hasMotivation :Motivation_MaintainAbsolutePower .

# :Antigone_Character_Mankind a :Character .

# Note: The following characters are not explicitly mentioned in 
# the stasimon but are relevant for the motivations and conflicts described

