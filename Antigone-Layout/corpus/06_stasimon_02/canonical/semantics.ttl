################################################################
# MOTIVATIONS
################################################################
:Motivation_MaintainAbsolutePower a :Motivation ;
    :description "Zeus's intention to sustain his unwearying and eternal power over mankind."^^xsd:string .

################################################################
# ETHICAL PRINCIPLES
################################################################

:EthicalPrinciple_GreatnessBringsRuin a :EthicalPrinciple ;
    :description "The enduring moral law that nothing grand comes to a mortal's life without ruin."^^xsd:string .


################################################################
# EMOTIONS
################################################################

:Emotion_AweAndReverence a :Emotion ;
    :description "The awe and fear experienced when recognizing the inescapable and absolute power of Zeus."^^xsd:string .

:Emotion_Despair a :Emotion ;
    :description "Despair over the unending, ancient miseries falling upon the House of Labdacus."^^xsd:string .


################################################################
# CONFLICTS
################################################################

:Conflict_DivineOmnipotenceVsHumanAspiration a :Conflict ;
    :description "The conflict between the eternal power of the gods and the tragic limits of mortal lives."^^xsd:string ;
    :conflictBetween :Zeus, :Mankind .

################################################################
# EVENTS, CAUSES, EFFECTS
################################################################

:Event_DivineIntervention a owl:Thing ;
    :description "A god throwing down a generation with no release and shaking their abode."^^xsd:string .

:Event_GenerationalRuin a owl:Thing ;
    :description "The ancient miseries of the house of Labdacus compounding upon the miseries of the dead."^^xsd:string .

:Event_DivineIntervention :relatedTo :Event_GenerationalRuin .

:Event_TransgressionOfPower a owl:Thing ;
    :description "A mortal committing a transgression against the eternal power of Zeus."^^xsd:string .

:Event_InevitableRuin a owl:Thing ;
    :description "The ruin that inextricably follows human greatness or transgression."^^xsd:string .

:Event_TransgressionOfPower :relatedTo :Event_InevitableRuin .

:Cause_FollyAndFrenzy a owl:Thing ;
    :description "The bloody dust, folly, and frenzy of thought."^^xsd:string .
:Cause_FollyAndFrenzy :relatedTo :Effect_DestructionOfOedipusHouse .

:Effect_DestructionOfOedipusHouse a owl:Thing ;
    :description "Cutting down the final ray of light shining over the roots of the house of Oedipus."^^xsd:string .



################################################################
# THEMES
################################################################

:Theme_GenerationalCurse a :Theme ;
    :description "The inescapable curse passing from the dead to the living in the House of Labdacus."^^xsd:string .

:Theme_DivineOmnipotence a :Theme ;
    :description "The unyielding, eternal power of the gods, untouched by sleep or time."^^xsd:string .

:Theme_HumanFrailty a :Theme ;
    :description "The tragic fragility of the human condition, where greatness inevitably invites destruction."^^xsd:string .

:Cause_FalseHope a owl:Thing ;
    :description "Hope acting as a trick of thoughtless lust."^^xsd:string .


:Theme_DivineMadness a :Theme ;
    :description "The distortion of human perception by the gods, making evil seem good before bringing swift ruin."^^xsd:string .

:Theme_FilialDuty a :Theme ;
    :description "The expectation of unconditional allegiance from a son to his father."^^xsd:string .


################################################################
# MOTIVATIONS
################################################################

:Motivation_MournBride a :Motivation ;
    :description "Haemon's supposed intention to mourn the fate of his bride Antigone and grieve his lost marriage."^^xsd:string .


:Motivation_AssessSonLoyalty a :Motivation ;
    :description "Creon's intention to assess his son's loyalty (friendship) after hearing of his bride's condemnation."^^xsd:string .

################################################################
# ETHICAL PRINCIPLES
################################################################

:EthicalPrinciple_FilialLoyalty a :EthicalPrinciple ;
    :description "The principle that a son should remain unconditional allies to his father in all circumstances (always acting as friends)."^^xsd:string .

################################################################
# EMOTIONS
################################################################

:Emotion_Grief a :Emotion ;
    :description "The sorrow and mourning over the fate of a bride and being cheated out of a marriage bed."^^xsd:string .

:Emotion_Raving a :Emotion ;
    :description "The frantic anger and madness (raging) over the loss of his intended bride."^^xsd:string .


################################################################
# CONFLICTS
################################################################

:Conflict_EvilAppearingAsGood a :Conflict ;
    :description "The cognitive and moral contradiction where evil is perceived as good by a mind being led to ruin."^^xsd:string ;
    :conflictBetween :Theme_FalseHope, :Event_InevitableRuin .

:Conflict_LoyaltyVsLove a :Conflict ;
    :description "The tension between Haemon's romantic bond with Antigone and his filial obligation to Creon."^^xsd:string ;
    :conflictBetween :Antigone, :Creon .

################################################################
# CAUSES AND EFFECTS
################################################################

:Cause_DivineDeception a owl:Thing ;
    :description "The gods leading a mortal's mind to ruin."^^xsd:string .

:Effect_MoralBlindness a owl:Thing ;
    :description "Evil appearing as good to the deceived mortal."^^xsd:string .

:Effect_InevitableRuin a owl:Thing ;
    :description "The mortal falling into ruin shortly after losing moral clarity."^^xsd:string .

:Cause_DivineDeception :relatedTo :Effect_MoralBlindness .
:Effect_MoralBlindness :relatedTo :Effect_InevitableRuin .

:Cause_FalseHope a owl:Thing ;
    :description "Hope acting as a trick of thoughtless lust."^^xsd:string .

:Effect_UnexpectedPain a owl:Thing ;
    :description "A victim unknowingly crying out from a foot blazing with fire."^^xsd:string .
:Cause_FalseHope :relatedTo :Effect_UnexpectedPain .

################################################################
# EVENTS
################################################################

:Event_FinalVote a owl:Thing ;
    :description "The casting of the final vote (the decisive vote) that condemns Antigone."^^xsd:string .
:Event_FinalVote :relatedTo :Emotion_Grief .
:Event_FinalVote :relatedTo :Emotion_Raving .
