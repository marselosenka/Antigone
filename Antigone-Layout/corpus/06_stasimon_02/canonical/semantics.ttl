    a :Character ;
    :hasMotivation :Motivation_MournBride ;
    :experiencesEmotion :Emotion_Grief, :Emotion_Raving .

:Antigone_Character_Antigone a :Character .

:Antigone_Character_Creon 
    a :Character ;
    :hasMotivation :Motivation_AssessSonLoyalty ;
    :advocatesFor :EthicalPrinciple_FilialLoyalty .
