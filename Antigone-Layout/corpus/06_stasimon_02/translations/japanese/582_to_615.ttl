@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:stasimon_02-translations-582-615-japanese a owl:Ontology .
# Japanese translation variants for 582_to_615.ttl

# Line 582 does not exist in Antigone

:TV_Line_583_JA a :TranslationVariant ;
:text "幸福な者たちよ、災いを味わわぬ生涯を持つ者たちよ。"^^xsd:string ;
:relatedTo :Line_583 .

:TV_Line_584_JA a :TranslationVariant ;
:text "というのも、神からその家が揺さぶられる者たちには、"^^xsd:string ;
:relatedTo :Line_584 .

:TV_Line_585_JA a :TranslationVariant ;
:text "破滅は何も残さず、世代の多数を奪いながら進む。"^^xsd:string ;
:relatedTo :Line_585 .

:TV_Line_586_JA a :TranslationVariant ;
:text "それは、海のうねりが、息苦しい"^^xsd:string ;
:relatedTo :Line_586 .

:TV_Line_587_JA a :TranslationVariant ;
:text "トラキアの風によって、暗い深淵の上を走る時に似ている。"^^xsd:string ;
:relatedTo :Line_587 .

# Lines 588 and 589 do not exist in Antigone

:TV_Line_590_JA a :TranslationVariant ;
:text "それは海底から黒い砂を巻き上げ、"^^xsd:string ;
:relatedTo :Line_590 .

:TV_Line_591_JA a :TranslationVariant ;
:text "風に苦しむ、打ち返す岸辺は口を轟かせる。"^^xsd:string ;
:relatedTo :Line_591 .

# Line 592 does not exist in Antigone

:TV_Line_593_JA a :TranslationVariant ;
:text "ラブダコス家の古い苦しみを、私は呪い求める、"^^xsd:string ;
:relatedTo :Line_593 .

# Line 594 does not exist in Antigone

:TV_Line_595_JA a :TranslationVariant ;
:text "滅びた者たちの苦しみの上に苦しみが落ち、"^^xsd:string ;
:relatedTo :Line_595 .

:TV_Line_596_JA a :TranslationVariant ;
:text "世代が世代を解放せず、むしろそれを打ち倒す。"^^xsd:string ;
:relatedTo :Line_596 .

:TV_Line_597_JA a :TranslationVariant ;
:text "神々の誰かがそうし、それには解き放ちがない。というのも今、最後の"^^xsd:string ;
:relatedTo :Line_597 .

# Lines 598 and 599 do not exist in Antigone

:TV_Line_600_JA a :TranslationVariant ;
:text "根から、オイディプスの家に光が伸びていたが、"^^xsd:string ;
:relatedTo :Line_600 .

:TV_Line_601_JA a :TranslationVariant ;
:text "下なる神々の血に染まった"^^xsd:string ;
:relatedTo :Line_601 .

:TV_Line_602_JA a :TranslationVariant ;
:text "塵が、言葉の愚かさと心の争いによって、それを刈り倒す。"^^xsd:string ;
:relatedTo :Line_602 .

# Lines 603 and 604 do not exist in Antigone

:TV_Line_605_JA a :TranslationVariant ;
:text "あなたの力を、ゼウスよ、男たちのどんな越権が抑えられようか。"^^xsd:string ;
:relatedTo :Line_605 .

:TV_Line_606_JA a :TranslationVariant ;
:text "それを眠りも、すべてを老いさせるものも、いつか奪うことはなく、"^^xsd:string ;
:relatedTo :Line_606 .

:TV_Line_607_JA a :TranslationVariant ;
:text "神々の月々もただそれだけではなく、老いなき時の中で"^^xsd:string ;
:relatedTo :Line_607 .

# Lines 608 and 609 do not exist in Antigone

:TV_Line_610_JA a :TranslationVariant ;
:text "支配者として、オリュンポスの大理石のように輝く光輝を保っている。"^^xsd:string ;
:relatedTo :Line_610 .

:TV_Line_611_JA a :TranslationVariant ;
:text "後に来ることも、これから来ることも、"^^xsd:string ;
:relatedTo :Line_611 .

:TV_Line_612_JA a :TranslationVariant ;
:text "また以前のことも、十分に満たすだろう、"^^xsd:string ;
:relatedTo :Line_612 .

:TV_Line_613_JA a :TranslationVariant ;
:text "この法が。自分のものとして奪い去り、"^^xsd:string ;
:relatedTo :Line_613 .

:TV_Line_614_JA a :TranslationVariant ;
:text "死すべき者の生において、非常に多くを破滅の外には置かない。"^^xsd:string ;
:relatedTo :Line_614 .

:TV_Line_615_JA a :TranslationVariant ;
:text "というのも、あの多くさまよう希望は、多くの男たちには益であるが、"^^xsd:string ;
:relatedTo :Line_615 .
