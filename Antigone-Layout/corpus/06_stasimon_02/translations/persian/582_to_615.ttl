:stasimon_02-translations-582-615-persian a owl:Ontology .
# Persian translation variants for 582_to_615.ttl

# Line 582 does not exist in Antigone

:TV_Line_583_FA a :TranslationVariant ;
:text "خوشبخت‌اند آنان که روزگارشان مزه بدی‌ها را نچشیده است؛"^^xsd:string ;
:relatedTo :Line_583 .

:TV_Line_584_FA a :TranslationVariant ;
:text "زیرا برای کسانی که خانه‌شان از سوی خدایان لرزانده شود،"^^xsd:string ;
:relatedTo :Line_584 .

:TV_Line_585_FA a :TranslationVariant ;
:text "هیچ تباهی کم نمی‌آید، چون انبوه نسل را می‌رباید؛"^^xsd:string ;
:relatedTo :Line_585 .

:TV_Line_586_FA a :TranslationVariant ;
:text "همانند خیزاب‌های دریایی بدباد، هنگامی که"^^xsd:string ;
:relatedTo :Line_586 .

:TV_Line_587_FA a :TranslationVariant ;
:text "با دم‌های تراکیایی تاریکی بر ژرفای دریا می‌دود،"^^xsd:string ;
:relatedTo :Line_587 .

# Lines 588 and 589 do not exist in Antigone

:TV_Line_590_FA a :TranslationVariant ;
:text "و از بن ژرف، شن سیاه را می‌غلتاند، و"^^xsd:string ;
:relatedTo :Line_590 .

:TV_Line_591_FA a :TranslationVariant ;
:text "ساحل‌های روبه‌کوبیده و بدباد، دهانه را به غرش درمی‌آورند."^^xsd:string ;
:relatedTo :Line_591 .

# Line 592 does not exist in Antigone

:TV_Line_593_FA a :TranslationVariant ;
:text "رنج‌های کهن بر خانه‌های لابداکیدان، به نفرین،"^^xsd:string ;
:relatedTo :Line_593 .

# Line 594 does not exist in Antigone

:TV_Line_595_FA a :TranslationVariant ;
:text "رنج‌ها بر رنج‌های مردگانِ نابودشده فرو می‌افتند،"^^xsd:string ;
:relatedTo :Line_595 .

:TV_Line_596_FA a :TranslationVariant ;
:text "و نسلی نسل دیگر را رها نمی‌کند، بلکه آن را فرو می‌کوبد،"^^xsd:string ;
:relatedTo :Line_596 .

:TV_Line_597_FA a :TranslationVariant ;
:text "یکی از خدایان، و رهایی ندارد. زیرا اکنون از آخرین"^^xsd:string ;
:relatedTo :Line_597 .

# Lines 598 and 599 do not exist in Antigone

:TV_Line_600_FA a :TranslationVariant ;
:text "ریشه‌ها، نوری که در خانه اودیپوس گسترده شده بود،"^^xsd:string ;
:relatedTo :Line_600 .

:TV_Line_601_FA a :TranslationVariant ;
:text "غبار خونینِ خدایان زیرین آن را فرو می‌بُرد،"^^xsd:string ;
:relatedTo :Line_601 .

:TV_Line_602_FA a :TranslationVariant ;
:text "به بی‌خردی سخن و ارینیوسِ اندیشه‌ها."^^xsd:string ;
:relatedTo :Line_602 .

# Lines 603 and 604 do not exist in Antigone

:TV_Line_605_FA a :TranslationVariant ;
:text "ای زئوس، کدام تجاوز انسان‌ها می‌تواند قدرت تو را مهار کند؟"^^xsd:string ;
:relatedTo :Line_605 .

:TV_Line_606_FA a :TranslationVariant ;
:text "آن را نه خواب، که همه‌چیز را پیر می‌کند، هرگز می‌گیرد،"^^xsd:string ;
:relatedTo :Line_606 .

:TV_Line_607_FA a :TranslationVariant ;
:text "و نه ماه‌های خدایان؛ بلکه در زمانِ بی‌پیری"^^xsd:string ;
:relatedTo :Line_607 .

# Lines 608 and 609 do not exist in Antigone

:TV_Line_610_FA a :TranslationVariant ;
:text "فرمانروایانه، فروغ مرمرین و درخشانِ المپ را در دست داری."^^xsd:string ;
:relatedTo :Line_610 .

:TV_Line_611_FA a :TranslationVariant ;
:text "هم آنچه پس از این است و هم آنچه خواهد آمد"^^xsd:string ;
:relatedTo :Line_611 .

:TV_Line_612_FA a :TranslationVariant ;
:text "و هم آنچه پیش از این بود، این قانون برایش بس خواهد بود:"^^xsd:string ;
:relatedTo :Line_612 .

:TV_Line_613_FA a :TranslationVariant ;
:text "هیچ چیز بزرگ در زندگی میرایان"^^xsd:string ;
:relatedTo :Line_613 .

:TV_Line_614_FA a :TranslationVariant ;
:text "بسیار بیرون از تباهی نمی‌شتابد."^^xsd:string ;
:relatedTo :Line_614 .

:TV_Line_615_FA a :TranslationVariant ;
:text "زیرا امید بسیار آواره برای بسیاری از مردان سود است،"^^xsd:string ;
:relatedTo :Line_615 .
