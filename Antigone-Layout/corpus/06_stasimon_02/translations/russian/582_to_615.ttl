:stasimon_02-translations-582-615-russian a owl:Ontology .
# Russian translation variants for 582_to_615.ttl

# Line 582 does not exist in Antigone

:TV_Line_583_RU a :TranslationVariant ;
:text "Блаженны те, чей век не вкусил зла;"^^xsd:string ;
:relatedTo :Line_583 .

:TV_Line_584_RU a :TranslationVariant ;
:text "ибо тем, чей дом потрясен от богов,"^^xsd:string ;
:relatedTo :Line_584 .

:TV_Line_585_RU a :TranslationVariant ;
:text "не оставляет гибель ничего, ползя через множество поколений;"^^xsd:string ;
:relatedTo :Line_585 .

:TV_Line_586_RU a :TranslationVariant ;
:text "подобно тому как морская зыбь при бурных"^^xsd:string ;
:relatedTo :Line_586 .

:TV_Line_587_RU a :TranslationVariant ;
:text "фракийских порывах набегает на мрак моря,"^^xsd:string ;
:relatedTo :Line_587 .

# Line 588 and 589 do not exist in Antigone

:TV_Line_590_RU a :TranslationVariant ;
:text "она катит со дна черный песок,"^^xsd:string ;
:relatedTo :Line_590 .

:TV_Line_591_RU a :TranslationVariant ;
:text "и встречные берега ревут под дурными ветрами."^^xsd:string ;
:relatedTo :Line_591 .

# Line 592 does not exist in Antigone

:TV_Line_593_RU a :TranslationVariant ;
:text "Древние бедствия домов Лабдакидов я вижу"^^xsd:string ;
:relatedTo :Line_593 .

# Line 594 does not exist in Antigone

:TV_Line_595_RU a :TranslationVariant ;
:text "падающими: бедствия на бедствия умерших,"^^xsd:string ;
:relatedTo :Line_595 .

:TV_Line_596_RU a :TranslationVariant ;
:text "и поколение не освобождает поколение, но валит его;"^^xsd:string ;
:relatedTo :Line_596 .

:TV_Line_597_RU a :TranslationVariant ;
:text "какой-то бог, и нет освобождения. Ибо теперь от последних"^^xsd:string ;
:relatedTo :Line_597 .

# Line 598 and 599 do not exist in Antigone

:TV_Line_600_RU a :TranslationVariant ;
:text "корней свет, протянутый в доме Эдипа,"^^xsd:string ;
:relatedTo :Line_600 .

:TV_Line_601_RU a :TranslationVariant ;
:text "кровавая пыль нижних богов срубает,"^^xsd:string ;
:relatedTo :Line_601 .

:TV_Line_602_RU a :TranslationVariant ;
:text "безумием слова и яростью мыслей."^^xsd:string ;
:relatedTo :Line_602 .

# Line 603 and 604 do not exist in Antigone

:TV_Line_605_RU a :TranslationVariant ;
:text "Твою силу, Зевс, какое человеческое преступление могло бы удержать?"^^xsd:string ;
:relatedTo :Line_605 .

:TV_Line_606_RU a :TranslationVariant ;
:text "Ее не берет никогда ни сон, все старящий,"^^xsd:string ;
:relatedTo :Line_606 .

:TV_Line_607_RU a :TranslationVariant ;
:text "ни месяцы богов; но в нестареющем времени"^^xsd:string ;
:relatedTo :Line_607 .

# Line 608 and 609 do not exist in Antigone

:TV_Line_610_RU a :TranslationVariant ;
:text "как властитель ты держишь мраморно-сияющую славу Олимпа."^^xsd:string ;
:relatedTo :Line_610 .

:TV_Line_611_RU a :TranslationVariant ;
:text "И последующее, и будущее,"^^xsd:string ;
:relatedTo :Line_611 .

:TV_Line_612_RU a :TranslationVariant ;
:text "и прежнее охватит этот закон:"^^xsd:string ;
:relatedTo :Line_612 .

:TV_Line_613_RU a :TranslationVariant ;
:text "ничто великое не приходит"^^xsd:string ;
:relatedTo :Line_613 .

:TV_Line_614_RU a :TranslationVariant ;
:text "в жизнь смертных совсем вне бедствия."^^xsd:string ;
:relatedTo :Line_614 .

:TV_Line_615_RU a :TranslationVariant ;
:text "Ибо многоскитальная надежда многим мужам — польза,"^^xsd:string ;
:relatedTo :Line_615 .
