:relatedTo :Line_602 .

# Line 603 and 604 do not exist in Antigone

:TV_Line_605_ID a :TranslationVariant ;
:text "Kekuatanmu, Zeus, pelanggaran manusia mana yang dapat menahannya?"^^xsd:string ;
:relatedTo :Line_605 .

:TV_Line_606_ID a :TranslationVariant ;
:text "Ia tidak pernah diambil oleh tidur yang menjerat segala usia,"^^xsd:string ;
:relatedTo :Line_606 .

:TV_Line_607_ID a :TranslationVariant ;
:text "ataupun oleh bulan-bulan para dewa; tetapi dalam waktu yang tak menua"^^xsd:string ;
:relatedTo :Line_607 .

# Line 608 and 609 do not exist in Antigone

:TV_Line_610_ID a :TranslationVariant ;
:text "sebagai penguasa engkau memegang kilau Olympus yang gemerlap seperti marmer."^^xsd:string ;
