# Line 582 does not exist in Antigone

:TV_Line_583_ID a :TranslationVariant ;
:text "Berbahagialah mereka yang hidupnya tidak pernah mengecap kejahatan;"^^xsd:string ;
:relatedTo :Line_583 .

:TV_Line_584_ID a :TranslationVariant ;
:text "sebab bagi mereka yang rumahnya diguncang dari pihak dewa,"^^xsd:string ;
:relatedTo :Line_584 .

:TV_Line_585_ID a :TranslationVariant ;
:text "tidak ada kehancuran yang tidak meninggalkan keturunan, merayap melalui banyak generasi;"^^xsd:string ;
:relatedTo :Line_585 .

:TV_Line_586_ID a :TranslationVariant ;
:text "seperti ketika gelombang laut yang sulit bernapas"^^xsd:string ;
:relatedTo :Line_586 .

:TV_Line_587_ID a :TranslationVariant ;
:text "dengan hembusan Trakia berlari di atas kegelapan laut,"^^xsd:string ;
:relatedTo :Line_587 .

# Line 588 and 589 do not exist in Antigone

:TV_Line_590_ID a :TranslationVariant ;
:text "ia menggulung pasir hitam dari dasar laut,"^^xsd:string ;
:relatedTo :Line_590 .

:TV_Line_591_ID a :TranslationVariant ;
:text "dan pantai yang dipukul balik oleh angin buruk bergemuruh."^^xsd:string ;
:relatedTo :Line_591 .

# Line 592 does not exist in Antigone

:TV_Line_593_ID a :TranslationVariant ;
:text "Aku melihat derita kuno dari rumah Labdakos"^^xsd:string ;
:relatedTo :Line_593 .

# Line 594 does not exist in Antigone

:TV_Line_595_ID a :TranslationVariant ;
:text "jatuh, derita demi derita, di atas derita orang-orang yang telah mati,"^^xsd:string ;
:relatedTo :Line_595 .

:TV_Line_596_ID a :TranslationVariant ;
:text "dan satu generasi tidak membebaskan generasi lain, melainkan merobohkannya;"^^xsd:string ;
:relatedTo :Line_596 .

:TV_Line_597_ID a :TranslationVariant ;
:text "suatu dewa melakukannya, dan tidak ada pembebasan. Sebab sekarang dari akar terakhir"^^xsd:string ;
:relatedTo :Line_597 .

# Line 598 and 599 do not exist in Antigone

:TV_Line_600_ID a :TranslationVariant ;
:text "cahaya yang terbentang di rumah Oidipus"^^xsd:string ;
:relatedTo :Line_600 .

