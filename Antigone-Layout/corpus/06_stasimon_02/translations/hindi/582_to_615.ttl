@prefix : <http://example.org/antigone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:stasimon_02-translations-582-615-hindi a owl:Ontology .
# Hindi translation variants for 582_to_615.ttl

# Line 582 does not exist in Antigone

:TV_Line_583_HI a :TranslationVariant ;
:text "धन्य हैं वे, जिनका जीवन बुराइयों का स्वाद नहीं चखता;"^^xsd:string ;
:relatedTo :Line_583 .

:TV_Line_584_HI a :TranslationVariant ;
:text "क्योंकि जिनका घर देवताओं की ओर से हिलाया जाता है,"^^xsd:string ;
:relatedTo :Line_584 .

:TV_Line_585_HI a :TranslationVariant ;
:text "विनाश कुछ भी नहीं छोड़ता, पीढ़ी की भीड़ को बहा ले जाता है;"^^xsd:string ;
:relatedTo :Line_585 .

:TV_Line_586_HI a :TranslationVariant ;
:text "यह समुद्र की दुर्वातायुक्त लहरों जैसा होता है,"^^xsd:string ;
:relatedTo :Line_586 .

:TV_Line_587_HI a :TranslationVariant ;
:text "जब थ्रेस की साँसों से अँधेरा गहराई के ऊपर दौड़ता है,"^^xsd:string ;
:relatedTo :Line_587 .

# Line 588 and 589 do not exist in Antigone

:TV_Line_590_HI a :TranslationVariant ;
:text "तो वह तल से काली रेत को लुढ़काता है,"^^xsd:string ;
:relatedTo :Line_590 .

:TV_Line_591_HI a :TranslationVariant ;
:text "और विपरीत आघातों वाली तटभूमियाँ कठिन हवाओं में गरजती हैं।"^^xsd:string ;
:relatedTo :Line_591 .

# Line 592 does not exist in Antigone

:TV_Line_593_HI a :TranslationVariant ;
:text "मैं लाब्दाकिदों के घरों का प्राचीन अभिशाप देखता हूँ"^^xsd:string ;
:relatedTo :Line_593 .

# Line 594 does not exist in Antigone

:TV_Line_595_HI a :TranslationVariant ;
:text "मृतकों के दुखों पर दुख गिरते हुए,"^^xsd:string ;
:relatedTo :Line_595 .

:TV_Line_596_HI a :TranslationVariant ;
:text "और एक पीढ़ी दूसरी पीढ़ी को मुक्त नहीं करती, बल्कि गिरा देती है;"^^xsd:string ;
:relatedTo :Line_596 .

:TV_Line_597_HI a :TranslationVariant ;
:text "कोई देवता ऐसा करता है, और मुक्ति नहीं है। क्योंकि अब अंतिम"^^xsd:string ;
:relatedTo :Line_597 .

# Line 598 and 599 do not exist in Antigone

:TV_Line_600_HI a :TranslationVariant ;
:text "जड़ से ओइदिपुस के घर में जो प्रकाश फैला था,"^^xsd:string ;
:relatedTo :Line_600 .

:TV_Line_601_HI a :TranslationVariant ;
:text "नीचे के देवताओं की रक्तिम"^^xsd:string ;
:relatedTo :Line_601 .

:TV_Line_602_HI a :TranslationVariant ;
:text "धूल उसे काट रही है, वचन की मूर्खता और मन की एरिन्यिस से।"^^xsd:string ;
:relatedTo :Line_602 .

# Line 603 and 604 do not exist in Antigone

:TV_Line_605_HI a :TranslationVariant ;
:text "हे ज़ीउस, मनुष्यों का कौन-सा अतिक्रमण तेरी शक्ति को रोक सकता है?"^^xsd:string ;
:relatedTo :Line_605 .

:TV_Line_606_HI a :TranslationVariant ;
:text "जिसे न कभी निद्रा, सबको वृद्ध करने वाली निद्रा, पकड़ती है,"^^xsd:string ;
:relatedTo :Line_606 .

:TV_Line_607_HI a :TranslationVariant ;
:text "न देवताओं के अथक महीने; बल्कि अजर समय में"^^xsd:string ;
:relatedTo :Line_607 .

# Line 608 and 609 do not exist in Antigone

:TV_Line_610_HI a :TranslationVariant ;
:text "शासक होकर तू ओलिंपस की संगमरमर-सी चमक रखता है।"^^xsd:string ;
:relatedTo :Line_610 .

:TV_Line_611_HI a :TranslationVariant ;
:text "जो आगे है, और जो आने वाला है,"^^xsd:string ;
:relatedTo :Line_611 .

:TV_Line_612_HI a :TranslationVariant ;
:text "और जो पहले था, उसके लिए यह नियम पर्याप्त होगा:"^^xsd:string ;
:relatedTo :Line_612 .

:TV_Line_613_HI a :TranslationVariant ;
:text "अपने ही ढंग से वह बहा ले जाता है"^^xsd:string ;
:relatedTo :Line_613 .

:TV_Line_614_HI a :TranslationVariant ;
:text "मर्त्य जीवन की बहुत-सी वस्तुओं को विनाश से बाहर नहीं छोड़ता।"^^xsd:string ;
:relatedTo :Line_614 .

:TV_Line_615_HI a :TranslationVariant ;
:text "क्योंकि बहुत-भटकाने वाली आशा बहुत मनुष्यों के लिए लाभ है,"^^xsd:string ;
:relatedTo :Line_615 .
