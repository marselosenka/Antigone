:relatedTo :Line_1135 .

# Line 1136 does not exist in Antigone

:TV_Line_1137_ID a :TranslationVariant ;
:text "kota yang dari semua kota paling tinggi kauhormati"^^xsd:string ;
:relatedTo :Line_1137 .

:TV_Line_1138_ID a :TranslationVariant ;
:text "bersama ibumu yang tersambar petir;"^^xsd:string ;
:relatedTo :Line_1138 .

# Line 1139 does not exist in Antigone

:TV_Line_1140_ID a :TranslationVariant ;
:text "dan sekarang, ketika kota seluruh rakyat"^^xsd:string ;
